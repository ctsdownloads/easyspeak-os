// Passwordless ONLY for: the administrator (wheel) account, at the machine (local, active session),
// for the media codecs action. The helper enforces the rest: it accepts only web, full or skip, and
// installs a fixed package list from a fixed repository (skip only closes the first-login question).
// Without this file the same action simply asks for the administrator password.
polkit.addRule(function(action, subject) {
    if (action.id == "dev.easyspeak.os.codecs.setup" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
