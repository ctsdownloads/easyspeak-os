// Passwordless ONLY for: the administrator (wheel) account, at the machine (local, active session),
// for the one-time media codecs setup action. The helper enforces the rest: it works only while the
// setup window is open, accepts only web/full/skip, and installs a fixed package list.
// Without this file the same action simply asks for the administrator password.
polkit.addRule(function(action, subject) {
    if (action.id == "dev.easyspeak.os.codecs.setup" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
