# What apps from .rpm and .deb files expect from a desktop, and a fresh box does not have: zenity (Discord's
# first-run downloader shows its progress with it; without it there is no window at all) and notify-send.
# xdg-open is left out on purpose: Distrobox already sends it to the real desktop when the box has none.
HELPERS = {"rpm": ["zenity", "libnotify"], "deb": ["zenity", "libnotify-bin"]}
HELPER_CHECK = "command -v zenity >/dev/null && command -v notify-send >/dev/null"


def helpers_mark(kind):
    return STATE.with_name(f"helpers-{BOXES[kind]['name']}")


def helper_steps(kind):
    box = BOXES[kind]["name"]
    label = "Adding the desktop parts apps expect (progress windows and notifications)"
    if kind == "rpm":
        return [(label, in_box(box, "sudo", "dnf", "-y", "install", *HELPERS[kind]))]
    return [(label, in_box(box, "sh", "-c", "sudo apt-get update && sudo env DEBIAN_FRONTEND=noninteractive "
                                           "apt-get install -y " + " ".join(HELPERS[kind])))]


def ensure_helpers(kind, quiet=False):
    """Make sure the box has the desktop helpers. Done once per box; remembered after that."""
    mark = helpers_mark(kind)
    box = BOXES[kind]["name"]
    if mark.exists() or not box_exists(box):
        return True
    if subprocess.run(in_box(box, "sh", "-c", HELPER_CHECK), capture_output=True).returncode != 0:
        if quiet:
            ok = all(subprocess.run(cmd, capture_output=True).returncode == 0 for _, cmd in helper_steps(kind))
        else:
            ok = run_steps(f"Preparing the {BOXES[kind]['label']}.", helper_steps(kind))
        if not ok:
            return False
    mark.parent.mkdir(parents=True, exist_ok=True)
    mark.touch()
    return True


def setup_box(kind, size=None, again=False):
    """Make the box, with plain steps and a Cancel button. Cancel or failure leaves no half-made box."""
    distro, _, label = box_words(kind)
    box = BOXES[kind]
    steps = []
    if size != 0:
        about = f" (about {size} MB)" if size else ""
        steps.append((f"Downloading the {label}{about}", ["podman", "pull", box["image"]]))
    steps += [(f"Creating the {label}",
               ["distrobox", "create", "--yes", "--no-entry", "--name", box["name"], "--image", box["image"]]),
              (f"Getting the {label} ready. The first time takes a few minutes.", in_box(box["name"], "true"))]
    steps += helper_steps(kind)
    helpers_mark(kind).unlink(missing_ok=True)
    heading = f"Setting up the {label} again." if again else f"Setting up the {label}. This happens only once."
    # also as a notification, so it is seen even if the progress window opens behind another window
    notify(f"{heading} It takes a few minutes; a progress window shows each step.")
    if run_steps(heading, steps, cancel=True):
        helpers_mark(kind).parent.mkdir(parents=True, exist_ok=True)
        helpers_mark(kind).touch()
        return True
    subprocess.run(["distrobox", "rm", "--force", box["name"]], capture_output=True)
    if CANCELLED:
        say(f"Setting up the {label} was stopped. Nothing was installed.")
    else:
        failed(f"Setting up the {label}")
    return False


def box_works(name):
    try:
        return subprocess.run(in_box(name, "true"), capture_output=True, timeout=300).returncode == 0
    except subprocess.TimeoutExpired:
        return False


def repair(kind, why="", confirm=True):
    """Make a broken box again from scratch and put back the apps that were installed in it."""
    distro, _, label = box_words(kind)
    box = BOXES[kind]["name"]
    inside = [r for r in load() if r["where"] == box]
    names = ", ".join(r["title"] for r in inside) or "none"
    size = image_size(BOXES[kind]["image"])
    sz = "" if size == 0 or size is None else f" (it downloads about {size} MB)"
    if confirm and ask(f"{why or f'The {label} is not working.'}\n\nRepair sets it up again from scratch{sz}, then puts "
                       f"back the apps that were in it: {names}.\n\nYour own files are not touched. Things installed "
                       f"inside the box some other way are not put back.", ok="Repair") != "ok":
        return 1
    for r in inside:
        unexport(r)
    subprocess.run(["distrobox", "rm", "--force", box], capture_output=True)
    if not setup_box(kind, size, again=True):
        return 1
    back, missing = [], []
    for r in inside:
        f = r.get("file")
        if not f or not Path(f).exists():
            missing.append(r["title"])
            forget(r)
            continue
        try:
            pkg = read_package(f)
        except (OSError, ValueError, tarfile.TarError, EOFError):
            missing.append(r["title"])
            forget(r)
            continue
        if box_install(pkg, classify(pkg), r["title"], quiet=True) == 0:
            if r.get("rules"):          # its hardware rule is still on the system; keep it on record for Remove Apps
                remember({**next(x for x in load() if x["package"] == r["package"] and x["where"] == box),
                          "rules": True})
            back.append(r["title"])
        else:
            missing.append(r["title"])
    text = f"The {label} is repaired."
    if back:
        text += "\n\nPut back: " + ", ".join(back) + "."
    if missing:
        text += "\n\nNot put back (open their files again to install them): " + ", ".join(missing) + "."
    notify(f"The {label} is repaired.")
    say(text)
    return 0


def repair_command(only_broken=False):
    """Repair an app box. only_broken (from System Update, when updating boxes failed): look first, and repair only
    a box that does not work."""
    kinds = [k for k in BOXES if box_exists(BOXES[k]["name"]) or any(r["where"] == BOXES[k]["name"] for r in load())]
    if not kinds:
        say("No app boxes have been set up with Install Package File, so there is nothing to repair here. "
            "A box you made yourself can be checked with:  distrobox list")
        return 0
    if only_broken:
        broken = [k for k in kinds if not (box_exists(BOXES[k]["name"]) and box_works(BOXES[k]["name"]))]
        if not broken:
            say("The app boxes from Install Package File work. The box that did not update is one made some other "
                "way, for example with Distrobox directly. To see your boxes, run:  distrobox list")
            return 0
        kinds = broken
    if len(kinds) == 1:
        i = 0
    else:
        i = choose("Which box do you want to repair?", ["Box"], [[BOXES[k]["label"]] for k in kinds])
        if i is None:
            return 1
    label = BOXES[kinds[i]]["label"]
    return repair(kinds[i], why=f"Repair the {label}? Use this if apps in it no longer open or update.")


BOX_RUN = "/usr/libexec/easyspeak-os-box-run"
QUIT = "easyspeak-quit"


def fix_launcher(path):
    """Make an app grid entry made by distrobox-export start the app through easyspeak-os-box-run, so the app's
    messages go to a log file (an app does not crash if its link to the desktop goes away) and a right-click Quit
    really stops it inside the box. Safe to run more than once."""
    try:
        text = path.read_text()
    except OSError:
        return False
    if BOX_RUN in text:
        return True
    key = ""

    def swap(m):
        nonlocal key
        rest = m.group(2).strip()
        try:
            first = shlex.split(rest)[0]
        except (ValueError, IndexError):
            return m.group(0)
        key = key or os.path.basename(first)
        return f"Exec={BOX_RUN} {m.group(1)} {rest}"
    text = re.sub(r"(?m)^Exec=\S*distrobox-enter\s+-n\s+(\S+)\s+(?:\S+\s+)*?--\s+(.*)$", swap, text)
    text = re.sub(r"(?m)^StartupWMClass=/.*\n?", "", text)
    if not key:
        return False
    name = re.search(r"(?m)^Name=(.*)$", text)
    head, sep, rest = text.partition("[Desktop Entry]\n")
    if re.search(r"(?m)^Actions=", rest.split("\n[", 1)[0]):
        rest = re.sub(r"(?m)^(Actions=[^\n]*?);?[ \t]*$", lambda m: f"{m.group(1)};{QUIT};", rest, count=1)
    else:
        rest = f"Actions={QUIT};\n" + rest
    text = head + sep + rest.rstrip("\n") + (
        f"\n\n[Desktop Action {QUIT}]\nName=Quit {name.group(1) if name else key}\n"
        f"Exec={BOX_RUN} --stop {key}\n")
    path.write_text(text)
    return True


def launchers_to_fix():
    apps_dir = HOME / ".local/share/applications"
    out = []
    for r in load():
        if r["where"] in WHERE and r["where"].startswith("easyspeak-"):
            for a in r.get("apps", []):
                f = apps_dir / f"{r['where']}-{os.path.basename(a)}"
                try:
                    if f.exists() and BOX_RUN not in f.read_text():
                        out.append(f)
                except OSError:
                    pass
    return out


def export(box, info):
    """Put the package's apps in the app grid, or its commands on the PATH. Returns what was exported."""
    apps_dir = HOME / ".local/share/applications"
    done_apps, done_bins = [], []
    for path in info["apps"]:
        r = subprocess.run(in_box(box, "distrobox-export", "--app", path, "--export-label", "none"),
                           capture_output=True, text=True)
        exported = apps_dir / f"{box}-{os.path.basename(path)}"
        if r.returncode == 0 and exported.exists():
            fix_launcher(exported)
            done_apps.append(path)
    if not done_apps:
        bindir = HOME / ".local/bin"
        bindir.mkdir(parents=True, exist_ok=True)
        for b in info["bins"]:
            r = subprocess.run(in_box(box, "distrobox-export", "--bin", b, "--export-path", str(bindir)),
                               capture_output=True, text=True)
            if r.returncode == 0:
                done_bins.append(b)
    return done_apps, done_bins


def unexport(entry):
    box = entry["where"]
    apps_dir = HOME / ".local/share/applications"
    for path in entry.get("apps", []):        # quit the app first if it is running
        try:
            m = re.search(r"--stop (\S+)", (apps_dir / f"{box}-{os.path.basename(path)}").read_text())
        except OSError:
            m = None
        if m and os.access(BOX_RUN, os.X_OK):
            subprocess.run([BOX_RUN, "--stop", m.group(1)], capture_output=True)
    for path in entry.get("apps", []):
        if box_exists(box):
            subprocess.run(in_box(box, "distrobox-export", "--app", path, "--delete"), capture_output=True)
        (apps_dir / f"{box}-{os.path.basename(path)}").unlink(missing_ok=True)
    for b in entry.get("bins", []):
        if box_exists(box):
            subprocess.run(in_box(box, "distrobox-export", "--bin", b, "--export-path", str(HOME / ".local/bin"),
                                  "--delete"), capture_output=True)
        (HOME / ".local/bin" / os.path.basename(b)).unlink(missing_ok=True)


