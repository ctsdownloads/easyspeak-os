        if entry["where"] == "flathub":
            subprocess.Popen(["flatpak", "run", entry["package"]], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
        for a in entry.get("apps", []):
