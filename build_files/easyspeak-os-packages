            if f.exists():
                subprocess.Popen(["gio", "launch", str(f)], start_new_session=True,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return True
    except OSError:
        pass
    return False


def already_installed(pkg, info, title):
    """Check whether this app is installed already, and ask what to do. Returns (go_on, mode, exit code):
    mode is 'install', 'reinstall', 'update' or 'older' when going on."""
    records = load()
    ours = BOXES[pkg.kind]["name"]

    # 1. On the system itself
    hv = host_version(pkg.name) if pkg.kind == "rpm" else ""
    if hv:
        mine = next((r for r in records if r["where"] == "system" and r["package"] == pkg.name), None)
        if not mine:
            say(f"{title} is already part of your system (version {plain_version(hv)}).")
            return False, "", 0
        c = compare("rpm", pkg.evr, hv)
        if c <= 0:
            say(f"{title} is already on the system (version {plain_version(hv)}). "
                f"{'This file is the same version.' if c == 0 else 'This file is an older version.'}")
            return False, "", 0
        if ask(f"Update {title} on the system from version {plain_version(hv)} to {plain_version(pkg.evr)}?\n\n"
               f"This needs the administrator password and takes effect after a restart.", ok="Update") != "ok":
            return False, "", 1
        return True, "system-update", 0

    # 2. In its box
    bv = box_version(pkg.kind, pkg.name)
    if bv:
        mine = next((r for r in records if r["where"] == ours and r["package"] == pkg.name),
                    {"title": title, "where": ours, "apps": list(info["apps"])})
        c = compare(pkg.kind, pkg.evr, bv)
        where = BOXES[pkg.kind]["label"]
        if c == 0:
            a = ask(f"{title} is already installed in the {where} (version {plain_version(bv)}).",
                    ok="Open it", extra="Reinstall")
            if a == "ok":
                if not open_app(mine):
                    say(f"{title} has no app grid entry to open. Run it inside the box: distrobox enter {ours}")
                return False, "", 0
            return (True, "reinstall", 0) if a == "extra" else (False, "", 1)
        if c > 0:
            if ask(f"Update {title} in the {where} from version {plain_version(bv)} to {plain_version(pkg.evr)}?",
                   ok="Update") != "ok":
                return False, "", 1
            return True, "update", 0
        if ask(f"This file is an older version of {title} ({plain_version(pkg.evr)}) than the one installed in the "
               f"{where} ({plain_version(bv)}).", ok="Install the older version") != "ok":
            return False, "", 1
        return True, "older", 0

    # 3. From Flathub, or 4. in the other box (same app name)
    want = {norm_name(title), norm_name(pkg.name)}
    for r in records:
        if r["where"] == "flathub" and (norm_name(r["title"]) in want) and flatpak_installed(r["package"]):
            a = ask(f"{r['title']} is already installed from Flathub.", ok="Open it", extra="Install the file too")
            if a == "ok":
                open_app(r)
                return False, "", 0
            return (True, "install", 0) if a == "extra" else (False, "", 1)
        if r["where"] in (BOXES["rpm"]["name"], BOXES["deb"]["name"]) and r["where"] != ours and \
                norm_name(r["title"]) in want:
            other = WHERE.get(r["where"], r["where"])
            a = ask(f"{r['title']} is already installed in the {other}.", ok="Open it", extra="Install it here too")
            if a == "ok":
                open_app(r)
                return False, "", 0
            return (True, "install", 0) if a == "extra" else (False, "", 1)
    return True, "install", 0


# ---------------------------------------------------------------- install

def plain_list(items):
    return "\n".join("  - " + i for i in items)


def pick_file():
    found = []
    for d in (HOME / "Downloads", HOME / "Desktop", HOME):
        if d.is_dir():
            found += [p for p in d.iterdir() if p.is_file() and p.suffix.lower() in (".rpm", ".deb")]
    found = sorted(set(found), key=lambda p: p.stat().st_mtime, reverse=True)[:30]
    rows = [[p.name, str(p.parent).replace(str(HOME), "~", 1)] for p in found]
    if not rows:
        if GUI:
            r = zenity("--file-selection", "--file-filter=Packages (.rpm, .deb) | *.rpm *.deb")
            return r.stdout.strip() if r.returncode == 0 else None
        say("No .rpm or .deb files in Downloads. Give the file's path:  easyspeak-os-packages install FILE")
        return None
    i = choose("Which package do you want to install?", ["File", "Folder"], rows)
    return str(found[i]) if i is not None else None


def install(path):
    if not path:
        path = pick_file()
        if not path:
            return 1
    path = os.path.abspath(path)
    try:
        pkg = read_package(path)
    except (OSError, ValueError, tarfile.TarError, EOFError) as e:
        say(f"This file cannot be installed: {e}.", "error")
        return 1
    info = classify(pkg)
    title = info["title"]

    machine = platform.machine()
    fits = {"x86_64": {"rpm": {"x86_64", "noarch", "i686"}, "deb": {"amd64", "all"}},
            "aarch64": {"rpm": {"aarch64", "noarch"}, "deb": {"arm64", "all"}}}.get(machine, {})
    if fits and pkg.arch not in fits[pkg.kind]:
        if pkg.arch in ("i386", "i686"):
            say(f"{title} is a 32-bit {'.deb' if pkg.kind == 'deb' else '.rpm'} package, made for older computers. "
                f"Look for the 64-bit version (it may be called amd64 or x86_64).", "warning")
        else:
            say(f"{title} is made for a different kind of processor ({pkg.arch}), not this computer ({machine}). "
                f"Look for the version for {'amd64 or x86_64' if machine == 'x86_64' else machine}.", "warning")
        return 1

    go_on, mode, code = already_installed(pkg, info, title)
    if not go_on:
        return code
    if mode == "system-update":
        return install_system(pkg, title, "a printer driver" in info["blocking"], update=True)
    if mode != "install":
        return box_install(pkg, info, title, mode=mode)

    match = None if info["rules_only"] else flathub_match(pkg, info)
    if match and flatpak_installed(match[0]):
        app_id, name = match
        a = ask(f"{name} is already installed from Flathub.", ok="Open it", extra="Install the file too")
        if a == "ok":
            open_app({"where": "flathub", "package": app_id})
            return 0
        if a != "extra":
            return 1
        match = None
    if match:
        app_id, name = match
        answer = ask(f"{name} is on Flathub, the app store this system uses. Apps from Flathub update on their own "
                     f"and fit this system best.\n\nInstall {name} from Flathub instead?",
                     ok="Use Flathub", cancel="Cancel", extra="Use the file")
        if answer is None:
            return 1
        if answer == "ok":
            if run_steps(f"Installing {name} from Flathub.",
                         [["flatpak", "install", "-y", "--noninteractive", "flathub", app_id]]):
                remember({"title": name, "package": app_id, "where": "flathub"})
                notify(f"{name} is installed.")
                say(f"{name} is installed. Find it in the app grid.\n\n{UPDATES_FLATHUB}")
                return 0
            failed(f"Installing {name}")
            return 1

    if info["rules_only"]:
        if ask(f"{title} only adds a hardware rule, which lets your account use a device. It goes onto the system "
               f"itself, so it needs the administrator password.", ok="Add it") != "ok":
            return 1
        ok, out = add_rules(pkg, info)
        if not ok:
            say(f"The hardware rule was not added.\n\n{out}", "error")
            return 1
        remember({"title": title, "package": pkg.name, "where": "rules", "rules": True})
        notify(f"{title} is installed.")
        say(f"{title} is installed. Unplug the device and plug it back in.")
        return 0

    if info["blocking"]:
        reasons = plain_list(info["blocking"])
        printer = "a printer driver" in info["blocking"]
        if printer:
            choice = try_driverless(title, pkg.kind)
            if choice != "driver":
                return 0 if choice == "printers" else 1
        if pkg.kind == "deb" and printer:
            who = maker(pkg)
            site = f"{who}'s support site" if who else "the printer maker's support site"
            if ask(f"{title} is a printer driver made for Ubuntu and Debian (.deb). This system takes printer drivers "
                   f"only as .rpm files.\n\nWhat to do:\n  1. Go to {site} and find the driver for your printer.\n"
                   f"  2. When it asks for your system, choose the .rpm version (it may be called Fedora, Red Hat or "
                   f"RPM).\n  3. Open that .rpm file here.\n\nOr try your printer without a driver first.",
                   ok="Open Printers", cancel="Close") == "ok":
                open_printers()
            return 1
        if pkg.kind == "deb":
            say(f"{title} cannot be installed from a .deb on this system. It has:\n{reasons}\n\n"
                f"These need the system itself, and the system cannot take .deb packages. "
                f"Look for an .rpm version for Fedora {fedora_version()}, or the app on Flathub.", "warning")
            return 1
        if ask(f"{title} has:\n{reasons}\n\nThese need the system itself, so it cannot go in a box. It can be added "
               f"to the system instead. That needs the administrator password, takes effect after a restart, and "
               f"makes system updates a little slower. {UPDATES_SYSTEM} You can remove it later with Remove Apps.",
               ok="Add to the system") != "ok":
            return 1
        return install_system(pkg, title, printer)

    box = BOXES[pkg.kind]
    new_box = not box_exists(box["name"])
    size = None
    if new_box:
        text, size = box_intro(pkg.kind, title)
    else:
        text = f"Install {title} in the {box['label']}?"
    extra = None
    if info["safe_rules"]:
        text += "\n\nIt has a hardware rule. That goes onto the system itself, so you will be asked for the " \
                "administrator password."
    if info["notes"]:
        text += "\n\nIn the box, these parts will not work:\n" + plain_list(info["notes"])
        if pkg.kind == "rpm":
            text += "\n\nTo have them work, add it to the system instead (administrator password, restart, " \
                    "slower system updates)."
            extra = "Add to the system"
    answer = ask(text, ok="Set up and install" if new_box else "Install", extra=extra)
    if answer == "extra":
        return install_system(pkg, title)
    if answer != "ok":
        return 1
    if new_box and not setup_box(pkg.kind, size):
        return 1
    return box_install(pkg, info, title)


def staged_copy(pkg):
    CACHE.mkdir(parents=True, exist_ok=True)
    dest = CACHE / pkg.path.name
    if pkg.path.resolve() != dest.resolve():
        shutil.copyfile(pkg.path, dest)
    return dest


def box_install(pkg, info, title, quiet=False, mode="install"):
    """Install into the box, which exists. quiet: no questions or messages (used by repair).
    mode: install, reinstall (same version again), update (newer file) or older (an older file)."""
    label = BOXES[pkg.kind]["label"]
    box = BOXES[pkg.kind]["name"]
    f = str(staged_copy(pkg))
    ensure_helpers(pkg.kind, quiet=quiet)      # boxes made before the helpers were part of the setup
    rules_before = box_rules(box)
    repos_before = box_repos(box, pkg.kind)
    doing = {"reinstall": "Reinstalling", "update": "Updating", "older": "Installing the older version of"
             }.get(mode, "Installing")
    if pkg.kind == "rpm":
        verb = {"reinstall": "reinstall", "older": "downgrade"}.get(mode, "install")
        steps = [(f"{doing} {title}", in_box(box, "sudo", "dnf", "-y", verb, f))]
    else:
        extra = {"reinstall": ["--reinstall"], "older": ["--allow-downgrades"]}.get(mode, [])
        steps = [("Getting Ubuntu's list of packages", in_box(box, "sudo", "apt-get", "update")),
                 (f"{doing} {title}",
                  in_box(box, "sudo", "env", "DEBIAN_FRONTEND=noninteractive", "apt-get", "install", "-y", *extra, f))]
    if not run_steps(f"{doing} {title} in the {label}.", steps):
        if quiet:
            return 1
        if not box_works(box):
            def repair_then_install():
                if repair(pkg.kind, confirm=False) != 0:
                    return 1
                return box_install(pkg, info, title)
            return failed(f"Installing {title}", offer=("Repair the box", repair_then_install),
                          reason=f"The {label} is not working. Repair sets it up again from scratch, puts back the "
                                 f"apps that were in it, then installs {title}. Your own files are not touched.")
        return failed(f"Installing {title}")
    apps, bins = export(box, info)
    new_box_rules(box, rules_before, info)
    old = next((r for r in load() if r["where"] == box and r["package"] == pkg.name), {})
    # Updates: the package (or its install script, as Chrome's and VS Code's do) added a download source
    updates = adds_source(pkg) or bool(set(box_repos(box, pkg.kind)) - set(repos_before)) or \
        bool(old.get("updates"))
    entry = {"title": title, "package": pkg.name, "where": box, "apps": apps, "bins": bins,
             "rules": bool(old.get("rules")), "file": f, "version": pkg.evr, "updates": updates}
    remember(entry)
    extra = ""
    if quiet:
        return 0
    if info["safe_rules"]:
        ok, out = add_rules(pkg, info)
        if ok:
            entry["rules"] = True
            remember(entry)
            extra = "\n\nIts hardware rule is on the system. Unplug the device and plug it back in."
        else:
            extra = f"\n\nIts hardware rule was not added, so it may not reach its device.\n{out}"
    if info["notes"]:
        extra += "\n\nIn the box, these parts do not work:\n" + plain_list(info["notes"])
    if apps:
        where = "Find it in the app grid."
    elif bins:
        where = "Run it from a terminal: " + ", ".join(os.path.basename(b) for b in bins)
    else:
        where = f"It has no app or command of its own. Use it inside the box: distrobox enter {box}"
    done = {"reinstall": "is reinstalled", "update": f"is updated to version {plain_version(pkg.evr)}",
            "older": f"is now version {plain_version(pkg.evr)}"}.get(mode, "is installed")
    notify(f"{title} {done}.")
    say(f"{title} {done}. {where}{extra}\n\n{UPDATES_YES if updates else UPDATES_NO}")
    return 0


def staged_system():
    r = subprocess.run(["rpm-ostree", "status", "--json"], capture_output=True, text=True)
    try:
        return any(d.get("staged") for d in json.loads(r.stdout)["deployments"])
    except (ValueError, KeyError):
        return False


def offer_restart(text):
    if ask(text, ok="Restart now", cancel="Later") == "ok":
        subprocess.run(["systemctl", "reboot"])


def install_system(pkg, title, printer=False, update=False):
    f = str(staged_copy(pkg))
    if update:      # the layered file is swapped for the newer one in one step
        old = next((r for r in load() if r["where"] == "system" and r["package"] == pkg.name), {})
        cmd = ["rpm-ostree", "uninstall", old.get("nevra") or pkg.name, "--install", f]
        what = f"Updating {title} on the system. This can take a few minutes."
    else:
        cmd = ["rpm-ostree", "install", "--idempotent", f]
        what = f"Adding {title} to the system. This can take a few minutes."
    notify(f"{what.split('.')[0]}. A progress window shows it.")
    if not run_steps(what, [cmd]):
        failed(f"{'Updating' if update else 'Adding'} {title} {'on' if update else 'to'} the system")
        return 1
    remember({"title": title, "package": pkg.name, "nevra": pkg.nevra, "where": "system", "version": pkg.evr})
    # checked once at the next login: is it really there, and for a printer driver, add the printer
    pending([e for e in pending() if e["package"] != pkg.name] + [{"title": title, "package": pkg.name,
                                                                  "printer": printer and not update,
                                                                  "version": pkg.evr}])
    after = "After the restart, you will be asked to add your printer." if printer and not update else \
        "After the restart, you will be told when it is ready."
    done = f"is updated to version {plain_version(pkg.evr)}" if update else "is added to the system"
    notify(f"{title} {done}. Restart to use it.")
    offer_restart(f"{title} {done}. Restart to use it.\n\n{after}\n\nUpdates: {UPDATES_SYSTEM}")
    return 0


# ---------------------------------------------------------------- remove

def remove():
    records = load()
    if not records:
        say("Nothing has been installed with Install Package File yet.")
        return 0
    i = choose("Which app do you want to remove?", ["App", "Installed in"],
               [[r["title"], WHERE.get(r["where"], r["where"])] for r in records])
    if i is None:
        return 1
    entry = records[i]
    title = entry["title"]
    if ask(f"Remove {title}?", ok="Remove") != "ok":
        return 1
    where = entry["where"]
    if where == "flathub":
        ok = run_steps(f"Removing {title}.", [["flatpak", "uninstall", "-y", "--noninteractive", entry["package"]]])
    elif where == "system":
        ok = run_steps(f"Removing {title} from the system.", [["rpm-ostree", "uninstall", entry["package"]]])
        if not ok and entry.get("nevra"):
            ok = run_steps(f"Removing {title} from the system.", [["rpm-ostree", "uninstall", entry["nevra"]]])
    elif where == "rules":
        ok = remove_rules(entry["package"])
    else:
        unexport(entry)
        ok = True
        if box_exists(where) and box_works(where):
            cmd = ["sudo", "dnf", "-y", "remove", entry["package"]] if where == BOXES["rpm"]["name"] else \
                ["sudo", "env", "DEBIAN_FRONTEND=noninteractive", "apt-get", "remove", "-y", entry["package"]]
            ok = run_steps(f"Removing {title}.", [in_box(where, *cmd)])
        if ok and entry.get("rules"):
            ok = remove_rules(entry["package"])
    if not ok:
        failed(f"Removing {title}")
        return 1
    forget(entry)
    pending([e for e in pending() if e["package"] != entry["package"]])
    notify(f"{title} is removed.")
    if where == "system":
        offer_restart(f"{title} is removed. Restart to finish.")
        return 0
    kind = next((k for k in BOXES if BOXES[k]["name"] == where), None)
    if kind and box_exists(where) and not any(r["where"] == where for r in load()):
        label = BOXES[kind]["label"]
        mb = box_size(where)
        free = f" and free about {human(mb)} of disk space" if mb else " and free its disk space"
        if ask(f"{title} is removed.\n\nThe {label} has no apps from Install Package File left. Delete the box{free}?"
               f"\n\nIt is set up again by itself the next time you install {'an .rpm' if kind == 'rpm' else 'a .deb'} "
               f"app. Anything installed inside it some other way is deleted too. Your own files are not touched.",
               ok="Delete the box", cancel="Keep it") == "ok":
            if delete_box(kind):
                notify(f"The {label} is deleted.")
                say(f"The {label} is deleted.")
            else:
                failed(f"Deleting the {label}")
        return 0
    say(f"{title} is removed.")
    return 0


