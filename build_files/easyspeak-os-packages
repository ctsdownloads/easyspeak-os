# ---------------------------------------------------------------- reading a package

class Package:
    def __init__(self, path):
        self.path = Path(path)
        self.kind = ""            # rpm or deb
        self.name = self.version = self.arch = self.nevra = ""
        self.files = []           # normalized paths (/usr/..., no ./)
        self.texts = {}           # path -> text, for udev rules and desktop files
        self.depends = ""         # requirements, as one lowercase string
        self.scripts = ""         # install scripts, as one lowercase string
        self.vendor = ""          # rpm Vendor or deb Maintainer, to name the maker
        self.evr = ""             # version for comparing: rpm epoch:version-release; deb version (epoch included)


def norm(p):
    p = "/" + p.lstrip("./").lstrip("/") if p not in (".", "./") else "/"
    for old, new in (("/lib/", "/usr/lib/"), ("/lib64/", "/usr/lib64/"), ("/bin/", "/usr/bin/"),
                     ("/sbin/", "/usr/sbin/")):
        if p.startswith(old):
            p = new + p[len(old):]
    return p.rstrip("/") or "/"


def wanted_text(p):
    return (p.endswith(".rules") and "/udev/rules.d/" in p) or p.endswith(".desktop")


def read_tar(pkg, fileobj, mode):
    links = {}
    with tarfile.open(fileobj=fileobj, mode=mode) as tar:
        for m in tar:
            p = norm(m.name)
            if m.isdir():
                continue
            pkg.files.append(p)
            if m.issym():
                links[p] = m.linkname
            elif m.isfile() and wanted_text(p) and m.size < 256 * 1024:
                pkg.texts[p] = tar.extractfile(m).read().decode("utf-8", "replace")
    # a launcher or rule that is a link to a file elsewhere in the package (Discord does this)
    for p, target in links.items():
        if wanted_text(p):
            real = target if target.startswith("/") else os.path.normpath(os.path.join(os.path.dirname(p), target))
            if norm(real) in pkg.texts:
                pkg.texts[p] = pkg.texts[norm(real)]


def read_rpm(pkg):
    def q(*args):
        r = subprocess.run(["rpm", "-qp", "--nosignature", "--nodigest", *args, str(pkg.path)],
                           capture_output=True, text=True)
        if r.returncode != 0:
            raise ValueError(r.stderr.strip() or "rpm could not read it")
        return r.stdout
    info = q("--qf", "%{NAME}\n%{VERSION}-%{RELEASE}\n%{ARCH}\n%{VENDOR}\n%{EPOCHNUM}\n").split("\n")
    pkg.kind, pkg.name, pkg.version, pkg.arch, pkg.vendor = "rpm", info[0], info[1], info[2], info[3]
    pkg.evr = f"{info[4] or 0}:{pkg.version}"
    pkg.nevra = f"{pkg.name}-{pkg.version}.{pkg.arch}"
    pkg.depends = q("--requires").lower()
    pkg.scripts = q("--scripts").lower()
    proc = subprocess.Popen(["rpm2archive", "-n", "-"], stdin=open(pkg.path, "rb"), stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL)
    read_tar(pkg, proc.stdout, "r|")
    proc.stdout.close()
    proc.wait()


def read_deb(pkg):
    data = control = None
    with open(pkg.path, "rb") as f:
        if f.read(8) != b"!<arch>\n":
            raise ValueError("it is not a .deb package")
        while True:
            head = f.read(60)
            if len(head) < 60:
                break
            name = head[:16].decode().strip().rstrip("/")
            size = int(head[48:58].decode().strip())
            body = f.read(size)
            if size % 2:
                f.read(1)
            if name.startswith("control.tar"):
                control = body
            elif name.startswith("data.tar"):
                data = body
    if control is None or data is None:
        raise ValueError("the .deb is incomplete")
    fields, scripts = {}, []
    with tarfile.open(fileobj=io.BytesIO(control), mode="r:*") as tar:
        for m in tar:
            base = os.path.basename(m.name)
            if not m.isfile():
                continue
            text = tar.extractfile(m).read().decode("utf-8", "replace")
            if base == "control":
                for k, v in re.findall(r"^([A-Za-z-]+):[ \t]*(.*(?:\n[ \t].*)*)", text, re.M):
                    fields[k.lower()] = v
            elif base in ("preinst", "postinst", "prerm", "postrm"):
                scripts.append(text)
    pkg.kind = "deb"
    pkg.name = fields.get("package", "").strip()
    pkg.version = fields.get("version", "").strip()
    pkg.arch = fields.get("architecture", "").strip()
    pkg.vendor = fields.get("maintainer", "").strip()
    pkg.evr = pkg.version
    pkg.depends = " ".join(fields.get(k, "") for k in ("depends", "pre-depends")).lower()
    pkg.scripts = "\n".join(scripts).lower()
    read_tar(pkg, io.BytesIO(data), "r:*")
    if not pkg.name:
        raise ValueError("the .deb has no package name")


def read_package(path):
    pkg = Package(path)
    with open(path, "rb") as f:
        magic = f.read(8)
    if magic.startswith(b"\xed\xab\xee\xdb"):
        read_rpm(pkg)
    elif magic == b"!<arch>\n":
        read_deb(pkg)
    else:
        raise ValueError("it is not an .rpm or .deb package")
    return pkg


# ---------------------------------------------------------------- what the package needs

def desktop_entry(text):
    """(visible, name) for a .desktop file."""
    sect, fields = None, {}
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("["):
            sect = line
        elif sect == "[Desktop Entry]" and "=" in line:
            k, v = line.split("=", 1)
            fields.setdefault(k.strip(), v.strip())
    visible = fields.get("Type", "Application") == "Application" and \
        fields.get("NoDisplay", "").lower() != "true" and fields.get("Hidden", "").lower() != "true"
    return visible, fields.get("Name", "")


RUNS_PROGRAM = re.compile(r"\bRUN\b(?!\{builtin\})|\bPROGRAM\b|IMPORT\{program\}")   # RUN{builtin} stays in udev


def rule_runs_program(text):
    joined = re.sub(r"\\\n", " ", text)
    return any(RUNS_PROGRAM.search(l) for l in joined.splitlines() if not l.lstrip().startswith("#"))


def starts(p, *prefixes):
    return any(p.startswith(x) for x in prefixes)


def classify(pkg):
    """What the package has that a box cannot provide, in plain words."""
    files = pkg.files
    apps = {}
    for p in files:
        if p.startswith("/usr/share/applications/") and p.endswith(".desktop") and p in pkg.texts:
            visible, name = desktop_entry(pkg.texts[p])
            if visible:
                apps[p] = name or os.path.basename(p)[:-8]
    rules = {p: pkg.texts.get(p, "") for p in files if "/udev/rules.d/" in p and p.endswith(".rules")}
    safe_rules = {p: t for p, t in rules.items() if t and not rule_runs_program(t)}
    program_rules = [p for p in rules if p not in safe_rules]

    found = {}
    def flag(key, test):
        if any(test(p) for p in files):
            found[key] = True

    flag("driver", lambda p: starts(p, "/usr/lib/modules/", "/usr/src/akmods/", "/etc/modprobe.d/",
                                   "/usr/lib/modprobe.d/", "/etc/modules-load.d/", "/usr/lib/modules-load.d/",
                                   "/etc/dkms/")
         or re.search(r"\.ko(\.(xz|zst|gz))?$", p) or (p.startswith("/usr/src/") and p.endswith("/dkms.conf")))
    if re.search(r"(^|[\s,(])(dkms|akmods|kernel-devel|linux-headers[\w.-]*)([\s,()]|$)", pkg.depends):
        found["driver"] = True
    flag("firmware", lambda p: p.startswith("/usr/lib/firmware/"))
    flag("printer", lambda p: starts(p, "/usr/lib/cups/", "/usr/share/cups/model/", "/usr/share/cups/drv/",
                                    "/usr/share/ppd/"))
    flag("scanner", lambda p: starts(p, "/etc/sane.d/") or re.match(r"/usr/lib(64)?/(x86_64-linux-gnu/)?sane/", p))
    flag("login", lambda p: starts(p, "/etc/pam.d/", "/usr/lib/pam.d/", "/etc/security/", "/etc/sudoers.d/",
                                  "/etc/selinux/", "/usr/share/selinux/")
         or re.match(r"/usr/lib(64)?/(x86_64-linux-gnu/)?security/", p))
    flag("network", lambda p: starts(p, "/usr/lib/NetworkManager/", "/usr/lib64/NetworkManager/",
                                    "/etc/NetworkManager/", "/usr/lib/firewalld/", "/etc/firewalld/"))
    flag("service", lambda p: (starts(p, "/usr/lib/systemd/system/", "/etc/systemd/system/")
                               and re.search(r"\.(service|socket|timer|path)$", p))
         or starts(p, "/etc/init.d/", "/usr/share/dbus-1/system-services/", "/usr/share/dbus-1/system.d/",
                   "/etc/dbus-1/system.d/"))
    flag("settings", lambda p: starts(p, "/usr/lib/sysctl.d/", "/etc/sysctl.d/", "/usr/lib/udev/hwdb.d/",
                                     "/etc/udev/hwdb.d/"))
    flag("admin", lambda p: starts(p, "/usr/share/polkit-1/", "/etc/polkit-1/"))

    words = {
        "driver": "a driver (kernel module)",
        "firmware": "device firmware",
        "printer": "a printer driver",
        "scanner": "a scanner driver",
        "login": "login or security settings",
        "network": "a network or VPN plugin for the system",
        "service": "a background service that starts with the computer",
        "programrules": "a hardware rule that runs a program",
    }
    if program_rules:
        found["programrules"] = True
    blocking = [words[k] for k in ("driver", "firmware", "printer", "scanner", "login", "network") if k in found]
    notes = []
    if "service" in found:
        (notes if apps else blocking).append(words["service"])
    if "programrules" in found:
        (notes if apps else blocking).append(words["programrules"])
    if "settings" in found:
        notes.append("system settings (these will not apply)")
    if "admin" in found:
        notes.append("parts that need administrator rights (these may not work)")

    docs = ("/usr/share/doc/", "/usr/share/licenses/", "/usr/share/man/", "/usr/share/metainfo/",
            "/usr/share/appdata/", "/usr/lib/.build-id/")
    rules_only = bool(safe_rules) and not blocking and \
        all(p in safe_rules or starts(p, *docs) for p in files)
    bins = sorted(p for p in files if re.match(r"/usr/bin/[^/]+$", p))[:10]
    # one app: its own name; several (Syncthing has "Start Syncthing" and "Syncthing Web UI"): the package name
    title = next(iter(apps.values())) if len(apps) == 1 else pkg.name.capitalize() if apps else pkg.name
    return {"apps": apps, "bins": bins, "safe_rules": safe_rules, "blocking": blocking, "notes": notes,
            "rules_only": rules_only, "title": title}


# ---------------------------------------------------------------- talking to the person

GUI = bool(shutil.which("zenity")) and bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"))


# easyspeak-os-dialog is zenity plus voice: while a window is open, EasySpeak can press its buttons ("set up and
# install", "cancel"), pick a line of a list ("number two") or read it out ("read it"). zenity is the fallback.
DIALOG = "/usr/bin/easyspeak-os-dialog" if os.access("/usr/bin/easyspeak-os-dialog", os.X_OK) else "zenity"


def zenity(*args, stdin=None):
    return subprocess.run([DIALOG, f"--title={TITLE}", "--width=520", *args], input=stdin,
                          capture_output=True, text=True)


def notify(text):
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", f"--app-name={TITLE}", "--icon=system-software-install-symbolic",
                        TITLE, text], capture_output=True)


def say(text, kind="info"):
    if GUI:
        zenity(f"--{kind}", "--no-markup", f"--text={text}")
    else:
        print(text)


def ask(text, ok="Yes", cancel="Cancel", extra=None):
    """'ok', 'extra' or None."""
    if GUI:
        args = ["--question", "--no-markup", f"--text={text}", f"--ok-label={ok}", f"--cancel-label={cancel}"]
        if extra:
            args.append(f"--extra-button={extra}")
        r = zenity(*args)
        if r.returncode == 0:
            return "ok"
        return "extra" if extra and r.stdout.strip() == extra else None
    print(text)
    choices = {"1": "ok"} | ({"2": "extra"} if extra else {})
    print(f"  1) {ok}" + (f"\n  2) {extra}" if extra else "") + f"\n  Enter) {cancel}")
    try:
        return choices.get(input("> ").strip())
    except EOFError:
        return None


def choose(text, columns, rows):
    """Pick one row; returns its index or None."""
    if not rows:
        return None
    if GUI:
        # column 1 (hidden) is what is printed back; column 2 is the number people see and can say ("number two")
        args = ["--list", f"--text={text}", "--height=420", "--print-column=1", "--hide-column=1",
                "--column=n", "--column=No.", *[f"--column={c}" for c in columns]]
        cells = []
        for i, row in enumerate(rows):
            cells += [str(i), str(i + 1), *row]
        r = zenity(*args, stdin="\n".join(cells) + "\n")
        out = r.stdout.strip().split("|")[0]
        return int(out) if r.returncode == 0 and out.isdigit() else None
    print(text)
    for i, row in enumerate(rows, 1):
        print(f"  {i}) " + "   ".join(row))
    try:
        n = input("> ").strip()
    except EOFError:
        return None
    return int(n) - 1 if n.isdigit() and 0 < int(n) <= len(rows) else None


CANCELLED = False      # set by run_steps when the person pressed Cancel
BUSY = CACHE / ".busy"   # what this run is doing, for a second window that has to wait for it


def busy(text):
    try:
        BUSY.write_text(text)
    except OSError:
        pass


def run_steps(text, steps, cancel=False):
    """Run steps one after another with a progress window, and True if all worked.

    Each step is (label, command) or just a command (then the window text is the label). The window shows the
    step's plain label, never the command's own output, which goes to the log. While a step runs, the label also
    says how long it has been going, once a minute. With cancel=True the window has a Cancel button, which stops
    the running command."""
    global CANCELLED
    CANCELLED = False
    steps = [st if isinstance(st, tuple) else (text, st) for st in steps]
    CACHE.mkdir(parents=True, exist_ok=True)
    if LOG.exists() and LOG.stat().st_size > 2_000_000:     # keep the log from growing without end
        LOG.write_bytes(LOG.read_bytes()[-500_000:])
    log = open(LOG, "a")
    log.write(f"\n=== {time.strftime('%Y-%m-%d %H:%M:%S')} {text}\n")
    busy(text)
    bar = None
    if GUI:
        mode = ["--pulsate"] if len(steps) == 1 else []
        bar = subprocess.Popen([DIALOG if cancel else "zenity", f"--title={TITLE}", "--width=520", "--progress",
                                *mode, "--auto-close",
                                *([] if cancel else ["--no-cancel"]), f"--text={html.escape(text)}"],
                               stdin=subprocess.PIPE, text=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        print(text)

    def show(*lines):
        if not bar:
            return
        try:
            bar.stdin.write("".join(l + "\n" for l in lines))
            bar.stdin.flush()
        except (BrokenPipeError, OSError):
            pass

    ok = True
    for i, (label, cmd) in enumerate(steps):
        show(*([str(int(100 * i / len(steps)))] if len(steps) > 1 else []), "# " + html.escape(label))
        if not bar:
            print("  " + label)
        log.write("$ " + " ".join(cmd) + "\n")
        log.flush()
        try:
            proc = subprocess.Popen(cmd, stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                    start_new_session=True)
        except OSError as e:
            log.write(f"{e}\n")
            ok = False
            break
        began, shown = time.time(), 0
        while proc.poll() is None:
            time.sleep(1)
            if bar and bar.poll() is not None:          # the window was closed: Cancel
                if cancel:
                    CANCELLED = True
                    try:
                        os.killpg(proc.pid, signal.SIGTERM)
                    except OSError:
                        pass
                    proc.wait()
                    break
                bar = None
            mins = int(time.time() - began) // 60
            if mins > shown:
                shown = mins
                show("# " + html.escape(f"{label}  ({mins} min so far)"))
        if CANCELLED or proc.returncode != 0:
            ok = False
            break
    log.close()
    if bar and bar.poll() is None:
        show("100")
        try:
            bar.stdin.close()
        except (BrokenPipeError, OSError):
            pass
        bar.wait()
    return ok


def log_tail(n=4000):
    try:
        with open(LOG, errors="replace") as f:
            text = f.read()
        return text[text.rfind("\n=== "):][-n:] if "\n=== " in text else text[-n:]
    except OSError:
        return ""


def explain(log):
    """The usual reasons an install fails, in plain words, or ''."""
    low = log.lower()
    m = re.search(r"nothing provides ([^\s]+)", low)
    if m:
        return (f"It needs {m.group(1)}, which Fedora {fedora_version()} does not have. "
                f"It may be made for a different Fedora version.")
    m = re.search(r"depends: ([^\s]+)[^\n]*but (it is not installable|it is not going to be installed|[^\n]*is to be "
                  r"installed)", low)
    if m or "unmet dependencies" in low:
        part = f"{m.group(1)}, which" if m else "parts that"
        return (f"It needs {part} the Ubuntu box (Ubuntu 24.04) does not have. "
                f"It may be made for a newer or older Ubuntu.")
    if "no space left on device" in low:
        return "The disk is full. Free some space, then try again."
    if re.search(r"could not resolve|temporary failure resolving|name or service not known|network is unreachable|"
                 r"connection timed out|curl error|failed to download|cannot download|tls handshake", low):
        return "It could not reach the internet. Check the connection, then try again."
    if re.search(r"conflicts with file from package|file [^\n]* conflicts", low):
        return "It would replace a file that belongs to the system, so it was not added."
    if re.search(r"different architecture|wrong architecture|incompatible architecture", low):
        return "It is made for a different kind of processor than this computer has."
    if re.search(r"not authorized|accessdenied|authentication (failed|dismissed)|request dismissed", low):
        return "The administrator password was not given, so nothing was changed."
    if re.search(r"no such container|error: container .* does not exist|cannot find container", low):
        return "The box is missing or broken."
    return ""


def failed(what, offer=None, reason=""):
    """Say that something did not work, in plain words when the reason is a usual one. offer: (button, action)."""
    log = log_tail()
    reason = reason or explain(log)
    if not reason:
        lines = [l for l in log.splitlines() if l.strip() and not l.startswith(("===", "$ "))]
        reason = "The last lines of the log:\n" + "\n".join(lines[-4:]) if lines else ""
    notify(f"{what} did not work.")
    text = f"{what} did not work.\n\n{reason}\n\nThe full details are in {LOG}"
    if offer:
        if ask(text, ok=offer[0], cancel="Close") == "ok":
            return offer[1]()
        return 1
    say(text, "error")
    return 1


# ---------------------------------------------------------------- records

def load():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return []


def save(records):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(records, indent=1))
    tmp.replace(STATE)


def remember(entry):
    records = [r for r in load() if not (r["package"] == entry["package"] and r["where"] == entry["where"])]
    save(records + [entry])


def forget(entry):
    save([r for r in load() if not (r["package"] == entry["package"] and r["where"] == entry["where"])])


# ---------------------------------------------------------------- boxes

def box_exists(name):
    return subprocess.run(["podman", "container", "exists", name], capture_output=True).returncode == 0


def in_box(box, *cmd):
    return ["distrobox", "enter", "-T", "-n", box, "--", *cmd]


def image_size(image):
    """Download size of a box image in MB: 0 if it is already on this computer, None if it cannot be found out."""
    if subprocess.run(["podman", "image", "exists", image], capture_output=True).returncode == 0:
        return 0
    reg, _, rest = image.partition("/")
    repo, _, tag = rest.rpartition(":")
    arch = {"x86_64": "amd64", "aarch64": "arm64"}.get(platform.machine(), platform.machine())
    lists = "application/vnd.oci.image.index.v1+json,application/vnd.docker.distribution.manifest.list.v2+json"
    single = "application/vnd.oci.image.manifest.v1+json,application/vnd.docker.distribution.manifest.v2+json"
    try:
        headers = {}
        if reg == "quay.io":
            url = f"https://quay.io/v2/auth?service=quay.io&scope=repository:{repo}:pull"
            headers["Authorization"] = "Bearer " + json.load(urllib.request.urlopen(url, timeout=6))["token"]

        def get(ref, accept):
            req = urllib.request.Request(f"https://{reg}/v2/{repo}/manifests/{ref}",
                                         headers={**headers, "Accept": accept})
            return json.load(urllib.request.urlopen(req, timeout=6))
        man = get(tag, lists + "," + single)
        if "manifests" in man:
            digest = next(m["digest"] for m in man["manifests"] if m.get("platform", {}).get("architecture") == arch)
            man = get(digest, single)
        return max(1, sum(l["size"] for l in man["layers"]) // 1_000_000)
    except Exception:
        return None


def human(mb):
    """'450 MB' or '1.2 GB'."""
    return f"{mb / 1000:.1f} GB" if mb >= 1000 else f"{max(1, int(mb))} MB"


def box_sizes(names):
    """Disk space each box uses in MB (its system plus what was installed in it), in one look; {} if not known
    quickly."""
    names = [n for n in names if box_exists(n)]
    if not names:
        return {}
    try:
        r = subprocess.run(["podman", "ps", "-a", "--size", "--format", "json",
                            *[f"--filter=name=^{n}$" for n in names]], capture_output=True, text=True, timeout=20)
        out = {}
        for c in json.loads(r.stdout):
            name = (c.get("Names") or [""])[0]
            size = c.get("Size") or {}
            out[name] = max(size.get("rootFsSize", 0), size.get("rwSize", 0)) // 1_000_000
        return out
    except (OSError, subprocess.TimeoutExpired, ValueError, AttributeError, TypeError):
        return {}


def box_size(name):
    return box_sizes([name]).get(name)


def delete_box(kind):
    """Delete an app box and its downloaded system, to free the space. Your own files are not touched."""
    box = BOXES[kind]
    ok = run_steps(f"Deleting the {box['label']}.", [["distrobox", "rm", "--force", box["name"]]])
    if ok:     # the box's system image too, unless something else still uses it
        subprocess.run(["podman", "image", "rm", box["image"]], capture_output=True)
        helpers_mark(kind).unlink(missing_ok=True)
    return ok


def box_words(kind):
