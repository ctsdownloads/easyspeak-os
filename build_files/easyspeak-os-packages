# ---------------------------------------------------------------- reading a package

class Package:
    def __init__(self, path):
        self.path = Path(path)
        self.kind = ""            # rpm or deb
        self.name = self.version = self.arch = self.nevra = ""
        self.files = []           # normalized paths (/usr/..., no ./)
        self.texts = {}           # path -> text, for udev rules and desktop files
        self.depends = ""         # requirements, as one lowercase string
        self.scripts = ""         # install scripts, as one lowercase string
        self.vendor = ""          # rpm Vendor or deb Maintainer, to name the maker
        self.evr = ""             # version for comparing: rpm epoch:version-release; deb version (epoch included)


def norm(p):
    p = "/" + p.lstrip("./").lstrip("/") if p not in (".", "./") else "/"
    for old, new in (("/lib/", "/usr/lib/"), ("/lib64/", "/usr/lib64/"), ("/bin/", "/usr/bin/"),
                     ("/sbin/", "/usr/sbin/")):
        if p.startswith(old):
            p = new + p[len(old):]
    return p.rstrip("/") or "/"


def wanted_text(p):
    base = os.path.basename(p)
    return (p.endswith(".rules") and "/udev/rules.d/" in p) or p.endswith(".desktop") or bool(REPO_FILE.match(p)) \
        or p.endswith((".metainfo.xml", ".appdata.xml")) or base in ("Makefile", "Kbuild") or \
        p.startswith(("/usr/lib/systemd/system-preset/", "/usr/lib/systemd/user-preset/")) or \
        (p.startswith("/usr/share/polkit-1/actions/") and p.endswith(".policy"))


def read_tar(pkg, fileobj, mode):
    links = {}
    with tarfile.open(fileobj=fileobj, mode=mode) as tar:
        for m in tar:
            p = norm(m.name)
            if m.isdir():
                continue
            pkg.files.append(p)
            if m.issym():
                links[p] = m.linkname
            elif m.isfile() and wanted_text(p) and m.size < 256 * 1024:
                pkg.texts[p] = tar.extractfile(m).read().decode("utf-8", "replace")
    # a launcher or rule that is a link to a file elsewhere in the package (Discord does this)
    for p, target in links.items():
        if wanted_text(p):
            real = target if target.startswith("/") else os.path.normpath(os.path.join(os.path.dirname(p), target))
            if norm(real) in pkg.texts:
                pkg.texts[p] = pkg.texts[norm(real)]


def read_rpm(pkg):
    def q(*args):
        r = subprocess.run(["rpm", "-qp", "--nosignature", "--nodigest", *args, str(pkg.path)],
                           capture_output=True, text=True)
        if r.returncode != 0:
            raise ValueError(r.stderr.strip() or "rpm could not read it")
        return r.stdout
    info = q("--qf", "%{NAME}\n%{VERSION}-%{RELEASE}\n%{ARCH}\n%{VENDOR}\n%{EPOCHNUM}\n").split("\n")
    pkg.kind, pkg.name, pkg.version, pkg.arch, pkg.vendor = "rpm", info[0], info[1], info[2], info[3]
    pkg.evr = f"{info[4] or 0}:{pkg.version}"
    pkg.nevra = f"{pkg.name}-{pkg.version}.{pkg.arch}"
    pkg.depends = q("--requires").lower()
    pkg.scripts = q("--scripts").lower()
    proc = subprocess.Popen(["rpm2archive", "-n", "-"], stdin=open(pkg.path, "rb"), stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL)
    read_tar(pkg, proc.stdout, "r|")
    proc.stdout.close()
    proc.wait()


def read_deb(pkg):
    data = control = None
    with open(pkg.path, "rb") as f:
        if f.read(8) != b"!<arch>\n":
            raise ValueError("it is not a .deb package")
        while True:
            head = f.read(60)
            if len(head) < 60:
                break
            name = head[:16].decode().strip().rstrip("/")
            size = int(head[48:58].decode().strip())
            body = f.read(size)
            if size % 2:
                f.read(1)
            if name.startswith("control.tar"):
                control = body
            elif name.startswith("data.tar"):
                data = body
    if control is None or data is None:
        raise ValueError("the .deb is incomplete")
    fields, scripts = {}, []
    with tarfile.open(fileobj=io.BytesIO(control), mode="r:*") as tar:
        for m in tar:
            base = os.path.basename(m.name)
            if not m.isfile():
                continue
            text = tar.extractfile(m).read().decode("utf-8", "replace")
            if base == "control":
                for k, v in re.findall(r"^([A-Za-z-]+):[ \t]*(.*(?:\n[ \t].*)*)", text, re.M):
                    fields[k.lower()] = v
            elif base in ("preinst", "postinst", "prerm", "postrm"):
                scripts.append(text)
    pkg.kind = "deb"
    pkg.name = fields.get("package", "").strip()
    pkg.version = fields.get("version", "").strip()
    pkg.arch = fields.get("architecture", "").strip()
    pkg.vendor = fields.get("maintainer", "").strip()
    pkg.evr = pkg.version
    pkg.depends = " ".join(fields.get(k, "") for k in ("depends", "pre-depends")).lower()
    pkg.scripts = "\n".join(scripts).lower()
    read_tar(pkg, io.BytesIO(data), "r:*")
    if not pkg.name:
        raise ValueError("the .deb has no package name")


def read_package(path):
    pkg = Package(path)
    with open(path, "rb") as f:
        magic = f.read(8)
    if magic.startswith(b"\xed\xab\xee\xdb"):
        read_rpm(pkg)
    elif magic == b"!<arch>\n":
        read_deb(pkg)
    else:
        raise ValueError("it is not an .rpm or .deb package")
    return pkg


# ---------------------------------------------------------------- what the package needs

def desktop_entry(text):
    """(visible, name) for a .desktop file."""
    sect, fields = None, {}
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("["):
            sect = line
        elif sect == "[Desktop Entry]" and "=" in line:
            k, v = line.split("=", 1)
            fields.setdefault(k.strip(), v.strip())
    visible = fields.get("Type", "Application") == "Application" and \
        fields.get("NoDisplay", "").lower() != "true" and fields.get("Hidden", "").lower() != "true"
    return visible, fields.get("Name", "")


RUNS_PROGRAM = re.compile(r"\bRUN\b(?!\{builtin\})|\bPROGRAM\b|IMPORT\{program\}")   # RUN{builtin} stays in udev


def rule_runs_program(text):
    joined = re.sub(r"\\\n", " ", text)
    return any(RUNS_PROGRAM.search(l) for l in joined.splitlines() if not l.lstrip().startswith("#"))


def starts(p, *prefixes):
    return any(p.startswith(x) for x in prefixes)


def classify(pkg):
    """What the package has that a box cannot provide, in plain words."""
    files = pkg.files
    apps = {}
    for p in files:
        if p.startswith("/usr/share/applications/") and p.endswith(".desktop") and p in pkg.texts:
            visible, name = desktop_entry(pkg.texts[p])
            if visible:
                apps[p] = name or os.path.basename(p)[:-8]
    rules = {p: pkg.texts.get(p, "") for p in files if "/udev/rules.d/" in p and p.endswith(".rules")}
    safe_rules = {p: t for p, t in rules.items() if t and not rule_runs_program(t)}
    program_rules = [p for p in rules if p not in safe_rules]

    found = {}
    def flag(key, test):
        if any(test(p) for p in files):
            found[key] = True

    flag("driver", lambda p: starts(p, "/usr/lib/modules/", "/usr/src/akmods/", "/etc/modprobe.d/",
                                   "/usr/lib/modprobe.d/", "/etc/modules-load.d/", "/usr/lib/modules-load.d/",
                                   "/etc/dkms/")
         or re.search(r"\.ko(\.(xz|zst|gz))?$", p) or (p.startswith("/usr/src/") and p.endswith("/dkms.conf")))
    if re.search(r"(^|[\s,(])(dkms|akmods|kernel-devel|linux-headers[\w.-]*)([\s,()]|$)", pkg.depends):
        found["driver"] = True
    # driver source built when the package is installed (VirtualBox does this): a kernel module makefile
    if any(t for p, t in pkg.texts.items() if os.path.basename(p) in ("Makefile", "Kbuild") and "obj-m" in t):
        found["driver"] = True
    if re.search(r"(^|[\s;|&(])(modprobe|insmod|depmod|dkms)\s", pkg.scripts):
        found["driver"] = True
    flag("firmware", lambda p: p.startswith("/usr/lib/firmware/"))
    flag("printer", lambda p: starts(p, "/usr/lib/cups/", "/usr/share/cups/model/", "/usr/share/cups/drv/",
                                    "/usr/share/ppd/"))
    flag("scanner", lambda p: starts(p, "/etc/sane.d/") or re.match(r"/usr/lib(64)?/(x86_64-linux-gnu/)?sane/", p))
    flag("login", lambda p: starts(p, "/etc/pam.d/", "/usr/lib/pam.d/", "/etc/security/", "/etc/sudoers.d/",
                                  "/etc/selinux/", "/usr/share/selinux/")
         or re.match(r"/usr/lib(64)?/(x86_64-linux-gnu/)?security/", p))
    flag("network", lambda p: starts(p, "/usr/lib/NetworkManager/", "/usr/lib64/NetworkManager/",
                                    "/etc/NetworkManager/", "/usr/lib/firewalld/", "/etc/firewalld/"))
    flag("service", lambda p: (starts(p, "/usr/lib/systemd/system/", "/etc/systemd/system/")
                               and re.search(r"\.(service|socket|timer|path)$", p))
         or starts(p, "/etc/init.d/", "/usr/share/dbus-1/system-services/", "/usr/share/dbus-1/system.d/",
                   "/etc/dbus-1/system.d/"))
    # A service the package's own install script turns on (systemctl enable/start) is one the app needs. Services
    # left to the system's defaults (Fedora's presets, or the lines Debian and Ubuntu packaging adds for every
    # service) are optional.
    units = [os.path.basename(p) for p in files if (starts(p, "/usr/lib/systemd/system/", "/etc/systemd/system/")
             and re.search(r"\.(service|socket|timer|path)$", p)) or p.startswith("/etc/init.d/")]
    user_units = [os.path.basename(p) for p in files if p.startswith("/usr/lib/systemd/user/") and p.endswith(".service")]
    presets = "\n".join(t for p, t in pkg.texts.items() if "/systemd/system-preset/" in p)
    turned_on = False
    for line in pkg.scripts.splitlines():
        line = line.strip()
        if line.startswith("#"):
            continue
        user = bool(re.search(r"--user\b|--global\b", line))
        if re.search(r"\bsystemctl\b.*\b(enable|start|restart|reenable)\b", line):
            if (units and not user) or (user_units and user):
                turned_on = True
        elif user and user_units and re.search(r"\bsystemctl\b.*\bdaemon-reload\b", line):
            turned_on = True        # reloads the account's services so its own is ready to start (Docker Desktop)
    if re.search(r"^\s*enable\s", presets, re.M):
        turned_on = True
    # An app that runs as administrator (root): its polkit rule lets pkexec start one of its own programs as root
    # (Timeshift's does), or its app grid entry starts it with pkexec or sudo. A box cannot give it that.
    own = set(files)
    root_programs = [m for p, t in pkg.texts.items() if p.startswith("/usr/share/polkit-1/actions/")
                     for m in re.findall(r"org\.freedesktop\.policykit\.exec\.path\">\s*([^<\s]+)", t)
                     if norm(m) in own]
    root_launch = any(re.search(r"(?m)^Exec=\s*(\S*/)?(pkexec|sudo|gksu|gksudo|kdesu|su-to-root)\b", pkg.texts.get(p, ""))
                      for p in apps)
    if turned_on:
        found["needed_service"] = True
    elif user_units:
        found["user_service"] = True
    flag("settings", lambda p: starts(p, "/usr/lib/sysctl.d/", "/etc/sysctl.d/", "/usr/lib/udev/hwdb.d/",
                                     "/etc/udev/hwdb.d/"))
    flag("admin", lambda p: starts(p, "/usr/share/polkit-1/", "/etc/polkit-1/"))

    words = {
        "driver": "a driver (kernel module)",
        "firmware": "device firmware",
        "printer": "a printer driver",
        "scanner": "a scanner driver",
        "login": "login or security settings",
        "network": "a network or VPN plugin for the system",
        "service": "a background service that starts with the computer",
        "needed_service": "a background service the app needs, which cannot run in a box",
        "user_service": "a background service for your account (in a box it does not start)",
        "programrules": "a hardware rule that runs a program",
    }
    if program_rules:
        found["programrules"] = True
    blocking = [words[k] for k in ("driver", "firmware", "printer", "scanner", "login", "network") if k in found]
    notes = []
    if "needed_service" in found:
        blocking.append(words["needed_service"])
    elif "service" in found:
        (notes if apps else blocking).append(words["service"])
    if "user_service" in found:
        notes.append(words["user_service"])
    if "programrules" in found:
        (notes if apps else blocking).append(words["programrules"])
    if "settings" in found:
        notes.append("system settings (these will not apply)")
    if "admin" in found:
        notes.append("parts that need administrator rights (these may not work)")

    docs = ("/usr/share/doc/", "/usr/share/licenses/", "/usr/share/man/", "/usr/share/metainfo/",
            "/usr/share/appdata/", "/usr/lib/.build-id/", "/usr/share/lintian/")
    rules_only = bool(safe_rules) and not blocking and \
        all(p in safe_rules or starts(p, *docs) for p in files)
    # a package that only adds a download source (a repository) and its signing key, and no app
    keys = ("/etc/pki/rpm-gpg/", "/usr/share/distribution-gpg-keys/", "/etc/apt/trusted.gpg.d/", "/etc/apt/keyrings/",
            "/usr/share/keyrings/", "/etc/debsig/", "/usr/share/debsig/")
    repo_files = {p: t for p, t in pkg.texts.items() if REPO_FILE.match(p)}
    source_only = bool(repo_files) and not blocking and \
        all(REPO_FILE.match(p) or starts(p, *keys, *docs) for p in files)
    bins = sorted(p for p in files if re.match(r"/usr/bin/[^/]+$", p))[:10]
    # one app: its own name; several (Syncthing has "Start Syncthing" and "Syncthing Web UI"): the package name
    title = next(iter(apps.values())) if len(apps) == 1 else pkg.name.capitalize() if apps else pkg.name
    return {"apps": apps, "bins": bins, "safe_rules": safe_rules, "blocking": blocking, "notes": notes,
            "rules_only": rules_only, "source_only": source_only, "needs_root": bool(apps) and bool(root_programs or root_launch), "sources": source_names(repo_files, pkg.kind),
            "title": title}


def source_names(repo_files, kind):
    """The download sources a package adds: [(id, name, enabled)], from its .repo, .list or .sources files."""
    out = []
    for p, text in repo_files.items():
        if kind == "rpm" and p.endswith(".repo"):
            for m in re.finditer(r"^\[([^\]]+)\]\s*\n((?:(?!\[).*\n?)*)", text, re.M):
                body = m.group(2)
                name = re.search(r"^name\s*=\s*(.*)$", body, re.M)
                on = re.search(r"^enabled\s*=\s*(\S+)", body, re.M)
                out.append((m.group(1).strip(), (name.group(1).strip() if name else m.group(1)).replace(
                    "$releasever", fedora_version()).replace("$basearch", platform.machine()),
                    not on or on.group(1) not in ("0", "false", "no")))
        else:
            for m in re.finditer(r"^\s*deb\s+(?:\[[^\]]*\]\s+)?(\S+)|^URIs:\s*(\S+)", text, re.M):
                url = m.group(1) or m.group(2)
                out.append((url, re.sub(r"^\w+://", "", url).split("/")[0], True))
    return out


# ---------------------------------------------------------------- talking to the person

GUI = bool(shutil.which("zenity")) and bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"))


# easyspeak-os-dialog is zenity plus voice: while a window is open, EasySpeak can press its buttons ("set up and
# install", "cancel"), pick a line of a list ("number two") or read it out ("read it"). zenity is the fallback.
DIALOG = "/usr/bin/easyspeak-os-dialog" if os.access("/usr/bin/easyspeak-os-dialog", os.X_OK) else "zenity"


def zenity(*args, stdin=None):
    return subprocess.run([DIALOG, f"--title={TITLE}", "--width=520", *args], input=stdin,
                          capture_output=True, text=True)


def notify(text):
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", f"--app-name={TITLE}", "--icon=system-software-install-symbolic",
                        TITLE, text], capture_output=True)


def say(text, kind="info"):
    if GUI:
        zenity(f"--{kind}", "--no-markup", f"--text={text}")
    else:
        print(text)


def ask(text, ok="Yes", cancel="Cancel", extra=None):
    """'ok', 'extra' or None."""
    if GUI:
        args = ["--question", "--no-markup", f"--text={text}", f"--ok-label={ok}", f"--cancel-label={cancel}"]
        if extra:
            args.append(f"--extra-button={extra}")
        r = zenity(*args)
        if r.returncode == 0:
            return "ok"
        return "extra" if extra and r.stdout.strip() == extra else None
    print(text)
    choices = {"1": "ok"} | ({"2": "extra"} if extra else {})
    print(f"  1) {ok}" + (f"\n  2) {extra}" if extra else "") + f"\n  Enter) {cancel}")
    try:
        return choices.get(input("> ").strip())
    except EOFError:
        return None


def choose(text, columns, rows):
    """Pick one row; returns its index or None."""
    if not rows:
        return None
    if GUI:
        # column 1 (hidden) is what is printed back; column 2 is the number people see and can say ("number two")
        args = ["--list", f"--text={text}", "--height=420", "--print-column=1", "--hide-column=1",
                "--column=n", "--column=No.", *[f"--column={c}" for c in columns]]
        cells = []
        for i, row in enumerate(rows):
            cells += [str(i), str(i + 1), *row]
        r = zenity(*args, stdin="\n".join(cells) + "\n")
        out = r.stdout.strip().split("|")[0]
        return int(out) if r.returncode == 0 and out.isdigit() else None
    print(text)
    for i, row in enumerate(rows, 1):
        print(f"  {i}) " + "   ".join(row))
    try:
        n = input("> ").strip()
    except EOFError:
        return None
    return int(n) - 1 if n.isdigit() and 0 < int(n) <= len(rows) else None


CANCELLED = False      # set by run_steps when the person pressed Cancel
BUSY = CACHE / ".busy"   # what this run is doing, for a second window that has to wait for it


def busy(text):
    try:
        BUSY.write_text(text)
    except OSError:
        pass


def run_steps(text, steps, cancel=False):
    """Run steps one after another with a progress window, and True if all worked.

    Each step is (label, command) or just a command (then the window text is the label). The window shows the
    step's plain label, never the command's own output, which goes to the log. While a step runs, the label also
    says how long it has been going, once a minute. With cancel=True the window has a Cancel button, which stops
    the running command."""
    global CANCELLED
    CANCELLED = False
    steps = [st if isinstance(st, tuple) else (text, st) for st in steps]
    CACHE.mkdir(parents=True, exist_ok=True)
    if LOG.exists() and LOG.stat().st_size > 2_000_000:     # keep the log from growing without end
        LOG.write_bytes(LOG.read_bytes()[-500_000:])
    log = open(LOG, "a")
    log.write(f"\n=== {time.strftime('%Y-%m-%d %H:%M:%S')} {text}\n")
    busy(text)
    bar = None
    if GUI:
        mode = ["--pulsate"] if len(steps) == 1 else []
        bar = subprocess.Popen([DIALOG if cancel else "zenity", f"--title={TITLE}", "--width=520", "--progress",
                                *mode, "--auto-close",
                                *([] if cancel else ["--no-cancel"]), f"--text={html.escape(text)}"],
                               stdin=subprocess.PIPE, text=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        print(text)

    def show(*lines):
        if not bar:
            return
        try:
            bar.stdin.write("".join(l + "\n" for l in lines))
            bar.stdin.flush()
        except (BrokenPipeError, OSError):
            pass

    ok = True
    for i, (label, cmd) in enumerate(steps):
        show(*([str(int(100 * i / len(steps)))] if len(steps) > 1 else []), "# " + html.escape(label))
        if not bar:
            print("  " + label)
        log.write("$ " + " ".join(cmd) + "\n")
        log.flush()
        try:
            proc = subprocess.Popen(cmd, stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                    start_new_session=True)
        except OSError as e:
            log.write(f"{e}\n")
            ok = False
            break
        began, shown = time.time(), 0
        while proc.poll() is None:
            time.sleep(1)
            if bar and bar.poll() is not None:          # the window was closed: Cancel
                if cancel:
                    CANCELLED = True
                    try:
                        os.killpg(proc.pid, signal.SIGTERM)
                    except OSError:
                        pass
                    proc.wait()
                    break
                bar = None
            mins = int(time.time() - began) // 60
            if mins > shown:
                shown = mins
                show("# " + html.escape(f"{label}  ({mins} min so far)"))
        if CANCELLED or proc.returncode != 0:
            ok = False
            break
    log.close()
    if bar and bar.poll() is None:
        show("100")
        try:
            bar.stdin.close()
        except (BrokenPipeError, OSError):
            pass
        bar.wait()
    return ok


def log_tail(n=4000):
    try:
        with open(LOG, errors="replace") as f:
            text = f.read()
        return text[text.rfind("\n=== "):][-n:] if "\n=== " in text else text[-n:]
    except OSError:
        return ""


def explain(log):
    """The usual reasons an install fails, in plain words, or ''."""
    low = log.lower()
    m = re.search(r"nothing provides ([^\s]+)", low)
    if m:
        return (f"It needs {m.group(1)}, which Fedora {fedora_version()} does not have. "
                f"It may be made for a different Fedora version.")
    m = re.search(r"depends: ([^\s]+)[^\n]*but (it is not installable|it is not going to be installed|[^\n]*is to be "
                  r"installed)", low)
    if m or "unmet dependencies" in low:
        part = f"{m.group(1)}, which" if m else "parts that"
        return (f"It needs {part} the Ubuntu box (Ubuntu 24.04) does not have. "
                f"It may be made for a newer or older Ubuntu.")
    if "no space left on device" in low:
        return "The disk is full. Free some space, then try again."
    if re.search(r"could not resolve|temporary failure resolving|name or service not known|network is unreachable|"
                 r"connection timed out|curl error|failed to download|cannot download|tls handshake", low):
        return "It could not reach the internet. Check the connection, then try again."
    if re.search(r"conflicts with file from package|file [^\n]* conflicts", low):
        return "It would replace a file that belongs to the system, so it was not added."
    if re.search(r"different architecture|wrong architecture|incompatible architecture", low):
        return "It is made for a different kind of processor than this computer has."
    if re.search(r"not authorized|accessdenied|authentication (failed|dismissed)|request dismissed", low):
        return "The administrator password was not given, so nothing was changed."
    if re.search(r"no such container|error: container .* does not exist|cannot find container", low):
        return "The box is missing or broken."
    return ""


def failed(what, offer=None, reason=""):
    """Say that something did not work, in plain words when the reason is a usual one. offer: (button, action)."""
    log = log_tail()
    reason = reason or explain(log)
    if not reason:
        lines = [l for l in log.splitlines() if l.strip() and not l.startswith(("===", "$ "))]
        reason = "The last lines of the log:\n" + "\n".join(lines[-4:]) if lines else ""
    notify(f"{what} did not work.")
    text = f"{what} did not work.\n\n{reason}\n\nThe full details are in {LOG}"
    if offer:
        if ask(text, ok=offer[0], cancel="Close") == "ok":
            return offer[1]()
        return 1
    say(text, "error")
    return 1


# ---------------------------------------------------------------- records

def load():
    try:
        return json.loads(STATE.read_text())
    except (OSError, ValueError):
        return []


def save(records):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(records, indent=1))
    tmp.replace(STATE)


def remember(entry):
    records = [r for r in load() if not (r["package"] == entry["package"] and r["where"] == entry["where"])]
    save(records + [entry])


def forget(entry):
    save([r for r in load() if not (r["package"] == entry["package"] and r["where"] == entry["where"])])


# ---------------------------------------------------------------- boxes

def box_exists(name):
    return subprocess.run(["podman", "container", "exists", name], capture_output=True).returncode == 0


def in_box(box, *cmd):
    return ["distrobox", "enter", "-T", "-n", box, "--", *cmd]


def image_size(image):
    """Download size of a box image in MB: 0 if it is already on this computer, None if it cannot be found out."""
    if subprocess.run(["podman", "image", "exists", image], capture_output=True).returncode == 0:
        return 0
    reg, _, rest = image.partition("/")
    repo, _, tag = rest.rpartition(":")
    arch = {"x86_64": "amd64", "aarch64": "arm64"}.get(platform.machine(), platform.machine())
    lists = "application/vnd.oci.image.index.v1+json,application/vnd.docker.distribution.manifest.list.v2+json"
    single = "application/vnd.oci.image.manifest.v1+json,application/vnd.docker.distribution.manifest.v2+json"
    try:
        headers = {}
        if reg == "quay.io":
            url = f"https://quay.io/v2/auth?service=quay.io&scope=repository:{repo}:pull"
            headers["Authorization"] = "Bearer " + json.load(urllib.request.urlopen(url, timeout=6))["token"]

        def get(ref, accept):
            req = urllib.request.Request(f"https://{reg}/v2/{repo}/manifests/{ref}",
                                         headers={**headers, "Accept": accept})
            return json.load(urllib.request.urlopen(req, timeout=6))
        man = get(tag, lists + "," + single)
        if "manifests" in man:
            digest = next(m["digest"] for m in man["manifests"] if m.get("platform", {}).get("architecture") == arch)
            man = get(digest, single)
        return max(1, sum(l["size"] for l in man["layers"]) // 1_000_000)
    except Exception:
        return None


def human(mb):
    """'450 MB' or '1.2 GB'."""
    return f"{mb / 1000:.1f} GB" if mb >= 1000 else f"{max(1, int(mb))} MB"


def box_sizes(names):
    """Disk space each box uses in MB (its system plus what was installed in it), in one look; {} if not known
    quickly."""
    names = [n for n in names if box_exists(n)]
    if not names:
        return {}
    try:
        r = subprocess.run(["podman", "ps", "-a", "--size", "--format", "json",
                            *[f"--filter=name=^{n}$" for n in names]], capture_output=True, text=True, timeout=20)
        out = {}
        for c in json.loads(r.stdout):
            name = (c.get("Names") or [""])[0]
            size = c.get("Size") or {}
            out[name] = max(size.get("rootFsSize", 0), size.get("rwSize", 0)) // 1_000_000
        return out
    except (OSError, subprocess.TimeoutExpired, ValueError, AttributeError, TypeError):
        return {}


def box_size(name):
    return box_sizes([name]).get(name)


def sizes_line():
    """'Space used: Fedora box 1.2 GB, Ubuntu box 650 MB.' for the boxes that exist, or ''."""
    sizes = box_sizes([BOXES[k]["name"] for k in BOXES])
    parts = [f"{BOXES[k]['label']} {human(sizes[BOXES[k]['name']])}" for k in BOXES if sizes.get(BOXES[k]["name"])]
    return "Space used: " + ", ".join(parts) + "." if parts else ""


def free_mb():
    where = HOME / ".local/share/containers"
    try:
        return shutil.disk_usage(where if where.exists() else HOME).free // 1_000_000
    except OSError:
        return None


def room_for(what, need_mb):
    """Warn before starting when the disk is too full for it. True to go on."""
    free = free_mb()
    if free is None or free >= need_mb:
        return True
    return ask(f"Not enough free space. This needs about {human(need_mb)}, and {human(free)} is free.\n\n"
               f"Recommended: Cancel, then empty the Trash or remove apps you don't use, and try again.\n\n"
               f"Or Try anyway: if space runs out, it stops safely and nothing is lost.",
               ok="Try anyway", cancel="Cancel") == "ok"


def setup_need(size):
    """Disk space to set up a box: its download unpacks to about three times its size, plus room to work."""
    return (size or 400) * 3 + 1500


def delete_box(kind):
    """Delete an app box and its downloaded system, to free the space. Your own files are not touched."""
    box = BOXES[kind]
    ok = run_steps(f"Deleting the {box['label']}.", [["distrobox", "rm", "--force", box["name"]]])
    if ok:     # the box's system image too, unless something else still uses it
        subprocess.run(["podman", "image", "rm", box["image"]], capture_output=True)
        helpers_mark(kind).unlink(missing_ok=True)
    return ok


def box_words(kind):
    distro = "Fedora" if kind == "rpm" else "Ubuntu"
    return distro, ("a" if kind == "rpm" else "an"), BOXES[kind]["label"]


def first_time(kind):
    """What setting up the box takes, said before anything is downloaded, and the download size."""
    size = image_size(BOXES[kind]["image"])
    disk = f"uses about {human(setup_need(size) - 1500)} of disk space"
    text = f"First time only: sets up the box, which takes a minute or two and {disk}." if size == 0 \
        else f"First time only: downloads about {size} MB and {disk}." if size else \
        f"First time only: downloads a few hundred MB and {disk}."
    return text, size


# What apps from .rpm and .deb files expect from a desktop, and a fresh box does not have: zenity (Discord's
# first-run downloader shows its progress with it; without it there is no window at all) and notify-send.
# xdg-open is left out on purpose: Distrobox already sends it to the real desktop when the box has none.
HELPERS = {"rpm": ["zenity", "libnotify"], "deb": ["zenity", "libnotify-bin"]}
HELPER_CHECK = "command -v zenity >/dev/null && command -v notify-send >/dev/null"


def helpers_mark(kind):
    return STATE.with_name(f"helpers-{BOXES[kind]['name']}")


def helper_steps(kind):
    box = BOXES[kind]["name"]
    label = "Adding the desktop parts apps expect (progress windows and notifications)"
    if kind == "rpm":
        return [(label, in_box(box, "sudo", "dnf", "-y", "install", *HELPERS[kind]))]
    return [(label, in_box(box, "sh", "-c", "sudo apt-get update && sudo env DEBIAN_FRONTEND=noninteractive "
                                           "apt-get install -y " + " ".join(HELPERS[kind])))]


def ensure_helpers(kind, quiet=False):
    """Make sure the box has the desktop helpers. Done once per box; remembered after that."""
    mark = helpers_mark(kind)
    box = BOXES[kind]["name"]
    if mark.exists() or not box_exists(box):
        return True
    if subprocess.run(in_box(box, "sh", "-c", HELPER_CHECK), capture_output=True).returncode != 0:
        if quiet:
            ok = all(subprocess.run(cmd, capture_output=True).returncode == 0 for _, cmd in helper_steps(kind))
        else:
            ok = run_steps(f"Preparing the {BOXES[kind]['label']}.", helper_steps(kind))
        if not ok:
            return False
    mark.parent.mkdir(parents=True, exist_ok=True)
    mark.touch()
    return True


def setup_box(kind, size=None, again=False):
    """Make the box, with plain steps and a Cancel button. Cancel or failure leaves no half-made box."""
    distro, _, label = box_words(kind)
    box = BOXES[kind]
    steps = []
    if size != 0:
        about = f" (about {size} MB)" if size else ""
        steps.append((f"Downloading the {label}{about}", ["podman", "pull", box["image"]]))
    steps += [(f"Creating the {label}",
               ["distrobox", "create", "--yes", "--no-entry", "--name", box["name"], "--image", box["image"]]),
              (f"Getting the {label} ready. The first time takes a few minutes.", in_box(box["name"], "true"))]
    steps += helper_steps(kind)
    helpers_mark(kind).unlink(missing_ok=True)
    heading = f"Setting up the {label} again." if again else f"Setting up the {label}. This happens only once."
    # also as a notification, so it is seen even if the progress window opens behind another window
    notify(f"{heading} It takes a few minutes; a progress window shows each step.")
    if run_steps(heading, steps, cancel=True):
        helpers_mark(kind).parent.mkdir(parents=True, exist_ok=True)
        helpers_mark(kind).touch()
        return True
    subprocess.run(["distrobox", "rm", "--force", box["name"]], capture_output=True)
    if CANCELLED:
        say(f"Setting up the {label} was stopped. Nothing was installed.")
    else:
        failed(f"Setting up the {label}")
    return False


def box_works(name):
    try:
        return subprocess.run(in_box(name, "true"), capture_output=True, timeout=300).returncode == 0
    except subprocess.TimeoutExpired:
        return False


def repair(kind, why="", confirm=True):
    """Make a broken box again from scratch and put back the apps that were installed in it."""
    distro, _, label = box_words(kind)
    box = BOXES[kind]["name"]
    inside = [r for r in load() if r["where"] == box]
    names = ", ".join(r["title"] for r in inside) or "none"
    size = image_size(BOXES[kind]["image"])
    sz = "" if size == 0 or size is None else f" (downloads about {size} MB)"
    if confirm and ask(f"{why or f'The {label} is not working.'}\n\nRepair: rebuilds it{sz} and puts back its apps: "
                       f"{names}.\n\nYour files are not touched. Anything added to the box another way is not put "
                       f"back.", ok="Repair") != "ok":
        return 1
    for r in inside:
        unexport(r)
    subprocess.run(["distrobox", "rm", "--force", box], capture_output=True)
    if not setup_box(kind, size, again=True):
        return 1
    back, missing = [], []
    for r in inside:
        f = r.get("file")
        if not f or not Path(f).exists():
            missing.append(r["title"])
            forget(r)
            continue
        try:
            pkg = read_package(f)
        except (OSError, ValueError, tarfile.TarError, EOFError):
            missing.append(r["title"])
            forget(r)
            continue
        if box_install(pkg, classify(pkg), r["title"], quiet=True) == 0:
            if r.get("rules"):          # its hardware rule is still on the system; keep it on record for Remove Apps
                remember({**next(x for x in load() if x["package"] == r["package"] and x["where"] == box),
                          "rules": True})
            back.append(r["title"])
        else:
            missing.append(r["title"])
    text = f"The {label} is repaired."
    if back:
        text += "\n\nPut back: " + ", ".join(back) + "."
    if missing:
        text += "\n\nNot put back (open their files again to install them): " + ", ".join(missing) + "."
    notify(f"The {label} is repaired.")
    say(text)
    return 0


def repair_command(only_broken=False):
    """Repair an app box. only_broken (from System Update, when updating boxes failed): look first, and repair only
    a box that does not work."""
    kinds = [k for k in BOXES if box_exists(BOXES[k]["name"]) or any(r["where"] == BOXES[k]["name"] for r in load())]
    if not kinds:
        say("There are no app boxes to repair.")
        return 0
    if only_broken:
        broken = [k for k in kinds if not (box_exists(BOXES[k]["name"]) and box_works(BOXES[k]["name"]))]
        if not broken:
            say("Your app boxes are working. The box that did not update was made outside Install Package File, "
                "so Repair cannot fix it.")
            return 0
        kinds = broken
    if len(kinds) == 1:
        i = 0
    else:
        i = choose("Which box do you want to repair?", ["Box"], [[BOXES[k]["label"]] for k in kinds])
        if i is None:
            return 1
    label = BOXES[kinds[i]]["label"]
    return repair(kinds[i], why=f"Repair the {label}? Use this if apps in it no longer open or update.")


BOX_RUN = "/usr/libexec/easyspeak-os-box-run"
QUIT = "easyspeak-quit"


def fix_launcher(path):
    """Make an app grid entry made by distrobox-export start the app through easyspeak-os-box-run, so the app's
    messages go to a log file (an app does not crash if its link to the desktop goes away) and a right-click Quit
    really stops it inside the box. Safe to run more than once."""
    try:
        text = path.read_text()
    except OSError:
        return False
    if BOX_RUN in text:
        return True
    key = ""

    def swap(m):
        nonlocal key
        rest = m.group(2).strip()
        try:
            first = shlex.split(rest)[0]
        except (ValueError, IndexError):
            return m.group(0)
        key = key or os.path.basename(first)
        return f"Exec={BOX_RUN} {m.group(1)} {rest}"
    text = re.sub(r"(?m)^Exec=\S*distrobox-enter\s+-n\s+(\S+)\s+(?:\S+\s+)*?--\s+(.*)$", swap, text)
    text = re.sub(r"(?m)^StartupWMClass=/.*\n?", "", text)
    if not key:
        return False
    name = re.search(r"(?m)^Name=(.*)$", text)
    head, sep, rest = text.partition("[Desktop Entry]\n")
    if re.search(r"(?m)^Actions=", rest.split("\n[", 1)[0]):
        rest = re.sub(r"(?m)^(Actions=[^\n]*?);?[ \t]*$", lambda m: f"{m.group(1)};{QUIT};", rest, count=1)
    else:
        rest = f"Actions={QUIT};\n" + rest
    text = head + sep + rest.rstrip("\n") + (
        f"\n\n[Desktop Action {QUIT}]\nName=Quit {name.group(1) if name else key}\n"
        f"Exec={BOX_RUN} --stop {key}\n")
    path.write_text(text)
    return True


def launchers_to_fix():
    apps_dir = HOME / ".local/share/applications"
    out = []
    for r in load():
        if r["where"] in WHERE and r["where"].startswith("easyspeak-"):
            for a in r.get("apps", []):
                f = apps_dir / f"{r['where']}-{os.path.basename(a)}"
                try:
                    if f.exists() and BOX_RUN not in f.read_text():
                        out.append(f)
                except OSError:
                    pass
    return out


def export(box, info):
    """Put the package's apps in the app grid, or its commands on the PATH. Returns what was exported."""
    apps_dir = HOME / ".local/share/applications"
    done_apps, done_bins = [], []
    for path in info["apps"]:
        r = subprocess.run(in_box(box, "distrobox-export", "--app", path, "--export-label", "none"),
                           capture_output=True, text=True)
        exported = apps_dir / f"{box}-{os.path.basename(path)}"
        if r.returncode == 0 and exported.exists():
            fix_launcher(exported)
            done_apps.append(path)
    if done_apps:
        icons_changed()
    if not done_apps:
        bindir = HOME / ".local/bin"
        bindir.mkdir(parents=True, exist_ok=True)
        for b in info["bins"]:
            r = subprocess.run(in_box(box, "distrobox-export", "--bin", b, "--export-path", str(bindir)),
                               capture_output=True, text=True)
            if r.returncode == 0:
                done_bins.append(b)
    return done_apps, done_bins


def icons_changed():
    """Make GNOME look at the app icons again. An app's icon is copied into ~/.local/share/icons, often into folders
    that did not exist when GNOME last looked; GNOME only sees them after the icon folder's date changes, so without
    this the app shows a generic icon until the next login."""
    for d in (HOME / ".local/share/icons/hicolor", HOME / ".local/share/icons"):
        if d.is_dir():
            try:
                os.utime(d)
            except OSError:
                pass


def unexport(entry):
    box = entry["where"]
    apps_dir = HOME / ".local/share/applications"
    for path in entry.get("apps", []):        # quit the app first if it is running
        try:
            m = re.search(r"--stop (\S+)", (apps_dir / f"{box}-{os.path.basename(path)}").read_text())
        except OSError:
            m = None
        if m and os.access(BOX_RUN, os.X_OK):
            subprocess.run([BOX_RUN, "--stop", m.group(1)], capture_output=True,
                           env={**os.environ, "EASYSPEAK_QUIET": "1"})
    set_login(entry, False)
    for path in entry.get("apps", []):
        if box_exists(box):
            subprocess.run(in_box(box, "distrobox-export", "--app", path, "--delete"), capture_output=True)
        (apps_dir / f"{box}-{os.path.basename(path)}").unlink(missing_ok=True)
    for b in entry.get("bins", []):
        if box_exists(box):
            subprocess.run(in_box(box, "distrobox-export", "--bin", b, "--export-path", str(HOME / ".local/bin"),
                                  "--delete"), capture_output=True)
        (HOME / ".local/bin" / os.path.basename(b)).unlink(missing_ok=True)
    if entry.get("apps"):
        icons_changed()


# ---------------------------------------------------------------- start at login

AUTOSTART = HOME / ".config/autostart"


def launcher(entry, app):
    return HOME / ".local/share/applications" / f"{entry['where']}-{os.path.basename(app)}"


def login_file(entry, app):
    return AUTOSTART / f"easyspeak-os-{entry['where']}-{os.path.basename(app)}"


def starts_at_login(entry):
    return any(login_file(entry, a).exists() for a in entry.get("apps", []))


def set_login(entry, on):
    """Start a box app when you log in, or stop doing so: a copy of its app grid entry in ~/.config/autostart
    (it starts the app the same way, through easyspeak-os-box-run). True if it worked."""
    done = False
    for a in entry.get("apps", []):
        f = login_file(entry, a)
        if not on:
            f.unlink(missing_ok=True)
            done = True
            continue
        try:
            text = launcher(entry, a).read_text()
        except OSError:
            continue
        text = re.sub(r"(?m)^(X-GNOME-Autostart-[^=]*|Hidden|NoDisplay)=.*\n?", "", text)
        head, sep, rest = text.partition("[Desktop Entry]\n")
        AUTOSTART.mkdir(parents=True, exist_ok=True)
        f.write_text(head + sep + "X-GNOME-Autostart-enabled=true\n" + rest)
        done = True
        break                       # the app's main entry is enough
    return done


def login():
    """Start Apps at Login: choose box apps that start by themselves when you log in."""
    apps = [r for r in load() if r["where"].startswith("easyspeak-") and r.get("apps")]
    if not apps:
        say("No downloaded apps that can start at login are installed. Apps from the Software app have this "
            "setting inside the app.")
        return 0
    rows = [[r["title"], WHERE.get(r["where"], r["where"]), "Yes" if starts_at_login(r) else "No"] for r in apps]
    i = choose("Which app should start, or stop starting, when you log in?",
               ["App", "Installed in", "Starts at login"], rows)
    if i is None:
        return 1
    entry = apps[i]
    on = not starts_at_login(entry)
    if not set_login(entry, on):
        failed(f"Changing {entry['title']}", reason=f"{entry['title']} is missing from Show Apps. "
                                                    f"Install it again to put it back.")
        return 1
    say(f"{entry['title']} will start when you log in." if on else
        f"{entry['title']} will no longer start when you log in.")
    return 0


LOGIN_CHECKED = STATE.with_name("login-entries-checked.json")


def login_checked(save=None):
    """Login entries already looked at and not from a box: {path: modified time}, so boxes are not started at
    every login to look again."""
    if save is not None:
        LOGIN_CHECKED.parent.mkdir(parents=True, exist_ok=True)
        LOGIN_CHECKED.write_text(json.dumps(save))
        return save
    try:
        return json.loads(LOGIN_CHECKED.read_text())
    except (OSError, ValueError):
        return {}


def unchecked(f, checked):
    try:
        return checked.get(str(f)) != f.stat().st_mtime
    except OSError:
        return False


def fix_app_login_files():
    """Some apps have their own "open at login" setting (Discord has). In a box, that setting writes a login entry
    that starts the app by its path inside the box, which does not exist on the system, so at login nothing
    happens. At login, point such entries at the box, and start the app this time. Returns how many were fixed."""
    fixed = 0
    by_box = {}
    for r in load():
        if r["where"].startswith("easyspeak-") and r.get("apps"):
            by_box.setdefault(r["where"], []).append(r)
    if not by_box or not AUTOSTART.is_dir():
        return 0
    checked = login_checked()
    for f in sorted(AUTOSTART.glob("*.desktop")):
        if f.name.startswith("easyspeak-os-") or not unchecked(f, checked):
            continue
        try:
            text = f.read_text()
        except OSError:
            continue
        if BOX_RUN in text or re.search(r"(?m)^(Hidden=true|X-GNOME-Autostart-enabled=false)$", text):
            continue        # already fixed, or switched off
        m = re.search(r"(?m)^Exec=(.*)$", text)
        try:
            first = shlex.split(m.group(1))[0] if m else ""
        except (ValueError, IndexError):
            continue
        if not first.startswith("/") or os.path.exists(first):
            continue
        box = next((b for b in by_box if box_exists(b) and subprocess.run(
            in_box(b, "test", "-x", first), capture_output=True).returncode == 0), None)
        if not box:
            checked[str(f)] = f.stat().st_mtime         # not from a box: do not look again until it changes
            login_checked(checked)
            continue
        new = text.replace(m.group(0), f"Exec={BOX_RUN} {box} {m.group(1).strip()}", 1)
        f.write_text(new)
        fixed += 1
        if not app_running(os.path.basename(first)):
            subprocess.Popen(["gio", "launch", str(f)], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return fixed


def app_running(key):
    state = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "easyspeak-os-box-apps"
    for pidf in state.glob(f"{key}.*.pid"):
        try:
            os.kill(int(pidf.read_text().strip()), 0)
            return True
        except (OSError, ValueError):
            continue
    return False


def app_login_files_to_fix():
    """Cheap test for login: are there login entries pointing at a path the system does not have?"""
    if not AUTOSTART.is_dir() or not any(r["where"].startswith("easyspeak-") for r in load()):
        return False
    checked = login_checked()
    for f in AUTOSTART.glob("*.desktop"):
        if f.name.startswith("easyspeak-os-") or not unchecked(f, checked):
            continue
        try:
            m = re.search(r"(?m)^Exec=(\S+)", f.read_text())
        except OSError:
            continue
        if m and m.group(1).startswith("/") and BOX_RUN not in m.group(1) and not os.path.exists(m.group(1)):
            return True
    return False


# ---------------------------------------------------------------- hardware rules

def box_rules(box):
    """Hardware rule files in a box, by file name."""
    r = subprocess.run(in_box(box, "sh", "-c", "ls /usr/lib/udev/rules.d /etc/udev/rules.d 2>/dev/null"),
                       capture_output=True, text=True)
    return {l.strip() for l in r.stdout.splitlines() if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+-]*\.rules", l.strip())}


def new_box_rules(box, before, info):
    """Rules that the install added through other packages it pulled in (Fedora's solaar pulls in
    solaar-udev, for example), and that the system does not have yet. Added to info like the file's own."""
    host = {p.name for d in ("/usr/lib/udev/rules.d", "/etc/udev/rules.d") for p in Path(d).glob("*.rules")}
    own = {os.path.basename(p) for p in info["safe_rules"]}
    for name in sorted(box_rules(box) - before - host - own):
        r = subprocess.run(in_box(box, "sh", "-c", f"cat /etc/udev/rules.d/{name} 2>/dev/null || "
                                  f"cat /usr/lib/udev/rules.d/{name}"), capture_output=True, text=True)
        if r.returncode != 0 or not r.stdout.strip():
            continue
        if rule_runs_program(r.stdout):
            if "a hardware rule that runs a program" not in info["notes"]:
                info["notes"].append("a hardware rule that runs a program")
        else:
            info["safe_rules"]["/usr/lib/udev/rules.d/" + name] = r.stdout


