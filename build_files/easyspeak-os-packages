def check(path):
    pkg = read_package(path)
    info = classify(pkg)
    print(json.dumps({"kind": pkg.kind, "name": pkg.name, "version": pkg.version, "title": info["title"],
                      "apps": list(info["apps"]), "bins": info["bins"], "rules": list(info["safe_rules"]),
                      "rules_only": info["rules_only"], "source_only": info["source_only"], "needs_root": info["needs_root"],
                      "sources": [n for _, n, on in info["sources"] if on], "needs_system": info["blocking"],
                      "wont_work_in_box": info["notes"]}, indent=1))
    return 0


def take_lock(lock, quiet=False):
    """Only one install, removal or repair at a time. If another is running, say which, wait for it to finish
    (with Cancel), then go on. True when this run may go on."""
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return True
    except OSError:
        pass
    if quiet:           # the login task: leave it for the next login rather than wait in the background
        return False
    if not GUI:
        print(f"Waiting for the other install or removal to finish ({doing_now()}).")
        fcntl.flock(lock, fcntl.LOCK_EX)
        return True
    text = waiting_text(doing_now())
    bar = subprocess.Popen([DIALOG, f"--title={TITLE}", "--width=520", "--progress", "--pulsate", "--auto-close",
                            f"--text={html.escape(text)}"], stdin=subprocess.PIPE, text=True,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    shown = None
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            got = True
        except OSError:
            got = False
        if got or bar.poll() is not None:
            break
        now = doing_now()
        if now != shown:
            shown = now
            try:
                bar.stdin.write("# " + html.escape(waiting_text(now)) + "\n")
                bar.stdin.flush()
            except (BrokenPipeError, OSError):
                pass
        time.sleep(1)
    if bar.poll() is None:
        try:
            bar.stdin.write("100\n")
            bar.stdin.close()
        except (BrokenPipeError, OSError):
            pass
        bar.wait()
    return got


def waiting_text(now):
    """One line: a progress window's text update ends at the line's end, so a second line would be dropped."""
    return f"Another install or removal is running ({now.rstrip('.')}). This waits for it to finish, then goes on."


def doing_now():
    try:
        return BUSY.read_text().strip() or "Install Package File"
    except OSError:
        return "Install Package File"


def main(argv):
    if len(argv) < 2 or argv[1] not in ("install", "remove", "check", "after-restart", "repair", "login") or \
            (argv[1] == "check" and len(argv) < 3):
        print(__doc__.split("\n\n")[1])
        return 2
    if argv[1] == "check":
        return check(argv[2])
    if argv[1] == "after-restart" and not pending() and not boxes_missing_helpers() and not launchers_to_fix() \
            and not app_login_files_to_fix():
        return 0
    global TITLE        # each window carries the name of what it is part of
    TITLE = {"remove": "Remove Apps", "repair": "Repair App Boxes", "login": "Start Apps at Login"}.get(argv[1], TITLE)
    CACHE.mkdir(parents=True, exist_ok=True)
    lock = open(CACHE / ".lock", "w")
    if not take_lock(lock, quiet=argv[1] == "after-restart"):
        return 1
    busy({"install": "Install Package File is open", "remove": "Remove Apps is open",
          "repair": "Repair App Boxes is open", "login": "Start Apps at Login is open"}.get(argv[1], "Starting"))
    if argv[1] == "after-restart":
        return after_restart()
    if argv[1] == "repair":
        return repair_command(only_broken="--if-broken" in argv)
    if argv[1] == "install":
        return install(argv[2] if len(argv) > 2 else None)
    if argv[1] == "login":
        return login()
    return remove()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
