def boxes_missing_helpers():
    return [k for k in BOXES if box_exists(BOXES[k]["name"]) and not helpers_mark(k).exists()]


def after_restart():
    """Run at login. Give boxes made before the desktop helpers were part of the setup those helpers, quietly and
    once. Then, for each package added to the system, say whether it is there now, once."""
    for k in boxes_missing_helpers():
        ensure_helpers(k, quiet=True)
    for f in launchers_to_fix():           # app grid entries made before easyspeak-os-box-run existed
        fix_launcher(f)
    left = []
    for e in pending():
        have = host_version(e["package"])
        if have and (not e.get("version") or have == e["version"]):
            if e.get("printer"):
                notify(f"The printer driver {e['title']} is ready.")
                if ask(f"The printer driver {e['title']} is ready.\n\nAdd your printer now? In Printers, choose "
                       f"Add Printer, then pick your printer.", ok="Open Printers", cancel="Later") == "ok":
                    open_printers()
            else:
                notify(f"{e['title']} is now on the system.")
                say(f"{e['title']} is now on the system.")
        elif staged_system():
            left.append(e)          # added, but this computer has not restarted into it yet
        else:
            notify(f"{e['title']} was not added to the system.")
            say(f"{e['title']} is not on the system. Adding it may have been undone, or the system started from an "
                f"older version. Open the file again to add it.", "warning")
    pending(left)
    return 0


# ---------------------------------------------------------------- already installed?

def box_version(kind, name):
    """Version of a package in its box ('' if not installed there, or no box)."""
    box = BOXES[kind]["name"]
    if not box_exists(box):
        return ""
    if kind == "rpm":
        cmd = f"rpm -q --qf '%{{EPOCHNUM}}:%{{VERSION}}-%{{RELEASE}}' {shlex.quote(name)}"
    else:
        cmd = f"dpkg-query -W -f='${{db:Status-Status}} ${{Version}}' {shlex.quote(name)}"
    r = subprocess.run(in_box(box, "sh", "-c", cmd), capture_output=True, text=True)
    out = r.stdout.strip()
    if r.returncode != 0 or not out:
        return ""
    if kind == "deb":
        state, _, ver = out.partition(" ")
        return ver if state == "installed" else ""
    return out


def host_version(name):
    r = subprocess.run(["rpm", "-q", "--qf", "%{EPOCHNUM}:%{VERSION}-%{RELEASE}", name], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def compare(kind, a, b):
    """-1, 0 or 1 as version a is older, the same or newer than b."""
    if a == b:
        return 0
    if kind == "rpm":
        lua = f"%{{lua: print(rpm.vercmp('{a}', '{b}'))}}"
        r = subprocess.run(["rpm", "--eval", lua], capture_output=True, text=True)
        try:
            return max(-1, min(1, int(r.stdout.strip())))
        except ValueError:
            return 0
    box = BOXES["deb"]["name"]
    for op, res in (("lt", -1), ("gt", 1)):
        if subprocess.run(in_box(box, "dpkg", "--compare-versions", a, op, b), capture_output=True).returncode == 0:
            return res
    return 0


def plain_version(v):
    """Version without the leading epoch and release noise people do not need to see ('0:1.2-3' -> '1.2-3')."""
    return re.sub(r"^\d+:", "", v)


def flatpak_installed(app_id):
