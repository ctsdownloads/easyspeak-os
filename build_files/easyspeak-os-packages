    return 0


# ---------------------------------------------------------------- already installed?

def box_version(kind, name):
    """Version of a package in its box ('' if not installed there, or no box)."""
    box = BOXES[kind]["name"]
    if not box_exists(box):
        return ""
    if kind == "rpm":
        cmd = f"rpm -q --qf '%{{EPOCHNUM}}:%{{VERSION}}-%{{RELEASE}}' {shlex.quote(name)}"
    else:
        cmd = f"dpkg-query -W -f='${{db:Status-Status}} ${{Version}}' {shlex.quote(name)}"
    r = subprocess.run(in_box(box, "sh", "-c", cmd), capture_output=True, text=True)
    out = r.stdout.strip()
    if r.returncode != 0 or not out:
        return ""
    if kind == "deb":
        state, _, ver = out.partition(" ")
        return ver if state == "installed" else ""
    return out


def host_version(name):
    r = subprocess.run(["rpm", "-q", "--qf", "%{EPOCHNUM}:%{VERSION}-%{RELEASE}", name], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def compare(kind, a, b):
    """-1, 0 or 1 as version a is older, the same or newer than b."""
    if a == b:
        return 0
    if kind == "rpm":
        lua = f"%{{lua: print(rpm.vercmp('{a}', '{b}'))}}"
        r = subprocess.run(["rpm", "--eval", lua], capture_output=True, text=True)
        try:
            return max(-1, min(1, int(r.stdout.strip())))
        except ValueError:
            return 0
    box = BOXES["deb"]["name"]
    for op, res in (("lt", -1), ("gt", 1)):
        if subprocess.run(in_box(box, "dpkg", "--compare-versions", a, op, b), capture_output=True).returncode == 0:
            return res
    return 0


def plain_version(v):
    """Version without the leading epoch and release noise people do not need to see ('0:1.2-3' -> '1.2-3')."""
    return re.sub(r"^\d+:", "", v)


def flatpak_installed(app_id):
    return bool(app_id) and subprocess.run(["flatpak", "info", app_id], capture_output=True).returncode == 0


def norm_name(s):
    return re.sub(r"[^a-z0-9]", "", (s or "").lower())


def open_app(entry):
    """Start an installed app the way its app grid entry does."""
    try:
        if entry["where"] == "flathub":
            subprocess.Popen(["flatpak", "run", entry["package"]], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
        for a in entry.get("apps", []):
            f = HOME / ".local/share/applications" / f"{entry['where']}-{os.path.basename(a)}"
            if f.exists():
                subprocess.Popen(["gio", "launch", str(f)], start_new_session=True,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return True
    except OSError:
        pass
    return False


def already_installed(pkg, info, title):
    """Check whether this app is installed already, and ask what to do. Returns (go_on, mode, exit code):
    mode is 'install', 'reinstall', 'update' or 'older' when going on."""
    records = load()
    ours = BOXES[pkg.kind]["name"]

    # 1. On the system itself
    hv = host_version(pkg.name) if pkg.kind == "rpm" else ""
    if hv:
        mine = next((r for r in records if r["where"] == "system" and r["package"] == pkg.name), None)
        if not mine:
            say(f"{title} is already part of EasySpeak-OS. Nothing to install.")
            return False, "", 0
        if mine.get("from_fedora"):
            say(f"{title} is already installed from Fedora and stays up to date. You don't need this file.")
            return False, "", 0
        c = compare("rpm", pkg.evr, hv)
        if c <= 0:
            say(f"{title} is already installed. "
                f"{'This file is the same version.' if c == 0 else 'This file is older than the one installed.'}")
            return False, "", 0
        if ask(f"Update {title} to the newer version in this file?\n\nNeeds your password and a restart.",
               ok="Update") != "ok":
            return False, "", 1
        return True, "system-update", 0

    # 2. In its box
    bv = box_version(pkg.kind, pkg.name)
    if bv:
        mine = next((r for r in records if r["where"] == ours and r["package"] == pkg.name),
                    {"title": title, "where": ours, "apps": list(info["apps"])})
        c = compare(pkg.kind, pkg.evr, bv)
        if c == 0:
            a = ask(f"{title} is already installed.\n\nRecommended: Open it.\n\nOr Reinstall: installs it again from "
                    f"this file. Only needed if it isn't working.", ok="Open it", extra="Reinstall")
            if a == "ok":
                if not open_app(mine):
                    say(f"{title} has no window to open. It is a tool other apps use.")
                return False, "", 0
            return (True, "reinstall", 0) if a == "extra" else (False, "", 1)
        if c > 0:
            if ask(f"Update {title} to the newer version in this file?", ok="Update") != "ok":
                return False, "", 1
            return True, "update", 0
        if ask(f"This file is an older version of {title} than the one you have.\n\nInstall the older version: "
               f"replaces yours. Only do this if the newer one has a problem.", ok="Install the older version") != "ok":
            return False, "", 1
        return True, "older", 0

    # 3. From Flathub, or 4. in the other box (same app name)
    want = {norm_name(title), norm_name(pkg.name)}
    for r in records:
        if r["where"] == "flathub" and (norm_name(r["title"]) in want) and flatpak_installed(r["package"]):
            a = ask(f"{r['title']} is already installed from the Software app.\n\nRecommended: Open it.\n\n"
                    f"Or Install the file too: adds a second copy, which never updates. You would have two of the "
                    f"same app.", ok="Open it", extra="Install the file too")
            if a == "ok":
                open_app(r)
                return False, "", 0
            return (True, "install", 0) if a == "extra" else (False, "", 1)
        if r["where"] in (BOXES["rpm"]["name"], BOXES["deb"]["name"]) and r["where"] != ours and \
                norm_name(r["title"]) in want:
            other = WHERE.get(r["where"], r["where"])
            a = ask(f"{r['title']} is already installed from {'an .rpm' if 'Fedora' in other else 'a .deb'} file.\n\n"
                    f"Recommended: Open it.\n\nOr Install it here too: adds a second copy, which never updates. You "
                    f"would have two of the same app.", ok="Open it", extra="Install it here too")
            if a == "ok":
                open_app(r)
                return False, "", 0
            return (True, "install", 0) if a == "extra" else (False, "", 1)
    return True, "install", 0


# ---------------------------------------------------------------- install

def plain_list(items):
    return "\n".join("  - " + i for i in items)


def pick_file():
    found = []
    for d in (HOME / "Downloads", HOME / "Desktop", HOME):
        if d.is_dir():
            found += [p for p in d.iterdir() if p.is_file() and p.suffix.lower() in (".rpm", ".deb")]
    found = sorted(set(found), key=lambda p: p.stat().st_mtime, reverse=True)[:30]
    rows = [[p.name, str(p.parent).replace(str(HOME), "~", 1)] for p in found]
    if not rows:
        if GUI:
            r = zenity("--file-selection", "--file-filter=Packages (.rpm, .deb) | *.rpm *.deb")
            return r.stdout.strip() if r.returncode == 0 else None
        say("No .rpm or .deb files in Downloads. Give the file's path:  easyspeak-os-packages install FILE")
        return None
    i = choose("Which file do you want to install?", ["File", "Folder"], rows)
    return str(found[i]) if i is not None else None


def install(path):
    if not path:
        path = pick_file()
        if not path:
            return 1
    path = os.path.abspath(path)
    try:
        pkg = read_package(path)
    except (OSError, ValueError, tarfile.TarError, EOFError) as e:
        say(f"This file can't be installed. It may be damaged or not fully downloaded. Download it again and "
            f"retry.\n\n(Details: {e})", "error")
        return 1
    info = classify(pkg)
    title = info["title"]

    machine = platform.machine()
    fits = {"x86_64": {"rpm": {"x86_64", "noarch", "i686"}, "deb": {"amd64", "all"}},
            "aarch64": {"rpm": {"aarch64", "noarch"}, "deb": {"arm64", "all"}}}.get(machine, {})
    if fits and pkg.arch not in fits[pkg.kind]:
        if pkg.arch in ("i386", "i686"):
            say(f"This is the 32-bit version of {title}, for older computers. Download the 64-bit version instead "
                f"(often called amd64 or x86_64).", "warning")
        else:
            say(f"This {title} file is for a different kind of computer. Download the version for this one "
                f"(often called {'amd64 or x86_64' if machine == 'x86_64' else machine}).", "warning")
        return 1

    if info["needs_root"]:
        say(f"{title} can't be installed. It needs full control of the system to run, which downloaded apps don't "
            f"get here.\n\nNothing was installed.", "warning")
        return 1

    if info["source_only"]:        # (opened again: offers its apps again, rather than "already installed")
        return install_source(pkg, info)

    go_on, mode, code = already_installed(pkg, info, title)
    if not go_on:
        return code
    if mode == "system-update":
        return install_system(pkg, title, "a printer driver" in info["blocking"], update=True)
    if mode != "install":
        return box_install(pkg, info, title, mode=mode)

    # (not for an app just chosen from a download source: the person picked that source on purpose)
    match = None if info["rules_only"] or pkg.name in SOURCED else flathub_match(pkg, info)
    if match and flatpak_installed(match[0]):
        app_id, name = match
        a = ask(f"{name} is already installed from the Software app.\n\nRecommended: Open it.\n\n"
                f"Or Install the file too: adds a second copy, which never updates. You would have two of the same "
                f"app.", ok="Open it", extra="Install the file too")
        if a == "ok":
            open_app({"where": "flathub", "package": app_id})
            return 0
        if a != "extra":
            return 1
        match = None
    if match:
        app_id, name = match
        answer = ask(f"{name} is in the Software app (Flathub).\n\nRecommended: Use Flathub. It updates by itself "
                     f"and is made for this kind of system.\n\nOr Use the file: installs your download. It never "
                     f"updates.",
                     ok="Use Flathub", cancel="Cancel", extra="Use the file")
        if answer is None:
            return 1
        if answer == "ok":
            if run_steps(f"Installing {name} from Flathub.",
                         [["flatpak", "install", "-y", "--noninteractive", "flathub", app_id]]):
                remember({"title": name, "package": app_id, "where": "flathub"})
                notify(f"{name} is installed.")
                say(f"{name} is installed. Find it in Show Apps.\n\n{UPDATES_FLATHUB}")
                return 0
            failed(f"Installing {name}")
            return 1

    if info["rules_only"]:
        if ask(f"{title} only lets your account use a device.\n\nAdd it: needs your password.", ok="Add it") != "ok":
            return 1
        ok, out = add_rules(pkg, info)
        if not ok:
            say(f"The device rule wasn't added, so the device may not work.\n\n{out}", "error")
            return 1
        remember({"title": title, "package": pkg.name, "where": "rules", "rules": True})
        notify(f"{title} is installed.")
        say(f"{title} is installed. Unplug the device and plug it back in.")
        return 0

    if info["blocking"]:
        reasons = plain_list(info["blocking"])
        printer = "a printer driver" in info["blocking"]
        if printer:
            choice = try_driverless(title, pkg.kind)
            if choice != "driver":
                return 0 if choice == "printers" else 1
        if pkg.kind == "deb" and printer:
            who = maker(pkg)
            site = f"{who}'s support site" if who else "the printer maker's support site"
            if ask(f"{title} is a printer driver made for Ubuntu and Debian (.deb). This system takes printer drivers "
                   f"only as .rpm files.\n\nWhat to do:\n  1. Go to {site} and find the driver for your printer.\n"
                   f"  2. When it asks for your system, choose the .rpm version (it may be called Fedora, Red Hat or "
                   f"RPM).\n  3. Open that .rpm file here.\n\nOr try your printer without a driver first.",
                   ok="Open Printers", cancel="Close") == "ok":
                open_printers()
            return 1
        if pkg.kind == "deb":
            say(f"{title} can't be installed from this file. It has:\n{reasons}\n\n"
                f"These have to go on the system, and the system only takes .rpm files. "
                f"Look for {title} as an .rpm for Fedora {fedora_version()}, or in the Software app.", "warning")
            return 1
        if ask(f"{title} has to go on the system. It has:\n{reasons}\nThese can't work in a box.\n\n"
               f"Add to the system: everything works. Needs your password and a restart. You can remove it any time "
               f"with Remove Apps.",
               ok="Add to the system") != "ok":
            return 1
        return install_system(pkg, title, printer)

    box = BOXES[pkg.kind]
    new_box = not box_exists(box["name"])
    size, first = None, ""
    if new_box:
        first, size = first_time(pkg.kind)
        first = " " + first
    setup = "Set up and install" if new_box else "Install"
    rule = "\n\nIt also has a device rule. That goes on the system, so you will be asked for your password." \
        if info["safe_rules"] else ""
    if info["notes"] and pkg.kind == "rpm":
        # parts of it would not work in a box: the system is the recommended choice
        answer = ask(f"Install {title}\n\nRecommended: Add to the system. In a box, these parts of {title} won't "
                     f"work:\n{plain_list(info['notes'])}\nOn the system, everything works. Needs your password and a "
                     f"restart.\n\nOr {setup}: puts it in a separate box. It's easier to remove, but those parts won't "
                     f"work.{first}{rule}", ok="Add to the system", extra=setup)
        if answer == "ok":
            return install_system(pkg, title)
        if answer != "extra":
            return 1
    elif info["notes"]:
        # a .deb cannot go on the system: the box is the only choice, said plainly
        if ask(f"Install {title}\n\nIn a box, these parts of {title} won't work:\n{plain_list(info['notes'])}\n"
               f"A .deb file can't go on the system. For everything to work, look for {title} as an .rpm file or in "
               f"the Software app.\n\n{setup}: puts it in a box anyway, without those parts.{first}{rule}",
               ok=setup) != "ok":
            return 1
    elif ask(f"Install {title}\n\n{setup}: puts it in a separate box. Your system isn't changed, and Remove Apps "
             f"takes it out cleanly.{first}{rule}", ok=setup) != "ok":
        return 1
    file_mb = pkg.path.stat().st_size // 1_000_000
    if new_box:
        if not room_for(f"Setting up the {box['label']} and installing {title}", setup_need(size) + 3 * file_mb):
            return 1
        if not setup_box(pkg.kind, size):
            return 1
    elif not room_for(f"Installing {title}", 3 * file_mb + 500):
        return 1
    return box_install(pkg, info, title)


# ---------------------------------------------------------------- packages that only add a download source

SOURCED = set()      # packages installed from a download source in this run: System Update keeps them current
FROM_SOURCE = CACHE / "from-source"


def source_packages(kind, box, sources):
    """[(package, summary)] offered by the download sources the box just got."""
    if kind == "rpm":
        ids = [i for i, _, on in sources if on]
        r = subprocess.run(in_box(box, "dnf", "-q", "repoquery", "--repo=" + ",".join(ids), "--latest-limit=1",
                                  f"--arch={platform.machine()},noarch", "--queryformat=%{name}\t%{summary}\n"),
                           capture_output=True, text=True)
        rows = [l.split("\t", 1) for l in r.stdout.splitlines() if "\t" in l]
    else:
        # Ubuntu names each source's list after its address: packages.microsoft.com/ubuntu/24.04/prod ->
        # packages.microsoft.com_ubuntu_24.04_prod_dists_..._Packages
        # The lists are kept compressed (.lz4), one per kind of processor; only this computer's and "all" are wanted
        marks = [re.sub(r"^\w+://", "", url).rstrip("/").replace("/", "_") + "_" for url, _, on in sources if on]
        arch = {"x86_64": "amd64", "aarch64": "arm64"}.get(platform.machine(), platform.machine())
        new = [f for f in apt_lists(box) if any(os.path.basename(f).startswith(m) for m in marks) and
               re.search(rf"_binary-({arch}|all)_Packages(\.\w+)?$", f)]
        rows, name = [], None
        if new:
            r = subprocess.run(in_box(box, "sh", "-c", "for f in " + " ".join(shlex.quote(f) for f in new) +
                                      "; do /usr/lib/apt/apt-helper cat-file \"$f\"; done | "
                                      "grep -E '^(Package|Description):'"), capture_output=True, text=True)
            for line in r.stdout.splitlines():
                if line.startswith("Package:"):
                    name = line.split(":", 1)[1].strip()
                    rows.append([name, ""])
                elif line.startswith("Description:") and rows and not rows[-1][1]:
                    rows[-1][1] = line.split(":", 1)[1].strip()
    seen, out = set(), []
    for n, summary in sorted(rows, key=lambda r: r[0].lower()):
        n = n.strip()
        if n and n not in seen and not re.search(r"-(devel|dev|debuginfo|debugsource|dbg|doc|docs)$", n):
            seen.add(n)
            out.append((n, summary.strip()))
    return out


def apt_lists(box):
    r = subprocess.run(in_box(box, "sh", "-c", "ls -d /var/lib/apt/lists/*_Packages* 2>/dev/null"),
                       capture_output=True, text=True)
    return r.stdout.split()


def install_source(pkg, info):
    """A package with no app, only a download source (a repository): add the source to the box, then pick an app
    from it. The app is then installed like any file, and System Update keeps it up to date from the source."""
    box = BOXES[pkg.kind]
    names = [n for _, n, on in info["sources"] if on] or [pkg.name]
    shown = "\n".join("  - " + n for n in names[:6])
    title = f"{pkg.name} (download source)"
    new_box = not box_exists(box["name"])
    text = (f"{pkg.path.name} has no app in it. It adds a place to download apps from:\n{shown}\n\n"
            f"Add it: adds it to the {box['label']}, then you pick an app from it. Apps from it update "
            f"automatically.")
    size = None
    if new_box:
        intro, size = first_time(pkg.kind)
        text += "\n\n" + intro
    if ask(text, ok="Set up and add it" if new_box else "Add it") != "ok":
        return 1
    if new_box:
        if not room_for(f"Setting up the {box['label']}", setup_need(size)) or not setup_box(pkg.kind, size):
            return 1
    have = next((r for r in load() if r["where"] == box["name"] and r["package"] == pkg.name), None)
    if not have and box_install(pkg, info, title, quiet=True) != 0:
        return failed(f"Adding the download source {pkg.name}")
    if pkg.kind == "deb":
        if not run_steps("Getting the list of apps from the new download source.",
                         [in_box(box["name"], "sudo", "apt-get", "update")]):
            return failed(f"Reading the download source {pkg.name}")
    busy("Reading the list of apps from the new download source")
    apps = source_packages(pkg.kind, box["name"], info["sources"])
    if not apps:
        say(f"The download source was added, but it has no apps to show right now. Check your internet "
            f"connection, then open {pkg.path.name} again.", "warning")
        return 0
    i = choose("Which app do you want? Start typing its name.", ["App", "About it"], [list(a) for a in apps])
    if i is None:
        say(f"The download source stays. Open {pkg.path.name} again to pick an app, or remove it with Remove Apps.")
        return 0
    name = apps[i][0]
    folder = FROM_SOURCE / pkg.kind
    shutil.rmtree(folder, ignore_errors=True)
    folder.mkdir(parents=True)
    cmd = ["dnf", "-q", "download", f"--destdir={folder}", name] if pkg.kind == "rpm" else \
        ["sh", "-c", f"cd {shlex.quote(str(folder))} && apt-get download {shlex.quote(name)}"]
    if not run_steps(f"Downloading {name}.", [in_box(box["name"], *cmd)]):
        return failed(f"Downloading {name}")
    files = sorted(folder.glob("*.rpm" if pkg.kind == "rpm" else "*.deb"))
    if not files:
        return failed(f"Downloading {name}", reason=f"{name} could not be downloaded from the source.")
    # keep the file where Repair can find it again, like any installed file
    keep = CACHE / files[0].name
    shutil.move(str(files[0]), keep)
    SOURCED.add(name)
    return install(str(keep))


def staged_copy(pkg):
    CACHE.mkdir(parents=True, exist_ok=True)
    dest = CACHE / pkg.path.name
    if pkg.path.resolve() != dest.resolve():
        shutil.copyfile(pkg.path, dest)
    return dest


def box_install(pkg, info, title, quiet=False, mode="install"):
    """Install into the box, which exists. quiet: no questions or messages (used by repair).
    mode: install, reinstall (same version again), update (newer file) or older (an older file)."""
    label = BOXES[pkg.kind]["label"]
    box = BOXES[pkg.kind]["name"]
    f = str(staged_copy(pkg))
    ensure_helpers(pkg.kind, quiet=quiet)      # boxes made before the helpers were part of the setup
    rules_before = box_rules(box)
    repos_before = box_repos(box, pkg.kind)
    doing = {"reinstall": "Reinstalling", "update": "Updating", "older": "Installing the older version of"
             }.get(mode, "Installing")
    if pkg.kind == "rpm":
        verb = {"reinstall": "reinstall", "older": "downgrade"}.get(mode, "install")
        steps = [(f"{doing} {title}", in_box(box, "sudo", "dnf", "-y", verb, f))]
    else:
        extra = {"reinstall": ["--reinstall"], "older": ["--allow-downgrades"]}.get(mode, [])
        steps = [("Getting Ubuntu's list of packages", in_box(box, "sudo", "apt-get", "update")),
                 (f"{doing} {title}",
                  in_box(box, "sudo", "env", "DEBIAN_FRONTEND=noninteractive", "apt-get", "install", "-y", *extra, f))]
    if not run_steps(f"{doing} {title} in the {label}.", steps):
        if quiet:
            return 1
        if not box_works(box):
            def repair_then_install():
                if repair(pkg.kind, confirm=False) != 0:
                    return 1
                return box_install(pkg, info, title)
            return failed(f"Installing {title}", offer=("Repair the box", repair_then_install),
                          reason=f"The {label} isn't working.\n\nRecommended: Repair the box. It rebuilds the box, "
                                 f"puts your apps back, then installs {title}. Your files aren't touched.")
        return failed(f"Installing {title}")
    apps, bins = export(box, info)
    new_box_rules(box, rules_before, info)
    old = next((r for r in load() if r["where"] == box and r["package"] == pkg.name), {})
    # Updates: the package (or its install script, as Chrome's and VS Code's do) added a download source
    updates = adds_source(pkg) or bool(set(box_repos(box, pkg.kind)) - set(repos_before)) or \
        bool(old.get("updates")) or pkg.name in SOURCED
    entry = {"title": title, "package": pkg.name, "where": box, "apps": apps, "bins": bins,
             "rules": bool(old.get("rules")), "file": f, "version": pkg.evr, "updates": updates}
    if info.get("source_only"):
        entry["source"] = True
    remember(entry)
    extra = ""
    if quiet:
        return 0
    if info["safe_rules"]:
        ok, out = add_rules(pkg, info)
        if ok:
            entry["rules"] = True
            remember(entry)
            extra = "\n\nUnplug the device and plug it back in so it works."
        else:
            extra = f"\n\nThe device rule wasn't added, so the device may not work.\n{out}"
    if info["notes"]:
        extra += "\n\nIn the box, these won't work:\n" + plain_list(info["notes"])
    if apps:
        where = "Find it in Show Apps."
    elif bins:
        where = "It is a command-line tool, so it has no window in Show Apps."
    else:
        where = "It has no app of its own; other apps in the box use it."
    done = {"reinstall": "is reinstalled", "update": f"is updated to version {plain_version(pkg.evr)}",
            "older": f"is now version {plain_version(pkg.evr)}"}.get(mode, "is installed")
    notify(f"{title} {done}.")
    say(f"{title} {done}. {where}{extra}\n\n{UPDATES_YES if updates else UPDATES_NO}")
    return 0


def staged_system():
    r = subprocess.run(["rpm-ostree", "status", "--json"], capture_output=True, text=True)
    try:
        return any(d.get("staged") for d in json.loads(r.stdout)["deployments"])
    except (ValueError, KeyError):
        return False


def offer_restart(text, rest=""):
    """text: what happened, then the recommendation; rest: what comes after the restart."""
    text += "\n\nRecommended: Restart now. Or Later, if you're in the middle of something."
    if rest:
        text += "\n\n" + rest
    if ask(text, ok="Restart now", cancel="Later") == "ok":
        subprocess.run(["systemctl", "reboot"])


def fedora_package_version(name):
    """Version of the package `name` in Fedora's own repos (fedora, updates), or '' if Fedora does not have it or
    it cannot be checked (offline, no dnf). Third-party repos are left out on purpose."""
    dnf = shutil.which("dnf5") or shutil.which("dnf")
    if not dnf:
        return ""
    out = CACHE / "fedora-query.txt"
    out.unlink(missing_ok=True)
    query = (f"{shlex.quote(dnf)} -q repoquery --repo=fedora,updates --latest-limit=1 "
             f"--arch={platform.machine()},noarch --queryformat='%{{version}}-%{{release}}\\n' "
             f"{shlex.quote(name)} > {shlex.quote(str(out))}")
    if not run_steps(f"Checking whether Fedora has {name}.", [["timeout", "180", "sh", "-c", query]]):
        return ""
    try:
        return next((l.strip() for l in out.read_text().splitlines() if l.strip()), "")
    except OSError:
        return ""


def install_from_fedora(pkg, title, printer, version):
    """Add the package to the system from Fedora's repos by name, so System Update keeps it up to date."""
    what = f"Adding {title} to the system from Fedora. This can take a few minutes."
    notify(f"Adding {title} to the system from Fedora. A progress window shows it.")
    if not run_steps(what, [["rpm-ostree", "install", "--idempotent", pkg.name]]):
        failed(f"Adding {title} to the system")
        return 1
    remember({"title": title, "package": pkg.name, "where": "system", "from_fedora": True,
              "version": version})
    pending([e for e in pending() if e["package"] != pkg.name] + [{"title": title, "package": pkg.name,
                                                                  "printer": printer}])
    after = "After the restart, you will be asked to add your printer." if printer else \
        "After the restart, you'll get a message when it's ready."
    notify(f"{title} is installed. Restart to use it.")
    offer_restart(f"{title} is installed. Restart to start using it.", f"{after}\n\nUpdates: {UPDATES_FEDORA}")
    return 0


def install_system(pkg, title, printer=False, update=False):
    if not update and pkg.kind == "rpm":
        version = fedora_package_version(pkg.name)
        if version:
            newer = "\n\nYour file is newer than Fedora's. Use the file only if you need that newer version now." \
                if compare("rpm", pkg.evr, version) > 0 else ""
            answer = ask(f"Fedora has {title}.\n\nRecommended: Install from Fedora. System Update keeps it up to "
                         f"date.\n\nOr Use the file: installs your download. It never updates.{newer}",
                         ok="Install from Fedora", cancel="Cancel", extra="Use the file")
            if answer == "ok":
                return install_from_fedora(pkg, title, printer, version)
            if answer != "extra":
                return 1
    f = str(staged_copy(pkg))
    if update:      # the layered file is swapped for the newer one in one step
        old = next((r for r in load() if r["where"] == "system" and r["package"] == pkg.name), {})
        cmd = ["rpm-ostree", "uninstall", old.get("nevra") or pkg.name, "--install", f]
        what = f"Updating {title} on the system. This can take a few minutes."
    else:
        cmd = ["rpm-ostree", "install", "--idempotent", f]
        what = f"Adding {title} to the system. This can take a few minutes."
    notify(f"{what.split('.')[0]}. A progress window shows it.")
    if not run_steps(what, [cmd]):
        failed(f"{'Updating' if update else 'Adding'} {title} {'on' if update else 'to'} the system")
        return 1
    remember({"title": title, "package": pkg.name, "nevra": pkg.nevra, "where": "system", "version": pkg.evr})
    # checked once at the next login: is it really there, and for a printer driver, add the printer
    pending([e for e in pending() if e["package"] != pkg.name] + [{"title": title, "package": pkg.name,
                                                                  "printer": printer and not update,
                                                                  "version": pkg.evr}])
    after = "After the restart, you will be asked to add your printer." if printer and not update else \
        "After the restart, you'll get a message when it's ready."
    if update:
        notify(f"{title} is updated. Restart to use the new version.")
        offer_restart(f"{title} is updated. Restart to use the new version.")
    else:
        notify(f"{title} is installed. Restart to use it.")
        offer_restart(f"{title} is installed. Restart to start using it.", f"{after}\n\nUpdates: {UPDATES_SYSTEM}")
    return 0


# ---------------------------------------------------------------- remove

def remove():
    records = load()
    if not records:
        say("Nothing has been installed with Install Package File yet.")
        return 0
    space = sizes_line()
    i = choose("Which app do you want to remove?" + (f"\n{space}" if space else ""), ["App", "Installed in"],
               [[r["title"], WHERE.get(r["where"], r["where"])] for r in records])
    if i is None:
        return 1
    entry = records[i]
    title = entry["title"]
    if ask(f"Remove {title}?", ok="Remove") != "ok":
        return 1
    where = entry["where"]
    if where == "flathub":
        ok = run_steps(f"Removing {title}.", [["flatpak", "uninstall", "-y", "--noninteractive", entry["package"]]])
    elif where == "system":
        ok = run_steps(f"Removing {title} from the system.", [["rpm-ostree", "uninstall", entry["package"]]])
        if not ok and entry.get("nevra"):
            ok = run_steps(f"Removing {title} from the system.", [["rpm-ostree", "uninstall", entry["nevra"]]])
    elif where == "rules":
        ok = remove_rules(entry["package"])
    else:
        unexport(entry)
        ok = True
        bkind = next((k for k in BOXES if BOXES[k]["name"] == where), None)
        # an app that is already gone from its box (the box was set up again, or it was removed another way) only
        # comes off the list: asking the box to remove it would fail, and it would then stay on the list for good
        if box_exists(where) and box_works(where) and bkind and box_version(bkind, entry["package"]):
            # a download source is purged on Ubuntu, so its source file (a kept setting otherwise) goes too
            purge = ["--purge"] if entry.get("source") else []
            cmd = ["sudo", "dnf", "-y", "remove", entry["package"]] if where == BOXES["rpm"]["name"] else \
                ["sudo", "env", "DEBIAN_FRONTEND=noninteractive", "apt-get", "remove", "-y", *purge, entry["package"]]
            ok = run_steps(f"Removing {title}.", [in_box(where, *cmd)])
        if ok and entry.get("rules"):
            ok = remove_rules(entry["package"])
    if not ok:
        failed(f"Removing {title}")
        return 1
    forget(entry)
    pending([e for e in pending() if e["package"] != entry["package"]])
    notify(f"{title} is removed.")
    if where == "system":
        offer_restart(f"{title} is removed. Restart to finish.")
        return 0
    kind = next((k for k in BOXES if BOXES[k]["name"] == where), None)
    if kind and box_exists(where) and not any(r["where"] == where for r in load()):
        label = BOXES[kind]["label"]
        mb = box_size(where)
        free = f"frees about {human(mb)}" if mb else "frees its disk space"
        a = 'an .rpm' if kind == 'rpm' else 'a .deb'
        if ask(f"{title} is removed, and the {label} is now empty.\n\n"
               f"Recommended: Delete the box. It {free}, and comes back by itself the next time you install {a} app. "
               f"Anything added to the box another way is deleted too. Your files are not touched.\n\n"
               f"Or Keep it: saves setup time if you'll install another {a.split()[1]} app soon.",
               ok="Delete the box", cancel="Keep it") == "ok":
            if delete_box(kind):
                notify(f"The {label} is deleted.")
                say(f"The {label} is deleted.")
            else:
                failed(f"Deleting the {label}")
        return 0
    say(f"{title} is removed.")
    return 0


