# RPM Fusion free, as published in RPM Fusion's own rpmfusion-free-release package, shipped by EasySpeak-OS.
# Copied into /etc/yum.repos.d only when you choose "Everything" in Install Media Codecs.
# The signing key comes from Fedora's distribution-gpg-keys package.
[rpmfusion-free]
name=RPM Fusion for Fedora $releasever - Free
#baseurl=http://download1.rpmfusion.org/free/fedora/releases/$releasever/Everything/$basearch/os/
metalink=https://mirrors.rpmfusion.org/metalink?repo=free-fedora-$releasever&arch=$basearch
enabled=1
metadata_expire=14d
type=rpm-md
gpgcheck=1
repo_gpgcheck=0
gpgkey=file:///usr/share/distribution-gpg-keys/rpmfusion/RPM-GPG-KEY-rpmfusion-free-fedora-$releasever
