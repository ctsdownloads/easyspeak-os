# EasySpeakOS: the Logo Menu extension (top left) is on for every user, with the EasySpeakOS logo as its icon,
# Bazaar as its software center and Ghostty as its terminal. The Activities button and Force Quit are hidden; a
# middle click on the logo still opens Activities (Logo Menu's own default). Anyone can change these in its settings.
# A system default (dconf), because the settings belong to the extension. The path is the one its schema names,
# with a capital L.
[org/gnome/shell]
enabled-extensions=['logomenu@aryan_k']

[org/gnome/shell/extensions/Logo-menu]
use-custom-icon=true
custom-icon-path='/usr/share/easyspeak-os/logo-menu-icon.svg'
menu-button-software-center='bazaar'
menu-button-terminal='ghostty'
show-activities-button=false
hide-forcequit=true
