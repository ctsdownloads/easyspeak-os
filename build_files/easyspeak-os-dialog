#!/usr/bin/python3 -I
"""zenity, with voice: the EasySpeak-OS windows use this in place of zenity.

It takes zenity's own arguments and runs zenity with them, unchanged. While the window is open, it also writes a
small description of it (its text and buttons, or the lines of a list) to
$XDG_RUNTIME_DIR/easyspeak-os/dialogs/PID.json. EasySpeak's EasySpeak-OS dialogs plugin reads that, so you can
say a button's name to press it, "number two" to pick a line in a list, or "read it" to hear the window. The
plugin answers by writing PID.answer; this closes the window and gives back exactly what zenity would have:
the same exit code, and the same text on standard output.

Handled with voice: --question, --info, --warning, --error, --list, and --progress when it has a Cancel button.
Anything else is passed straight to zenity.
"""
import json
import os
import subprocess
import sys
import threading
import time

DIALOGS = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "easyspeak-os", "dialogs")
VOICE = ("--question", "--info", "--warning", "--error", "--list", "--progress")


def value(args, name, default=None):
    """The last --name=value or --name value in args."""
    found = default
    for i, a in enumerate(args):
        if a.startswith(name + "="):
            found = a.split("=", 1)[1]
        elif a == name and i + 1 < len(args):
            found = args[i + 1]
    return found


def values(args, name):
    out = []
    for i, a in enumerate(args):
        if a.startswith(name + "="):
            out.append(a.split("=", 1)[1])
        elif a == name and i + 1 < len(args):
            out.append(args[i + 1])
    return out


def plain(text, markup):
    """The window's text as words: zenity's \\n and \\t escapes turned into spaces, markup dropped."""
    text = (text or "").replace("\\n", "\n").replace("\\t", " ")
    if markup:
        import re
        import html
        text = html.unescape(re.sub(r"<[^>]+>", "", text))
    return " ".join(text.split())


def describe(args, stdin_rows):
    mode = next(a for a in args if a in VOICE)
    buttons = []          # (what to say, what it does)
    if mode == "--question":
        buttons = [(value(args, "--ok-label", "Yes"), "ok"), (value(args, "--cancel-label", "No"), "cancel")]
    elif mode in ("--info", "--warning", "--error"):
        buttons = [(value(args, "--ok-label", "OK"), "ok")]
    elif mode == "--list":
        buttons = [(value(args, "--ok-label", "OK"), "ok"), (value(args, "--cancel-label", "Cancel"), "cancel")]
    elif mode == "--progress" and "--no-cancel" not in args:
        buttons = [("Cancel", "cancel")]
    buttons += [(e, "extra:" + e) for e in values(args, "--extra-button")]
    rows = []
    if mode == "--list":
        columns = len(values(args, "--column"))
        hidden = {int(c) for v in values(args, "--hide-column") for c in v.split(",") if c.strip().isdigit()}
        show = next((c for c in range(1, columns + 1) if c not in hidden), 1)
        printed = int(value(args, "--print-column", "1")) if (value(args, "--print-column", "1") or "1").isdigit() else 1
        for i in range(0, len(stdin_rows) - columns + 1, columns):
            cells = stdin_rows[i:i + columns]
            rows.append({"say": cells[show - 1], "value": cells[printed - 1],
                         "text": " ".join(c for n, c in enumerate(cells, 1) if n not in hidden)})
    return {"pid": os.getpid(), "mode": mode, "title": value(args, "--title", ""),
            "text": plain(value(args, "--text", ""), "--no-markup" not in args),
            "buttons": [{"say": s, "does": d} for s, d in buttons if s], "rows": rows, "time": time.time()}


def main(args):
    if not any(a in VOICE for a in args) or ("--progress" in args and "--no-cancel" in args):
        os.execvp("zenity", ["zenity", *args])
    mode = next(a for a in args if a in VOICE)
    data = None
    if mode == "--list":
        data = sys.stdin.read()
    info = describe(args, data.splitlines() if data is not None else [])
    os.makedirs(DIALOGS, exist_ok=True)
    state = os.path.join(DIALOGS, f"{os.getpid()}.json")
    answer = os.path.join(DIALOGS, f"{os.getpid()}.answer")
    with open(state + ".tmp", "w") as f:
        json.dump(info, f)
    os.replace(state + ".tmp", state)

    proc = subprocess.Popen(["zenity", *args], stdin=subprocess.PIPE if mode in ("--list", "--progress") else None,
                            stdout=subprocess.PIPE, text=True)
    if mode == "--list":
        proc.stdin.write(data)
        proc.stdin.close()
    elif mode == "--progress":
        def copy():         # the caller's progress lines go on to zenity, as if it were talking to zenity itself
            try:
                for line in sys.stdin:
                    proc.stdin.write(line)
                    proc.stdin.flush()
            except (BrokenPipeError, OSError, ValueError):
                pass
            try:
                proc.stdin.close()
            except (BrokenPipeError, OSError):
                pass
        threading.Thread(target=copy, daemon=True).start()
    out_text = []
    reader = threading.Thread(target=lambda: out_text.append(proc.stdout.read()), daemon=True)
    reader.start()

    code, printed = None, None
    try:
        while proc.poll() is None:
            if os.path.exists(answer):
                try:
                    said = open(answer).read().strip()
                except OSError:
                    said = ""
                proc.terminate()
                try:
                    proc.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    proc.kill()
                if said == "ok":
                    code = 0
                elif said.startswith("extra:"):
                    code, printed = 1, said[6:]
                elif said.startswith("row:") and said[4:].isdigit() and int(said[4:]) < len(info["rows"]):
                    code, printed = 0, info["rows"][int(said[4:])]["value"]
                else:
                    code = 1
                break
            time.sleep(0.15)
    finally:
        for f in (state, answer):
            try:
                os.remove(f)
            except OSError:
                pass
    if code is None:                       # answered with the mouse or keyboard, as usual
        reader.join(timeout=2)
        sys.stdout.write("".join(out_text))
        return proc.returncode
    if printed is not None:
        print(printed)
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
