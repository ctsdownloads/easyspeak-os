# EasySpeakOS default apps that Fedora doesn't package, installed from Flathub on the first start with internet
# (easyspeak-os-flatpak-apps.service runs "flatpak preinstall"). Uninstalling one keeps it uninstalled.
[Flatpak Preinstall io.github.mrvladus.List]
Branch=stable

[Flatpak Preinstall de.haeckerfelix.Shortwave]
Branch=stable

[Flatpak Preinstall org.gnome.Podcasts]
Branch=stable

[Flatpak Preinstall org.gnome.World.PikaBackup]
Branch=stable

[Flatpak Preinstall org.gnome.World.Secrets]
Branch=stable
