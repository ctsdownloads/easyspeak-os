#!/usr/bin/python3 -I
"""System Tools: a few system jobs in plain windows, by voice or from Show Apps.

  easyspeak-os-tools                 the list of tools
  easyspeak-os-tools firmware        update firmware
  easyspeak-os-tools disk-unlock     unlock the disk automatically at startup (TPM)
  easyspeak-os-tools free-space      free up disk space
  easyspeak-os-tools bios            restart into the BIOS settings
  easyspeak-os-tools updates         turn automatic updates on or off
  easyspeak-os-tools undo-update     go back to the system version from before the last update
  easyspeak-os-tools problem-details save the computer's recent error messages to a file, for your helper
  easyspeak-os-tools setup           the setup checklist: microphone, media codecs, disk unlock, getting apps
  easyspeak-os-tools setup --first-login   the same, once, at a new user's first login

Each tool does what one of Universal Blue's ujust commands does, but asks in windows instead of in a terminal.
Jobs that change the system run as root through polkit: through easyspeak-os-tools-safe, which an administrator at
the computer runs without a password (turning automatic updates on, automatic disk unlock, freeing up space), or
through easyspeak-os-tools-admin, which asks for the administrator password (turning automatic updates off).
"""
import array
import json
import os
import shutil
import subprocess
import sys
import time
import wave
from pathlib import Path

TITLE = "System Tools"
DIALOG = "/usr/bin/easyspeak-os-dialog" if os.access("/usr/bin/easyspeak-os-dialog", os.X_OK) else "zenity"
ADMIN = "/usr/libexec/easyspeak-os-tools-admin"
SAFE = "/usr/libexec/easyspeak-os-tools-safe"
CACHE = Path.home() / ".cache" / "easyspeak-os"
LOG = CACHE / "tools.log"
DISK_UNLOCK_ON = Path("/var/lib/easyspeak-os/disk-unlock-on")
STATE = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state") / "easyspeak-os"
SETUP_SHOWN = STATE / "setup-shown"      # the setup checklist has opened at login once
CODECS_ASKED = STATE / "codecs-asked"    # set by Install Media Codecs' own first-login question (older systems)
GUI = bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")) and shutil.which("zenity")


# ---------------------------------------------------------------- windows

def zenity(*args, stdin=None, title=TITLE, width=520):
    return subprocess.run([DIALOG, f"--title={title}", f"--width={width}", *args], input=stdin,
                          capture_output=True, text=True)


def notify(text):
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", f"--app-name={TITLE}", "--icon=applications-system-symbolic", TITLE, text],
                       capture_output=True)


def say(text, kind="info", title=TITLE):
    if GUI:
        zenity(f"--{kind}", "--no-markup", f"--text={text}", title=title)
    else:
        print(text)


def ask(text, ok="Yes", cancel="Cancel", extra=None, title=TITLE):
    """'ok', 'extra' or None."""
    if GUI:
        args = ["--question", "--no-markup", f"--text={text}", f"--ok-label={ok}", f"--cancel-label={cancel}"]
        if extra:
            args.append(f"--extra-button={extra}")
        r = zenity(*args, title=title)
        if r.returncode == 0:
            return "ok"
        return "extra" if extra and r.stdout.strip() == extra else None
    print(text)
    print(f"  1) {ok}" + (f"\n  2) {extra}" if extra else "") + f"\n  Enter) {cancel}")
    try:
        return {"1": "ok", "2": "extra" if extra else None}.get(input("> ").strip())
    except EOFError:
        return None


def choose(text, columns, rows):
    """Pick one row; its index or None. Each line shows its number, so "number two" can be said by sight."""
    if GUI:
        # Wide and tall enough that every tool and what it does reads in full, without scrolling either way.
        args = ["--list", f"--text={text}", "--height=460", "--print-column=1", "--hide-column=1",
                "--column=n", "--column=No.", *[f"--column={c}" for c in columns]]
        cells = []
        for i, row in enumerate(rows):
            cells += [str(i), str(i + 1), *row]
        r = zenity(*args, stdin="\n".join(cells) + "\n", width=900)
        out = r.stdout.strip().split("|")[0]
        return int(out) if r.returncode == 0 and out.isdigit() else None
    print(text)
    for i, row in enumerate(rows, 1):
        print(f"  {i}) " + "   ".join(row))
    try:
        n = input("> ").strip()
    except EOFError:
        return None
    return int(n) - 1 if n.isdigit() and 0 < int(n) <= len(rows) else None


def password(text):
    """The disk password, typed. None when cancelled."""
    if GUI:
        r = subprocess.run(["zenity", f"--title={TITLE}", "--password", f"--text={text}"],
                           capture_output=True, text=True)
        return r.stdout.rstrip("\n") if r.returncode == 0 and r.stdout.strip() else None
    import getpass
    try:
        return getpass.getpass(text + " ") or None
    except EOFError:
        return None


def busy(text, title=TITLE):
    """Show a moving progress window with this text (or print it without a desktop). Close it with done(bar)."""
    if not GUI:
        print(text)
        return None
    return subprocess.Popen(["zenity", f"--title={title}", "--progress", "--pulsate", "--auto-close", "--no-cancel",
                             "--width=480", f"--text={text}"], stdin=subprocess.PIPE, text=True)


def done(bar):
    if bar:
        try:
            bar.stdin.write("100\n")
            bar.stdin.close()
        except BrokenPipeError:
            pass
        bar.wait()


def run(text, cmd, stdin=None, title=TITLE):
    """Run one command with a progress window; its exit code. Its output goes to the log, not the window."""
    CACHE.mkdir(parents=True, exist_ok=True)
    with open(LOG, "a") as log:
        log.write(f"\n=== {time.strftime('%Y-%m-%d %H:%M:%S')} {text}\n$ {' '.join(cmd)}\n")
        log.flush()
        bar = busy(text, title)
        try:
            rc = subprocess.run(cmd, input=stdin, stdout=log, stderr=subprocess.STDOUT, text=True).returncode
        except OSError as e:
            log.write(f"{e}\n")
            rc = 127
        done(bar)
    return rc


def output(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return None


def offer_restart(text):
    if ask(text + "\n\nRecommended: Restart now. Or Later, if you're in the middle of something.",
           ok="Restart now", cancel="Later") == "ok":
        subprocess.run(["systemctl", "reboot"])


def human(mb):
    return f"{mb / 1000:.1f} GB" if mb >= 1000 else f"{mb} MB"


def free_mb():
    try:
        st = os.statvfs(str(Path.home()))
        return st.f_bavail * st.f_frsize // 1_000_000
    except OSError:
        return None


# ---------------------------------------------------------------- state

def luks_uuid():
    """The encrypted system disk's UUID, from the kernel command line, or None when the disk is not encrypted."""
    try:
        args = Path("/proc/cmdline").read_text().split()
    except OSError:
        return None
    for a in args:
        if a.startswith("rd.luks.uuid="):
            v = a.split("=", 1)[1]
            return v[5:] if v.startswith("luks-") else v
    return None


def has_tpm():
    return Path("/dev/tpmrm0").exists()


def secure_boot_on():
    """True, False, or None when it cannot be told."""
    for f in Path("/sys/firmware/efi/efivars").glob("SecureBoot-*"):
        try:
            data = f.read_bytes()
            return len(data) >= 5 and data[4] == 1
        except OSError:
            return None
    return None


def updates_on():
    r = output(["systemctl", "is-enabled", "uupd.timer"])
    return bool(r) and r.stdout.strip() == "enabled"


# ---------------------------------------------------------------- tools

def firmware():
    w = "Update firmware"
    if run("Checking for firmware updates.", ["fwupdmgr", "refresh", "--force", "--no-remote-check",
                                               "--no-metadata-check", "--no-unreported-check"], title=w) not in (0, 2):
        say("Couldn't check for firmware updates. Check your internet connection and try again.", "warning", title=w)
        return 1
    r = output(["fwupdmgr", "get-updates", "--json", "--no-unreported-check", "--no-metadata-check"])
    if not r or r.returncode not in (0, 2):     # 2: no updates
        say("Couldn't check for firmware updates. Try again later.", "warning", title=w)
        return 1
    devices = []
    if r.returncode == 0:
        try:
            for d in json.loads(r.stdout).get("Devices", []):
                rel = (d.get("Releases") or [{}])[0]
                devices.append(f"  - {d.get('Name', 'A device')}: {d.get('Version', '?')} to {rel.get('Version', '?')}")
        except (ValueError, AttributeError):
            devices = []
    if not devices:
        say("Your computer's firmware is up to date.", title=w)
        return 0
    note = ""
    if DISK_UNLOCK_ON.exists():
        note = ("\n\nUnlock disk automatically is on. After some firmware updates, the computer asks for the disk "
                "password once. Then turn Unlock disk automatically on again in System Tools.")
    if ask("Firmware updates are available for:\n" + "\n".join(devices) + "\n\nFirmware is the software built into "
           "the computer's own parts, like the BIOS.\n\nRecommended: Update. Keep the computer plugged in. Some "
           "updates finish while the computer restarts." + note, ok="Update", title=w) != "ok":
        return 1
    rc = run("Updating firmware. Keep the computer plugged in.",
             ["fwupdmgr", "update", "--assume-yes", "--no-reboot-check", "--no-remote-check", "--no-metadata-check",
              "--no-unreported-check"], title=w)
    if rc == 2:     # nothing to do after all
        say("Your computer's firmware is up to date.", title=w)
        return 0
    if rc != 0:
        say("The firmware update didn't finish. Try again later.", "warning", title=w)
        return 1
    notify("Firmware updated.")
    offer_restart("Firmware updated. Some updates finish while the computer restarts.")
    return 0


def disk_unlock(in_checklist=False):
    w = "Unlock disk automatically"
    uuid = luks_uuid()
    if not uuid:
        say("Your disk isn't encrypted, so there's no disk password to skip. Nothing to do.", title=w)
        return 0
    if not has_tpm():
        say("This computer has no security chip (TPM) that can do this, so the disk password stays.", title=w)
        return 0
    if DISK_UNLOCK_ON.exists():
        if ask("Unlock disk automatically is on: the disk unlocks by itself when the computer starts.\n\n"
               "Turn off: you type the disk password at every start again.", ok="Turn off", cancel="Keep it on",
               title=w) != "ok":
            return 1
        pw = password("Type the disk password (the one you type when the computer starts):")
        if not pw:
            return 1
        rc = run("Turning off automatic disk unlock.", ["pkexec", SAFE, "disk-unlock", "off"], stdin=pw, title=w)
        return done_disk(rc, "Unlock disk automatically is off. From your next start, the computer asks for the "
                             "disk password again.", w)
    if secure_boot_on() is False:
        a = ask("Right now you type the disk password every time the computer starts.\n\nSecure Boot is off on this "
                "computer, so this would be less safe: someone could change how the computer starts and still get the "
                "disk unlocked.\n\nRecommended: Cancel, then turn Secure Boot on in the BIOS settings first (Restart "
                "into BIOS settings, in System Tools).\n\nOr Turn on anyway.", ok="Turn on anyway", title=w)
    else:
        a = ask("Right now you type the disk password every time the computer starts.\n\nRecommended: Turn on. The "
                "computer's security chip unlocks the disk for you. If the disk is ever taken out of this computer, or "
                "its startup settings change, it asks for the password as before.\n\nNeeds the disk password one "
                "last time, then a restart.", ok="Turn on", title=w)
    if a != "ok":
        return 1
    pw = password("Type the disk password (the one you type when the computer starts):")
    if not pw:
        return 1
    rc = run("Turning on automatic disk unlock.", ["pkexec", SAFE, "disk-unlock", "on"], stdin=pw, title=w)
    if rc == 0:
        if in_checklist:    # the checklist offers the restart at its end, so its last steps aren't lost
            say("It's on. From your next restart, the disk unlocks by itself.", title=w)
        else:
            offer_restart("It's on. From your next restart, the disk unlocks by itself.")
        return 0
    return done_disk(rc, "", w)


def done_disk(rc, text, w):
    if rc == 0:
        say(text, title=w)
        return 0
    if rc == 3:
        say("That isn't the disk password, so nothing was changed. Try again.", "warning", title=w)
    elif rc == 4:
        say("That was the wrong disk password too many times, so it's locked for an hour. Nothing was changed. "
            "Try again after that.", "warning", title=w)
    elif rc in (126, 127):
        say("The administrator password wasn't given, so nothing was changed.", "warning", title=w)
    else:
        say(f"It didn't work, and nothing was changed. Try again later.\n\nThe details are in {LOG}", "warning",
            title=w)
    return 1


def free_space():
    w = "Free up disk space"
    before = free_mb()
    now = f"{human(before)} is free now.\n\n" if before is not None else ""
    if ask(f"{now}This removes things the computer no longer needs: unused app parts, old system update files, and "
           f"unused container images. Your files and your apps aren't touched.", ok="Free up space", title=w) != "ok":
        return 1
    # The system's own leftovers (old update files, unused Flatpak runtimes for everyone) go through the no-password
    # helper, which can only remove those; the rest is the user's own.
    steps = [("Removing unused container images.", ["podman", "image", "prune", "-af"]),
             ("Removing your unused app parts.", ["flatpak", "uninstall", "--user", "--unused", "-y",
                                                  "--noninteractive"]),
             ("Removing old system update files and unused app parts.", ["pkexec", SAFE, "free-space"])]
    brew = "/home/linuxbrew/.linuxbrew/bin/brew"
    if os.access(brew, os.X_OK):
        steps += [("Removing unused command-line tools.", [brew, "autoremove"]),
                  ("Removing old command-line tool downloads.", [brew, "cleanup"])]
    for text, cmd in steps:
        if shutil.which(cmd[0]) or cmd[0].startswith("/"):
            run(text, cmd, title=w)
    after = free_mb()
    if before is not None and after is not None:
        freed = max(after - before, 0)
        say(f"Done. {human(freed)} freed. {human(after)} is free now.", title=w)
    else:
        say("Done.", title=w)
    return 0


def bios():
    w = "Restart into BIOS settings"
    if not Path("/sys/firmware/efi").is_dir():
        say("This computer can't open its BIOS settings from here. Press the BIOS key while it starts (often F2, "
            "F10, F12 or Delete).", title=w)
        return 0
    if ask("The computer restarts and opens its BIOS settings screen. Save your work first.\n\nThe BIOS settings are "
           "used with the keyboard. When you're done, choose Save and Exit, or Exit, to start the computer again.",
           ok="Restart now", title=w) != "ok":
        return 1
    r = output(["systemctl", "reboot", "--firmware-setup"])
    if not r or r.returncode != 0:
        say("This computer can't open its BIOS settings from here. Press the BIOS key while it starts (often F2, "
            "F10, F12 or Delete).", title=w)
        return 1
    return 0


def updates():
    w = "Automatic updates"
    if updates_on():
        if ask("Automatic updates are on: everything updates by itself every day at 4 am.\n\nRecommended: Keep them "
               "on. Updates fix security problems.\n\nOr Turn off: nothing updates until you run System Update "
               "yourself.", ok="Turn off", cancel="Keep them on", title=w) != "ok":
            return 1
        rc = run("Turning off automatic updates.", ["pkexec", ADMIN, "updates", "off"], title=w)
        text = "Automatic updates are off. Run System Update yourself to update."
    else:
        if ask("Automatic updates are off: nothing updates until you run System Update yourself.\n\nRecommended: "
               "Turn on. Everything then updates by itself every day at 4 am, and updates fix security problems.",
               ok="Turn on", cancel="Keep them off", title=w) != "ok":
            return 1
        rc = run("Turning on automatic updates.", ["pkexec", SAFE, "updates", "on"], title=w)
        text = "Automatic updates are on."
    if rc == 0:
        say(text, title=w)
        return 0
    say("The administrator password wasn't given, so nothing was changed." if rc in (126, 127) else
        f"It didn't work, and nothing was changed.\n\nThe details are in {LOG}", "warning", title=w)
    return 1


def deployments():
    """The system versions on disk, newest first (rpm-ostree status --json), or None."""
    r = output(["rpm-ostree", "status", "--json"])
    if not r or r.returncode != 0:
        return None
    try:
        return json.loads(r.stdout)["deployments"]
    except (ValueError, KeyError):
        return None


def when(d):
    """A version's date in plain words ("Oct 14"), from its build time."""
    try:
        return time.strftime("%b %-d", time.localtime(int(d["timestamp"])))
    except (KeyError, ValueError, TypeError):
        return "an earlier date"


def undo_update():
    w = "Undo the last update"
    ds = deployments()
    if ds is None:
        say("Couldn't read which system versions are on this computer. Try again later.", "warning", title=w)
        return 1
    booted = next((d for d in ds if d.get("booted")), None)
    staged = next((d for d in ds if d.get("staged")), None)
    later = ("\n\nThe next automatic update puts the newest version back. If the problem comes back, turn off "
             "Automatic updates in System Tools and tell your helper.")
    if staged:
        # An update is downloaded but not in use yet: the version running now is not the new one.
        if ask(f"An update from {when(staged)} is waiting. It starts at your next restart. The version you're using "
               f"now is from {when(booted) if booted else 'before it'}.\n\nIf you don't want it: Don't use it. Your "
               f"computer keeps the version it has now.\n\nOr Keep it." + later,
               ok="Don't use it", cancel="Keep it", title=w) != "ok":
            return 1
        rc = run("Removing the waiting update.", ["rpm-ostree", "cleanup", "-p"], title=w)
        if rc != 0:
            say(f"It didn't work, and nothing was changed.\n\nThe details are in {LOG}", "warning", title=w)
            return 1
        say("Done. Your computer keeps the version it has now.", title=w)
        return 0
    if booted is not None and ds and ds[0] is not booted:
        if int(ds[0].get("timestamp", 0)) <= int(booted.get("timestamp", 0)):
            # An earlier undo: the older version is set to start next time.
            offer_restart(f"It's already set: the version from {when(ds[0])} starts at your next restart.")
        else:
            # Started from the boot menu on the older version: the newer one is still the one that starts.
            say(f"You're using the version from {when(booted)}, picked when the computer started. At your next "
                f"restart the newer version, from {when(ds[0])}, starts again.\n\nTo stay on this one, pick it again "
                f"when the computer starts, and tell your helper.", title=w)
        return 0
    older = next((d for d in ds if not d.get("booted") and not d.get("staged")), None)
    if older is None:
        say("There's no earlier version on this computer to go back to. Only the version you're using now is kept.",
            title=w)
        return 0
    if booted is not None and int(older.get("timestamp", 0)) > int(booted.get("timestamp", 0)):
        # After an undo: the other version on disk is the newer one.
        if ask(f"You're using an earlier version, from {when(booted)}, after an undo. The newer one, from "
               f"{when(older)}, is still on this computer.\n\nIf the problem is fixed or you want it back: Use the "
               f"newer version. It starts at your next restart.\n\nOr Cancel: the next update brings back the "
               f"newest version anyway.", ok="Use the newer version", title=w) != "ok":
            return 1
        rc = run("Setting the newer version to start next time.", ["rpm-ostree", "rollback"], title=w)
        if rc != 0:
            say("The administrator password wasn't given, so nothing was changed." if rc in (126, 127) else
                f"It didn't work, and nothing was changed.\n\nThe details are in {LOG}", "warning", title=w)
            return 1
        offer_restart(f"Done. The version from {when(older)} starts at your next restart.")
        return 0
    if ask(f"The version you're using now is from {when(booted) if booted else 'the last update'}. The one from "
           f"before it, from {when(older)}, is still on this computer.\n\nIf something stopped working after the last "
           f"update: Undo the update. The version from {when(older)} starts at your next restart. Your files and "
           f"your apps aren't touched.\n\nOr Cancel." + later, ok="Undo the update", title=w) != "ok":
        return 1
    rc = run("Setting the earlier version to start next time.", ["rpm-ostree", "rollback"], title=w)
    if rc != 0:
        say("The administrator password wasn't given, so nothing was changed." if rc in (126, 127) else
            f"It didn't work, and nothing was changed.\n\nThe details are in {LOG}", "warning", title=w)
        return 1
    offer_restart(f"Done. The version from {when(older)} starts at your next restart.")
    return 0


def documents():
    r = output(["xdg-user-dir", "DOCUMENTS"])
    d = Path(r.stdout.strip()) if r and r.returncode == 0 and r.stdout.strip() else Path.home() / "Documents"
    return d if d != Path.home() else Path.home() / "Documents"


# What goes in the problem details file: (heading, command, how many of its last lines to keep).
# The same information as ujust's logs-this-boot, logs-last-boot and device-info, kept to the useful part: errors
# and warnings, not every message, so the file stays small enough to email.
DETAILS = [
    ("System version", ["rpm-ostree", "status"], 60),
    ("Computer", ["fpaste", "--sysinfo", "--printonly"], 200),
    ("Warnings and errors since this start", ["journalctl", "--no-hostname", "--no-pager", "-b", "0", "-p",
                                              "warning"], 1500),
    ("Errors during the start before this one", ["journalctl", "--no-hostname", "--no-pager", "-b", "-1", "-p",
                                                 "err"], 500),
    ("Updates, last 3 days", ["journalctl", "--no-hostname", "--no-pager", "-o", "cat", "--since", "-3d",
                              "-u", "uupd.service", "-u", "uupd-manual.service", "-p", "info"], 300),
    ("Flatpak apps", ["flatpak", "list", "--columns=application,version,origin"], 300),
    ("App boxes", ["podman", "ps", "-a", "--format", "{{.Names}}  {{.Image}}  {{.Status}}"], 50),
]


def tail(text, n):
    lines = text.splitlines()
    cut = len(lines) - n
    return ("(... %d earlier lines left out ...)\n" % cut if cut > 0 else "") + "\n".join(lines[-n:])


def problem_details():
    w = "Save problem details"
    folder = documents()
    name = f"problem-details-{time.strftime('%Y-%m-%d-%H%M')}.txt"
    if ask(f"This saves the computer's recent error messages, its system version and the list of your apps to one "
           f"file, {name}, in your Documents folder. What your apps showed or opened isn't in it.\n\nThen email "
           f"that file to your helper. They can see what went wrong without being here.\n\nNothing is sent "
           f"anywhere by itself.",
           ok="Save details", title=w) != "ok":
        return 1
    bar = busy("Collecting the problem details.", w)
    parts = [f"Problem details from EasySpeakOS, {time.strftime('%Y-%m-%d %H:%M')}"]
    for heading, cmd, n in DETAILS:
        r = output(cmd) if shutil.which(cmd[0]) else None
        text = (r.stdout + r.stderr).strip() if r else "(not available)"
        parts.append(f"\n===== {heading} =====\n{tail(text, n) or '(nothing)'}")
    # The logs of Install Package File and System Tools. Box apps' own logs (in logs/) stay out: they hold whatever
    # the app printed, such as web addresses and file names.
    for f in sorted(CACHE.glob("*.log")):
        try:
            parts.append(f"\n===== {f.name} =====\n{tail(f.read_text(errors='replace'), 200)}")
        except OSError:
            pass
    path = folder / name
    try:
        folder.mkdir(parents=True, exist_ok=True)
        path.write_text("\n".join(parts) + "\n")
        ok = True
    except OSError:
        ok = False
    done(bar)
    if not ok:
        say(f"Couldn't save the file in {folder}. Check that there's free disk space and try again.", "warning",
            title=w)
        return 1
    if ask(f"Saved: {name}, in your Documents folder.\n\nEmail it to your helper: attach it like any other file.\n\n"
           f"Recommended: Show the file, to see where it is. Or Close.", ok="Show the file", cancel="Close",
           title=w) == "ok":
        if shutil.which("nautilus"):
            subprocess.Popen(["nautilus", "--select", str(path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            subprocess.Popen(["xdg-open", str(folder)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


# ---------------------------------------------------------------- setup checklist

def mic_heard():
    """Record 4 seconds from the microphone (pw-record, PipeWire's recorder, which shares the microphone with
    EasySpeak). True if it heard a voice-loud sound, False if only near silence, None if it could not record."""
    if not shutil.which("pw-record"):
        return None
    CACHE.mkdir(parents=True, exist_ok=True)
    f = CACHE / "mic-test.wav"
    f.unlink(missing_ok=True)
    try:
        p = subprocess.Popen(["pw-record", "--rate", "16000", "--channels", "1", "--format", "s16", str(f)],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(4)
        p.terminate()
        p.wait(timeout=5)
        with wave.open(str(f)) as w:
            samples = array.array("h", w.readframes(w.getnframes()))
    except (OSError, wave.Error, EOFError, subprocess.TimeoutExpired):
        return None
    finally:
        f.unlink(missing_ok=True)
    if not samples:
        return None
    return max(abs(x) for x in samples) > 1500       # about a fortieth of full scale: a voice, not room noise


def mic_step(w):
    while True:
        if ask("Check that the computer hears you.\n\nRecommended: Test. Then, when the next window says so, say "
               "\"testing, testing\" out loud.\n\nOr Skip.", ok="Test", cancel="Skip", title=w) != "ok":
            return
        bar = busy("Listening. Say \"testing, testing\" now.", w)
        heard = mic_heard()
        done(bar)
        if heard:
            say("The microphone works: the computer heard you.", title=w)
            return
        why = ("Couldn't use the microphone." if heard is None else "The computer didn't hear anything.")
        a = ask(f"{why}\n\nRecommended: Open sound settings, and under Input choose the microphone you use and "
                f"check its volume. Then Test again.\n\nOr Skip.", ok="Test again", cancel="Skip",
                extra="Open sound settings", title=w)
        if a == "extra":
            subprocess.Popen(["gnome-control-center", "sound"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if ask("Choose the microphone under Input, then come back here.\n\nRecommended: Test again. Or Skip.",
                   ok="Test again", cancel="Skip", title=w) != "ok":
                return
        elif a != "ok":
            return


def codecs_added():
    return any(subprocess.run(["rpm", "-q", "--quiet", p]).returncode == 0
               for p in ("x264-libs", "mozilla-openh264")) if shutil.which("rpm") else False


def codecs_step(w):
    if codecs_added():
        return
    if ask("Some video formats, like most web video, need media codecs that aren't part of the system. The next "
           "window explains the choices.\n\nRecommended: Next. Or Skip: Install Media Codecs is in Show Apps any "
           "time.", ok="Next", cancel="Skip", title=w) != "ok":
        return
    STATE.mkdir(parents=True, exist_ok=True)
    CODECS_ASKED.touch()
    # --no-restart: the codecs window doesn't offer its own restart; the checklist offers it at its end.
    subprocess.run(["/usr/bin/easyspeak-os-codecs", "gui", "--no-restart"])


def disk_step(w):
    if not luks_uuid() or not has_tpm() or DISK_UNLOCK_ON.exists():
        return          # nothing to unlock, nothing to unlock it with, or already on
    if ask("This computer asks for the disk password every time it starts. The computer's security chip can unlock "
           "the disk instead.\n\nThis needs the disk password, so it's one for "
           "your helper.\n\nRecommended: Set it up. Or Skip: it's in System Tools any time.",
           ok="Set it up", cancel="Skip", title=w) == "ok":
        disk_unlock(in_checklist=True)


def apps_step(w):
    """Show where apps come from by opening the real places, not only by naming them. The window comes back after
    each one, until Next."""
    opened = ""
    while True:
        a = ask(f"{opened}Getting apps:\n\n"
                "- Most apps: Bazaar, the app store. Find the app there and install it.\n"
                "- An app that comes as a file (.rpm or .deb): open the file, or open Install Package File, which "
                "lists the files in your Downloads folder.\n"
                "- Removing those apps: Remove Apps, in Show Apps.\n\n"
                "Say \"system tools\" for the rest: updates, disk space, undoing an update, and saving problem "
                "details for your helper.\n\nRecommended: Open Bazaar, to see it. Or Open Install Package File. "
                "Or Next.", ok="Open Bazaar", cancel="Next", extra="Open Install Package File", title=w)
        if a == "ok":
            subprocess.Popen(["gtk-launch", "io.github.kolunmi.Bazaar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            opened = "Bazaar is open. Close it when you're done looking.\n\n"
        elif a == "extra":
            subprocess.Popen(["/usr/bin/easyspeak-os-packages", "install"], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
            opened = "Install Package File is open. Cancel it when you're done looking.\n\n"
        else:
            return


def voice_ready(wait=180):
    """Wait until EasySpeak has loaded, so the checklist's buttons can be said from its first window. EasySpeak's
    EasySpeakOS dialogs plugin leaves a note with EasySpeak's process number once its speech model and plugins are
    loaded (easyspeak-ready, in $XDG_RUNTIME_DIR/easyspeak-os). At most `wait` seconds, then open anyway: the
    buttons can always be clicked."""
    note = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "easyspeak-os" / "easyspeak-ready"
    end = time.time() + wait
    while time.time() < end:
        try:
            os.kill(int(note.read_text().strip()), 0)
            time.sleep(3)           # it loads its plugins a moment before it starts listening
            return True
        except (OSError, ValueError):
            time.sleep(2)
    return False


def setup_checklist(first_login=False):
    w = "Setup checklist"
    if first_login:
        # Once per user, at the first login. Users who already had Install Media Codecs' own first-login question
        # were set up before this checklist existed, so it doesn't open for them.
        if not GUI or SETUP_SHOWN.exists() or CODECS_ASKED.exists():
            return 0
        voice_ready()
    a = ask("Welcome. A few things to set up, one at a time. Answer each window by saying a button's name, like "
            "\"Start\".\n\n"
            "1. Check the microphone\n2. Media codecs, for web video\n3. Skip the disk password at startup\n"
            "4. How to get apps\n\nEach can be skipped.\n\nRecommended: Start. Or Later: this opens again at the "
            "next login. Or Don't show again: say \"setup checklist\" to open it any time.",
            ok="Start", cancel="Later", extra="Don't show again" if first_login else None, title=w)
    if first_login and a in ("ok", "extra"):
        STATE.mkdir(parents=True, exist_ok=True)
        SETUP_SHOWN.touch()
    if a != "ok":
        return 1
    disk_before = DISK_UNLOCK_ON.exists()
    waiting_before = any(d.get("staged") for d in (deployments() or []))
    for step in (mic_step, codecs_step, disk_step, apps_step):
        step(w)
    # One restart at the end, for what needs it: the media codecs (a new system version waiting for a restart)
    # and automatic disk unlock (used from the next start).
    disk_now = DISK_UNLOCK_ON.exists() and not disk_before
    waiting = any(d.get("staged") for d in (deployments() or []))
    later = []
    if waiting and not waiting_before:
        later.append("The media codecs start working after a restart.")
    elif waiting:
        later.append("A system update is also waiting for a restart.")
    if disk_now:
        later.append("From your next restart, the disk unlocks by itself.")
    text = "Setup is done. " + " ".join(later) + ("\n\n" if later else "") + \
        "Say \"setup checklist\" to open it again."
    if waiting:
        offer_restart(text)
    else:
        say(text, title=w)
    return 0


TOOLS = [("firmware", "Update firmware", "Updates for the computer's own parts, like the BIOS", firmware),
         ("disk-unlock", "Unlock disk automatically", "Skip the disk password at startup", disk_unlock),
         ("free-space", "Free up disk space", "Remove things the computer no longer needs", free_space),
         ("bios", "Restart into BIOS settings", "Open the computer's BIOS settings screen", bios),
         ("updates", "Automatic updates", "Turn them on or off", updates),
         ("undo-update", "Undo the last update", "Go back to the version from before the last update", undo_update),
         ("problem-details", "Save problem details", "A file of recent errors to email to your helper",
          problem_details),
         ("setup", "Setup checklist", "Microphone, media codecs, disk unlock and getting apps, one at a time",
          setup_checklist)]


def main(argv):
    if len(argv) > 1:
        if argv[1:] == ["setup", "--first-login"]:
            return setup_checklist(first_login=True)
        for key, _, _, fn in TOOLS:
            if argv[1] == key and len(argv) == 2:
                return fn()
        print(__doc__)
        return 2
    i = choose("Which tool do you want?", ["Tool", "What it does"], [[name, about] for _, name, about, _ in TOOLS])
    return TOOLS[i][3]() if i is not None else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
