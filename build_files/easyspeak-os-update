#!/bin/bash
# System Update: update the system, Flatpak apps, Distrobox containers and Homebrew now, with a progress window.
# It starts the updater's manual service. The updater's own polkit rule lets any user at the machine start it,
# so no password is needed. Without a desktop it runs in the terminal.
# If the automatic update (uupd.service, from its daily timer) is already running, only one can run at a time, so
# this follows that one's progress and reports its result, instead of failing.
set -u
SERVICE=uupd-manual.service
AUTO=uupd.service
# easyspeak-os-dialog is zenity plus voice (say a button's name to press it, "read it" to hear the window).
DIALOG=zenity; [ -x /usr/bin/easyspeak-os-dialog ] && DIALOG=/usr/bin/easyspeak-os-dialog

staged() {   # is a new system image waiting for a restart?
  rpm-ostree status --json 2>/dev/null | python3 -c 'import json,sys; sys.exit(0 if any(d.get("staged") for d in json.load(sys.stdin)["deployments"]) else 1)'
}

# The updater's own summary of what failed, from this run's log ("1 update module(s) failed: ...").
failed_parts() {
  journalctl -u "$SERVICE" --since "$1" -o cat 2>/dev/null | python3 -c '
import json, sys
for line in sys.stdin:
    try: m = json.loads(line).get("msg", "")
    except ValueError: continue
    if "module(s) failed:" in m: out = m.split("failed:", 1)[1].strip()
print(globals().get("out", ""))'
}

can_read_log() { id -nG | grep -qwE 'wheel|adm|systemd-journal'; }

# Is the automatic update running? (A service waiting to retry after a failure is not running.)
auto_running() {
  [ "$(systemctl show -p ActiveState --value "$AUTO" 2>/dev/null)" = activating ] &&
    [ "$(systemctl show -p SubState --value "$AUTO" 2>/dev/null)" != auto-restart ]
}
# Did our own start fail because the automatic update held the updater's lock? ("..., is uupd already running?")
lost_to_auto() {
  auto_running && return 0
  journalctl -u uupd-manual.service --since "$1" -o cat 2>/dev/null | grep -q 'already running'
}
# Wait for the automatic update to finish; its result as an exit code.
follow_auto() {
  while auto_running; do sleep 2; done
  [ "$(systemctl show -p Result --value "$AUTO" 2>/dev/null)" = success ]
}
# The manual service is a oneshot that retries after a failure (Restart=on-failure), and its start job stays open
# through those retries. So it is started without waiting, and watched: while its start job is open it is running
# or waiting to retry.
manual_job() { [ -n "$(systemctl show -p Job --value uupd-manual.service 2>/dev/null)" ]; }
manual_retrying() { [ "$(systemctl show -p SubState --value uupd-manual.service 2>/dev/null)" = auto-restart ]; }
# Start the update, or follow the automatic one if it is running (or starts first). Sets SERVICE to the one used.
run_update() {
  if ! auto_running; then
    systemctl start --no-block uupd-manual.service >/dev/null 2>&1 || return 1
    lost=""
    while manual_job; do
      if manual_retrying && lost_to_auto "$1"; then
        # the automatic update holds the lock and is doing the same work: cancel the manual retry, follow it
        systemctl stop uupd-manual.service >/dev/null 2>&1
        lost=1; break
      fi
      sleep 2
    done
    if [ -z "$lost" ]; then
      [ "$(systemctl show -p Result --value uupd-manual.service 2>/dev/null)" = success ] && return 0
      # (systemd versions that end the start job at the first failure, before the retry)
      lost_to_auto "$1" || return 1
      systemctl stop uupd-manual.service >/dev/null 2>&1
    fi
  fi
  SERVICE=$AUTO
  echo "$AUTO" > "${followfile:-/dev/null}"
  follow_auto
}

start=$(date '+%Y-%m-%d %H:%M:%S')

if ! command -v zenity >/dev/null 2>&1 || [ -z "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
  echo "Updating the system, apps and containers. This can take a while."
  auto_running && echo "The automatic update is already running. Following it until it is done."
  run_update "$start"; rc=$?
  failed=$(failed_parts "$start")
  if [ "$rc" -ne 0 ] && [ -n "$failed" ]; then echo "Updated, except: $failed"
  elif [ "$rc" -ne 0 ]; then echo "The update did not finish. Details: journalctl -u $SERVICE"; exit 1
  else echo "Done."; fi
  staged && echo "A new system is ready. Restart to use it."
  exit 0
fi

# Each step the updater reports ({"msg":"Updating","title":..,"description":..,"overall":..}) moves the bar and
# shows its name. Users who cannot read the system log see a pulsing bar and the general message instead.
# Some steps report nothing until they finish (rpm-ostree, on a system with layered packages), so while a step runs
# the text also says how long it has been going, once a minute, to show it is still working (once a minute, so a
# screen reader is not flooded).
steps() {   # $1: the updater service to follow
  journalctl -f -n 0 -o cat -u "$1" 2>/dev/null | python3 -u -c '
import json, os, select, sys, time
step, since, shown, buf = "", 0.0, 0, b""
while True:
    ready, _, _ = select.select([sys.stdin], [], [], 5)
    if ready:
        chunk = os.read(sys.stdin.fileno(), 65536)
        if not chunk:
            break
        buf += chunk
        *lines, buf = buf.split(b"\n")
        for line in lines:
            try: d = json.loads(line)
            except ValueError: continue
            if d.get("msg") == "Updating" and "title" in d:
                step, since, shown = "Updating " + d["title"] + ": " + d.get("description", ""), time.time(), 0
                print(int(d.get("overall", 0)))
                print("# " + step)
    elif step:
        mins = int(time.time() - since) // 60
        if mins > shown:
            shown = mins
            print("# %s  (still working, %d min so far)" % (step, mins))'
}
pulse=(); can_read_log || pulse=(--pulsate)
rcfile=$(mktemp); followfile=$(mktemp)
text="Updating the system, apps and containers. This can take a while."
auto_running && text="The automatic update is already running. Following it until it is done. This can take a while."
(
  stop_steps() { [ -n "${spid:-}" ] && { pkill -P "$spid" 2>/dev/null; kill "$spid" 2>/dev/null; }; spid=""; }
  if auto_running; then
    switched=1      # following it from the start: the window already says so
    if can_read_log; then steps "$AUTO" & spid=$!; fi
  elif can_read_log; then
    steps uupd-manual.service & spid=$!; sleep 1
  fi
  run_update "$start" &
  upid=$!
  # The automatic update may have started first: then switch to following it
  while kill -0 "$upid" 2>/dev/null; do
    if [ -s "$followfile" ] && [ -z "${switched:-}" ]; then
      switched=1; stop_steps
      echo "# The automatic update was already running. Following it until it is done."
      can_read_log && { steps "$AUTO" & spid=$!; }
    fi
    sleep 1
  done
  wait "$upid"; echo $? > "$rcfile"
  stop_steps
  echo 100
) | zenity --progress "${pulse[@]}" --auto-close --no-cancel --title="System Update" --width=480 \
      --text="$text" || true
rc=$(cat "$rcfile" 2>/dev/null || echo 1); rm -f "$rcfile"
[ -s "$followfile" ] && SERVICE=$AUTO; rm -f "$followfile"

# The end result also goes out as a desktop notification, so it is seen even if the dialog opens behind other windows.
notify() { command -v notify-send >/dev/null 2>&1 && notify-send --app-name="System Update" --icon=software-update-available-symbolic "System Update" "$1" || true; }

failed=""; [ "$rc" -ne 0 ] && failed=$(failed_parts "$start")
if [ "$rc" -ne 0 ] && [ -z "$failed" ]; then
  notify "The update did not finish."
  $DIALOG --error --title="System Update" --width=480 \
    --text="The update did not finish.\n\nDetails are in the system log:  journalctl -u $SERVICE"
  exit 1
fi
note=""; [ -n "$failed" ] && note="Updated, except: $failed\nDetails:  journalctl -u $SERVICE\n\n"
# Boxes did not update: offer to check the app boxes from Install Package File and repair one that is broken.
if [[ "$failed" == *Distroboxes* ]] && [ -x /usr/bin/easyspeak-os-packages ]; then
  $DIALOG --question --title="System Update" --width=480 --ok-label="Check the boxes" --cancel-label="Not now" \
    --text="Some boxes (Distrobox) did not update.\n\nCheck the app boxes from Install Package File, and repair one if it is broken?" \
    && /usr/bin/easyspeak-os-packages repair --if-broken
fi
if staged; then
  notify "${failed:+Updated, except: $failed. }A new system is ready. Restart to use it."
  $DIALOG --question --title="System Update" --width=480 --ok-label="Restart now" --cancel-label="Later" \
    --text="${note}A new system is ready. Restart to use it." && systemctl reboot
elif [ -n "$failed" ]; then
  notify "Updated, except: $failed"
  $DIALOG --warning --title="System Update" --width=480 --text="${note%\\n\\n}"
else
  notify "Done. Everything is up to date."
  $DIALOG --info --title="System Update" --text="Done. Everything is up to date."
fi
