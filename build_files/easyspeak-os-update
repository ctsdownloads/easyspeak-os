#!/bin/bash
# System Update: update the system, Flatpak apps, Distrobox containers and Homebrew now, with a progress window.
# It starts the updater's manual service. The updater's own polkit rule lets any user at the machine start it,
# so no password is needed. Without a desktop it runs in the terminal.
set -u
SERVICE=uupd-manual.service

staged() {   # is a new system image waiting for a restart?
  rpm-ostree status --json 2>/dev/null | python3 -c 'import json,sys; sys.exit(0 if any(d.get("staged") for d in json.load(sys.stdin)["deployments"]) else 1)'
}

# The updater's own summary of what failed, from this run's log ("1 update module(s) failed: ...").
failed_parts() {
  journalctl -u "$SERVICE" --since "$1" -o cat 2>/dev/null | python3 -c '
import json, sys
for line in sys.stdin:
    try: m = json.loads(line).get("msg", "")
    except ValueError: continue
    if "module(s) failed:" in m: out = m.split("failed:", 1)[1].strip()
print(globals().get("out", ""))'
}

can_read_log() { id -nG | grep -qwE 'wheel|adm|systemd-journal'; }

start=$(date '+%Y-%m-%d %H:%M:%S')

if ! command -v zenity >/dev/null 2>&1 || [ -z "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
  echo "Updating the system, apps and containers. This can take a while."
  systemctl start "$SERVICE"; rc=$?
  failed=$(failed_parts "$start")
  if [ "$rc" -ne 0 ] && [ -n "$failed" ]; then echo "Updated, except: $failed"
  elif [ "$rc" -ne 0 ]; then echo "The update did not finish. Details: journalctl -u $SERVICE"; exit 1
  else echo "Done."; fi
  staged && echo "A new system is ready. Restart to use it."
  exit 0
fi

# Each step the updater reports ({"msg":"Updating","title":..,"description":..,"overall":..}) moves the bar and
# shows its name. Users who cannot read the system log see a pulsing bar and the general message instead.
# Some steps report nothing until they finish (rpm-ostree, on a system with layered packages), so while a step runs
# the text also says how long it has been going, every few seconds, to show it is still working.
steps() {
  journalctl -f -n 0 -o cat -u "$SERVICE" 2>/dev/null | python3 -u -c '
import json, os, select, sys, time
step, since, buf = "", 0.0, b""
while True:
    ready, _, _ = select.select([sys.stdin], [], [], 5)
    if ready:
        chunk = os.read(sys.stdin.fileno(), 65536)
        if not chunk:
            break
        buf += chunk
        *lines, buf = buf.split(b"\n")
        for line in lines:
            try: d = json.loads(line)
            except ValueError: continue
            if d.get("msg") == "Updating" and "title" in d:
                step, since = "Updating " + d["title"] + ": " + d.get("description", ""), time.time()
                print(int(d.get("overall", 0)))
                print("# " + step)
    elif step:
        mins = int(time.time() - since) // 60
        print("# %s  (still working, %s)" % (step, "%d min" % mins if mins else "under a minute"))'
}
pulse=(); can_read_log || pulse=(--pulsate)
rcfile=$(mktemp)
(
  if can_read_log; then steps & spid=$!; sleep 1; fi
  systemctl start "$SERVICE" >/dev/null 2>&1; echo $? > "$rcfile"
  [ -n "${spid:-}" ] && { pkill -P "$spid" 2>/dev/null; kill "$spid" 2>/dev/null; }
  echo 100
) | zenity --progress "${pulse[@]}" --auto-close --no-cancel --title="System Update" --width=480 \
      --text="Updating the system, apps and containers. This can take a while." || true
rc=$(cat "$rcfile" 2>/dev/null || echo 1); rm -f "$rcfile"

# The end result also goes out as a desktop notification, so it is seen even if the dialog opens behind other windows.
notify() { command -v notify-send >/dev/null 2>&1 && notify-send --app-name="System Update" --icon=software-update-available-symbolic "System Update" "$1" || true; }

failed=""; [ "$rc" -ne 0 ] && failed=$(failed_parts "$start")
if [ "$rc" -ne 0 ] && [ -z "$failed" ]; then
  notify "The update did not finish."
  zenity --error --title="System Update" --width=480 \
    --text="The update did not finish.\n\nDetails are in the system log:  journalctl -u $SERVICE"
  exit 1
fi
note=""; [ -n "$failed" ] && note="Updated, except: $failed\nDetails:  journalctl -u $SERVICE\n\n"
if staged; then
  notify "${failed:+Updated, except: $failed. }A new system is ready. Restart to use it."
  zenity --question --title="System Update" --width=480 --ok-label="Restart now" --cancel-label="Later" \
    --text="${note}A new system is ready. Restart to use it." && systemctl reboot
elif [ -n "$failed" ]; then
  notify "Updated, except: $failed"
  zenity --warning --title="System Update" --width=480 --text="${note%\\n\\n}"
else
  notify "Done. Everything is up to date."
  zenity --info --title="System Update" --text="Done. Everything is up to date."
fi
