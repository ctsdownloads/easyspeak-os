#!/bin/bash
# System Update: update the system, Flatpak apps, Distrobox containers and Homebrew now, with a progress window.
# It starts the updater's manual service. The updater's own polkit rule lets any user at the machine start it,
# so no password is needed. Without a desktop it runs in the terminal.
# If the automatic update (uupd.service, from its daily timer) is already running, only one can run at a time, so
# this follows that one's progress and reports its result, instead of failing.
set -u
SERVICE=uupd-manual.service
AUTO=uupd.service
# easyspeak-os-dialog is zenity plus voice (say a button's name to press it, "read it" to hear the window).
DIALOG=zenity; [ -x /usr/bin/easyspeak-os-dialog ] && DIALOG=/usr/bin/easyspeak-os-dialog

staged() {   # is a new system image waiting for a restart?
  rpm-ostree status --json 2>/dev/null | python3 -c 'import json,sys; sys.exit(0 if any(d.get("staged") for d in json.load(sys.stdin)["deployments"]) else 1)'
}

# The updater's own summary of what failed, from this run's log ("1 update module(s) failed: ...").
failed_parts() {
  journalctl -u "$SERVICE" --since "$1" -o cat 2>/dev/null | python3 -c '
import json, sys
for line in sys.stdin:
    try: m = json.loads(line).get("msg", "")
    except ValueError: continue
    if "module(s) failed:" in m: out = m.split("failed:", 1)[1].strip()
print(globals().get("out", ""))'
}

can_read_log() { id -nG | grep -qwE 'wheel|adm|systemd-journal'; }

# Is the automatic update running? (A service waiting to retry after a failure is not running.)
auto_running() {
  [ "$(systemctl show -p ActiveState --value "$AUTO" 2>/dev/null)" = activating ] &&
    [ "$(systemctl show -p SubState --value "$AUTO" 2>/dev/null)" != auto-restart ]
}
# Did our own start fail because the automatic update held the updater's lock? ("..., is uupd already running?")
lost_to_auto() {
  auto_running && return 0
  journalctl -u uupd-manual.service --since "$1" -o cat 2>/dev/null | grep -q 'already running'
}
# Wait for the automatic update to finish; its result as an exit code.
follow_auto() {
  while auto_running; do sleep 2; done
  [ "$(systemctl show -p Result --value "$AUTO" 2>/dev/null)" = success ]
}
# The manual service is a oneshot that retries after a failure (Restart=on-failure), and its start job stays open
# through those retries. So it is started without waiting, and watched: while its start job is open it is running
# or waiting to retry.
manual_job() { [ -n "$(systemctl show -p Job --value uupd-manual.service 2>/dev/null)" ]; }
manual_retrying() { [ "$(systemctl show -p SubState --value uupd-manual.service 2>/dev/null)" = auto-restart ]; }
# Start the update, or follow the automatic one if it is running (or starts first). Sets SERVICE to the one used.
run_update() {
  if ! auto_running; then
    systemctl start --no-block uupd-manual.service >/dev/null 2>&1 || return 1
    lost=""
    while manual_job; do
      if manual_retrying && lost_to_auto "$1"; then
        # the automatic update holds the lock and is doing the same work: cancel the manual retry, follow it
        systemctl stop uupd-manual.service >/dev/null 2>&1
        lost=1; break
      fi
      sleep 2
    done
    if [ -z "$lost" ]; then
      [ "$(systemctl show -p Result --value uupd-manual.service 2>/dev/null)" = success ] && return 0
      # (systemd versions that end the start job at the first failure, before the retry)
      lost_to_auto "$1" || return 1
      systemctl stop uupd-manual.service >/dev/null 2>&1
    fi
  fi
  SERVICE=$AUTO
  echo "$AUTO" > "${followfile:-/dev/null}"
  follow_auto
}

# The battery's charge when the computer runs on battery and it is below the automatic update's own limit (uupd's
# bat-min-percent, 20 unless /etc/uupd/config.json says otherwise); nothing otherwise. The automatic update skips
# itself then; an update started by hand is only warned about, since a computer that dies mid-update loses it.
low_battery() {
  python3 -I - <<'PY'
import json
from pathlib import Path
limit = 20
try:
    limit = int(json.loads(Path("/etc/uupd/config.json").read_text())["checks"]["hardware"]["bat-min-percent"])
except (OSError, ValueError, KeyError, TypeError):
    pass
ps = Path("/sys/class/power_supply")
def read(d, f):
    try: return (d / f).read_text().strip()
    except OSError: return ""
supplies = list(ps.iterdir()) if ps.is_dir() else []
if any(read(d, "type") in ("Mains", "USB") and read(d, "online") == "1" for d in supplies):
    raise SystemExit
levels = [int(read(d, "capacity")) for d in supplies
          if read(d, "type") == "Battery" and read(d, "scope") != "Device" and read(d, "capacity").isdigit()
          and read(d, "status") == "Discharging"]
if levels and min(levels) < limit:
    print(min(levels))
PY
}

start=$(date '+%Y-%m-%d %H:%M:%S')
battery=""; auto_running || battery=$(low_battery)

if ! command -v zenity >/dev/null 2>&1 || [ -z "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
  [ -n "$battery" ] && echo "The battery is at ${battery}%. Plug the computer in: if it runs out during the update, the update is lost."
  echo "Updating the system, apps and containers. This can take a while."
  auto_running && echo "The automatic update is already running. Following it until it is done."
  run_update "$start"; rc=$?
  failed=$(failed_parts "$start")
  if [ "$rc" -ne 0 ] && [ -n "$failed" ]; then echo "Updated, except: $failed"
  elif [ "$rc" -ne 0 ]; then echo "The update did not finish. Details: journalctl -u $SERVICE"; exit 1
  else echo "Done."; fi
  staged && echo "A new system is ready. Restart to use it."
  exit 0
fi

# Each step the updater reports ({"msg":"Updating","title":..,"description":..,"overall":..,"total":..}) moves the bar
# and shows its name. Users who cannot read the system log see a pulsing bar and the general message instead.
# The system step (rpm-ostree) also writes its own lines to the log: how many parts the new system has and their
# size ("ostree chunk layers needed: 4 (1.4 GB)"), each part as it finishes ("[2/4] Fetching ... done"), then each
# install stage as it finishes ("Checking out tree ...done", "Writing OSTree commit...done", "Staging
# deployment...done"). Those are shown in plain words, and they move the bar through the system step's share of it:
# the download takes the first 70%, the install stages the rest. While a part downloads, the text says about how
# much has come in, from the computer's network counters, every 10 seconds. While it installs, the text says which
# stage it is on ("step 2 of 3") and how long that stage has been going, every 10 seconds.
# Other steps that report nothing until they finish say how long they have been going, once a minute.
steps() {   # $1: the updater service to follow
  journalctl -f -n 0 -o cat -u "$1" 2>/dev/null | python3 -u -c '
import json, os, re, select, subprocess, sys, time

def received():
    total = 0
    try:
        for line in open("/proc/net/dev").read().splitlines()[2:]:
            name, data = line.split(":", 1)
            if name.strip() != "lo":
                total += int(data.split()[0])
    except (OSError, ValueError, IndexError):
        return None
    return total

def nbytes(size):
    m = re.match(r"([0-9.]+)\s*([kMGT]?B)", size.replace(" ", " "))
    if not m:
        return None
    return float(m.group(1)) * {"B": 1, "kB": 1e3, "MB": 1e6, "GB": 1e9, "TB": 1e12}[m.group(2)]

def human(n):
    return "%.1f GB" % (n / 1e9) if n >= 1e9 else "%d MB" % (n / 1e6)

def added_to_system():
    """Does the running system have apps added to it (layered packages)? Then the install has a stage for them."""
    try:
        out = subprocess.run(["rpm-ostree", "status", "--json", "--booted"], capture_output=True, timeout=30).stdout
        d = next(d for d in json.loads(out)["deployments"] if d.get("booted"))
    except (OSError, ValueError, KeyError, StopIteration, subprocess.SubprocessError):
        return False
    return any(d.get(k) for k in ("requested-packages", "requested-local-packages", "requested-base-removals",
                                  "requested-base-local-replacements"))

STAGES = {"unpack": "unpacking the new version",
          "apps": "adding the apps you put on the system to the new version",
          "save": "saving the new version so it starts at your next restart"}

def ago(secs):
    return "%d seconds so far" % secs if secs < 60 else "about %d min so far" % round(secs / 60)

step, since, shown, buf = "", 0.0, 0, b""
parts = done = 0
size_text, size, base, said = "", None, None, 0.0
low, width = 0.0, 0.0        # the part of the bar that belongs to the system step
order, stage, began = [], "", 0.0

def bar(frac):
    if width:
        print(int(low + width * min(max(frac, 0.0), 1.0)))

def install(name):
    global stage, began, said
    stage, began, said = name, time.time(), time.time()
    k = order.index(name)
    bar(0.7 + 0.3 * k / len(order))
    print("# Updating the system: step %d of %d, %s." % (k + 1, len(order), STAGES[name]))

while True:
    ready, _, _ = select.select([sys.stdin], [], [], 5)
    if ready:
        chunk = os.read(sys.stdin.fileno(), 65536)
        if not chunk:
            break
        buf += chunk
        *lines, buf = buf.split(b"\n")
        for line in lines:
            try: d = json.loads(line)
            except ValueError: continue
            msg = str(d.get("msg", ""))
            if msg == "Updating" and "title" in d:
                step, since, shown = "Updating " + d["title"] + ": " + d.get("description", ""), time.time(), 0
                parts = done = 0
                stage = ""
                low, width = float(d.get("overall", 0)), 0.0
                if d["title"] == "System":
                    width = 100.0 / max(int(d.get("total", 1) or 1), 1)
                    order = ["unpack", "apps", "save"] if added_to_system() else ["unpack", "save"]
                print(int(low))
                print("# " + step)
                continue
            text = None
            m = re.search(r"layers needed: (\d+) \(([^)]*)\)", msg)
            if m:
                parts += int(m.group(1))
                size_text = m.group(2).replace(" ", " ")
                size, base = nbytes(size_text), received()
                text = "Updating the system: downloading the new version, %s in %d parts." % (size_text, parts)
            elif re.match(r"\[(\d+)/(\d+)\]", msg) and msg.endswith("done"):
                done, parts = map(int, re.match(r"\[(\d+)/(\d+)\]", msg).groups())
                if done < parts:
                    text = "Updating the system: downloaded part %d of %d." % (done, parts)
                    bar(0.7 * done / parts)
                elif order:
                    install("unpack")
            elif msg.startswith("Pulling manifest"):
                text = "Updating the system: checking for a new version."
            elif msg.startswith("Checking out tree") and order:
                install(order[1])
            elif msg.startswith("Writing OSTree commit") and stage == "apps":
                install("save")
            elif msg.startswith("Staging deployment") and msg.endswith("done"):
                stage = ""
                bar(1.0)
                text = "Updating the system: the new version is installed. It starts at your next restart."
            elif msg.startswith("No upgrade available"):
                text = "Updating the system: it is already up to date."
            if text:
                since, shown, said = time.time(), 0, time.time()
                print("# " + text)
    elif stage:
        if time.time() - said >= 10:
            said = time.time()
            k = order.index(stage)
            print("# Updating the system: step %d of %d, %s (%s)." %
                  (k + 1, len(order), STAGES[stage], ago(int(time.time() - began))))
    elif parts and done < parts and size and base is not None and time.time() - said >= 10:
        now = received()
        if now is not None:
            got = min(max(now - base, 0), size)
            said = time.time()
            bar(0.7 * got / size)
            print("# Updating the system: downloading part %d of %d, about %s of %s so far." %
                  (min(done + 1, parts), parts, human(got), size_text))
    elif step:
        mins = int(time.time() - since) // 60
        if mins > shown:
            shown = mins
            print("# %s  (still working, %d min so far)" % (step, mins))'
}

if [ -n "$battery" ]; then
  $DIALOG --question --title="System Update" --width=480 --ok-label="Update anyway" --cancel-label="Not now" \
    --text="The battery is at ${battery}% and the computer isn't plugged in. If the battery runs out during the update, the update is lost and has to start again.\n\nRecommended: Not now. Plug the computer in, then start System Update again.\n\nOr Update anyway." \
    || exit 0
fi

rcfile=$(mktemp); followfile=$(mktemp)
text="Updating everything: the system, your apps and the app boxes. This can take a while. You can keep working."
auto_running && text="The automatic update is already running, so this window follows it until it's done. You can keep working."
(
  stop_steps() { [ -n "${spid:-}" ] && { pkill -P "$spid" 2>/dev/null; kill "$spid" 2>/dev/null; }; spid=""; }
  if auto_running; then
    switched=1      # following it from the start: the window already says so
    if can_read_log; then steps "$AUTO" & spid=$!; fi
  elif can_read_log; then
    steps uupd-manual.service & spid=$!; sleep 1
  fi
  run_update "$start" &
  upid=$!
  # The automatic update may have started first: then switch to following it
  while kill -0 "$upid" 2>/dev/null; do
    if [ -s "$followfile" ] && [ -z "${switched:-}" ]; then
      switched=1; stop_steps
      echo "# The automatic update is already running, so this window follows it until it's done. You can keep working."
      can_read_log && { steps "$AUTO" & spid=$!; }
    fi
    sleep 1
  done
  wait "$upid"; echo $? > "$rcfile"
  stop_steps
  echo 100
) | zenity --progress "${pulse[@]}" --auto-close --no-cancel --title="System Update" --width=480 \
      --text="$text" || true
rc=$(cat "$rcfile" 2>/dev/null || echo 1); rm -f "$rcfile"
[ -s "$followfile" ] && SERVICE=$AUTO; rm -f "$followfile"

# What the new version changes, in the words of its changes' titles: the image carries the list of the last changes
# (/usr/share/easyspeak-os/changes.txt, "date<TAB>title" per line). The new version's list is read from where it
# waits on disk, and the changes the running version already has are left out, as are changes to the README and the
# build alone. At most 8 lines, then "and N more".
whats_new() {
  rpm-ostree status --json 2>/dev/null | python3 -I -c '
import json, re, sys, time
from pathlib import Path
try:
    ds = json.load(sys.stdin)["deployments"]
    new = next(d for d in ds if d.get("staged"))
    now = next(d for d in ds if d.get("booted"))
    f = Path("/ostree/deploy/%s/deploy/%s.%s/usr/share/easyspeak-os/changes.txt" % (new["osname"], new["checksum"],
                                                                                     new["serial"]))
    lines = f.read_text().splitlines()
except (ValueError, KeyError, StopIteration, OSError):
    sys.exit()
try:
    have = set(Path("/usr/share/easyspeak-os/changes.txt").read_text().splitlines())
except OSError:
    have = set()
since = time.strftime("%Y-%m-%d", time.gmtime(int(now.get("timestamp", 0))))
out = []
for line in lines:
    date, _, title = line.partition("\t")
    if line in have or date < since or re.match(r"(README|Build)\b", title):
        continue
    title = re.sub(r"\s*\(#\d+\)$", "", title)
    out.append("- " + title.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))
if out:
    more = len(out) - 8
    print("What is new:\n" + "\n".join(out[:8]) + ("\n- and %d more" % more if more > 0 else ""))
'
}

# The end result also goes out as a desktop notification, so it is seen even if the dialog opens behind other windows.
notify() { command -v notify-send >/dev/null 2>&1 && notify-send --app-name="System Update" --icon=software-update-available-symbolic "System Update" "$1" || true; }

failed=""; [ "$rc" -ne 0 ] && failed=$(failed_parts "$start")
if [ "$rc" -ne 0 ] && [ -z "$failed" ]; then
  notify "The update didn't finish."
  $DIALOG --error --title="System Update" --width=480 \
    --text="The update didn't finish. Nothing is broken: your computer keeps running the version it has.\n\nTry again later."
  exit 1
fi
note=""; [ -n "$failed" ] && note="Everything updated except: $failed. Nothing is broken. It tries again at the next update.\n\n"
# Boxes did not update: offer to check the app boxes from Install Package File and repair one that is broken.
if [[ "$failed" == *Distroboxes* ]] && [ -x /usr/bin/easyspeak-os-packages ]; then
  $DIALOG --question --title="System Update" --width=480 --ok-label="Check the boxes" --cancel-label="Not now" \
    --text="Some app boxes didn't update.\n\nRecommended: Check the boxes. It checks them and repairs one that's broken. Your files aren't touched.\n\nOr Not now." \
    && /usr/bin/easyspeak-os-packages repair --if-broken
fi
if staged; then
  notify "${failed:+Everything updated except: $failed. }A new system is ready. Restart to use it."
  new=$(whats_new); [ -n "$new" ] && new="\n\n$new"
  $DIALOG --question --title="System Update" --width=560 --ok-label="Restart now" --cancel-label="Later" \
    --text="${note}A new system is ready.$new\n\nRecommended: Restart now to start using it. Or Later, if you're in the middle of something." && systemctl reboot
elif [ -n "$failed" ]; then
  notify "Everything updated except: $failed"
  $DIALOG --warning --title="System Update" --width=480 --text="${note%\\n\\n}"
else
  notify "Done. Everything is up to date."
  $DIALOG --info --title="System Update" --text="Done. Everything is up to date."
fi
