# Live variant of EasySpeakOS, for building a bootable live ISO with its installer.
# Based on the Bazzite example in Universal Blue's titanoboa (github.com/ublue-os/titanoboa, Apache-2.0), which
# follows the "Container-native ISO contract" that titanoboa builds the ISO from.
# Build from the top of the repository:
#   podman build --cap-add sys_admin --security-opt label=disable -f iso/Containerfile .
# BASE_IMAGE is the published image, or a locally built one for a test build (see build-local-iso.sh).
ARG BASE_IMAGE=ghcr.io/ctsdownloads/easyspeak-os:latest
FROM ${BASE_IMAGE}

RUN --mount=type=bind,source=iso/src,target=/src \
    --mount=type=bind,source=branding,target=/branding \
    --mount=type=bind,source=build_files/branding,target=/build-branding \
    /src/build.sh
