<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- The live USB only: lets the person at the computer start the install engine without a password, as Fedora's
     own live installer action (org.fedoraproject.pkexec.liveinst) does. Only this one program, and only for the
     active local session. The installed system does not have this file. -->
<policyconfig>
  <action id="io.github.ctsdownloads.easyspeak-os.install">
    <description>Install EasySpeakOS on this computer</description>
    <message>Authentication is required to install EasySpeakOS</message>
    <icon_name>easyspeak-os-installer</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/easyspeak-os-install-engine</annotate>
  </action>
</policyconfig>
