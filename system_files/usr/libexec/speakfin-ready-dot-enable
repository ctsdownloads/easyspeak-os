#!/bin/bash
# Turns the ready-dot extension on once, the first time a user logs in after
# the image gains it. If the user turns it off later, it stays off.
marker="${XDG_STATE_HOME:-$HOME/.local/state}/speakfin/ready-dot-enabled"
[ -e "$marker" ] && exit 0
for _ in $(seq 1 15); do
    gnome-extensions enable ready-dot@speakfin >/dev/null 2>&1
    if gsettings get org.gnome.shell enabled-extensions | grep -q 'ready-dot@speakfin'; then
        mkdir -p "$(dirname "$marker")" && touch "$marker"
        exit 0
    fi
    sleep 2
done
exit 0
